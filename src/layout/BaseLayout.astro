---
import Navbar from '@sections/Navbar.astro';
import Footer from '@sections/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { SEO, type Props as SEOProps } from 'astro-seo';
import type { WithContext, Thing } from 'schema-dts';
import { AstroFont } from 'astro-font';
import '@styles/global.css';
import {
  canonicalUrl,
  organizationSchema,
  websiteSchema,
  SITE_URL,
} from '@/data/business';

interface Props {
  seo?: SEOProps; // Optional SEO properties to customize meta tags
  schema?: WithContext<Thing> | WithContext<Thing>[]; // Optional schema.org properties for structured data
}

// Extract `seo` and `schema` from properties or define defaults
const { seo, schema } = Astro.props;
const socialImage = `${SITE_URL}/social.png`; // Path to the default social sharing image

// Clean canonical URL (no .html, /case-studies -> /work); pages can override.
const canonical = String(seo?.canonical ?? canonicalUrl(Astro.url.pathname));

const defaultTitle =
  'Webfluence — Software Development Company in Lahore, Pakistan';
const defaultDescription =
  'Webfluence is a software development and digital marketing company in Lahore, Pakistan. We build custom ERP, CRM, web and mobile apps and run SEO and performance marketing for growing businesses.';

const title = seo?.title ?? defaultTitle;
const description = seo?.description ?? defaultDescription;

// Define default JSON-LD Schema.org data if no schema is passed
const defaultSchema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'en',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#organization` },
} as WithContext<Thing>;

// Pages build their own schema with `Astro.url.href`, which in the static
// build is the `.html` file URL. Swap it for the canonical URL everywhere.
const withCanonicalUrls = (item: WithContext<Thing>): WithContext<Thing> =>
  JSON.parse(JSON.stringify(item).split(Astro.url.href).join(canonical));

const pageSchemas = (schema ? [schema].flat() : [defaultSchema]).map(
  withCanonicalUrls
);
---

<html lang="en" class="scroll-pt-32">
  <head>
    <script is:inline>
      // Ensure page starts from top on reload
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.addEventListener('beforeunload', () => {
        window.scrollTo(0, 0);
      });
      if (!window.location.hash) {
        window.scrollTo(0, 0);
      }
      window.addEventListener('pageshow', () => {
        if (!window.location.hash) {
          window.scrollTo(0, 0);
        }
      });
    </script>
    {/* SEO Meta Tags */}
    <SEO
      charset="utf-8"
      title={title}
      description={description}
      canonical={canonical}
      noindex={seo?.noindex}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: socialImage,
          url: canonical,
        },
        optional: {
          description,
          siteName: 'Webfluence',
          locale: 'en_US',
        },
        image: {
          alt: 'Webfluence — software development and digital marketing, Lahore',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: socialImage,
        imageAlt: 'Webfluence — software development and digital marketing, Lahore',
      }}
      extend={{
        link: [
          { rel: 'icon', href: '/logos/WFLogo.png', type: 'image/png' },
          { rel: 'apple-touch-icon', href: '/logos/WFLogo.png' },
          { rel: 'manifest', href: '/manifest.webmanifest' },
        ],
        meta: [
          { name: 'viewport', content: 'width=device-width' },
          { name: 'generator', content: `${Astro.generator}` },
        ],
      }}
    />
    {/* Schema.org JSON-LD */}
    {/* Site-wide business entity (must match Google Business Profile) */}
    {/* Rendered raw (not via <Schema>), which HTML-escapes "&" to "&amp;" inside the JSON. */}
    {
      [organizationSchema, websiteSchema, ...pageSchemas].map(item => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item).replace(/</g, '\\u003c')}
        />
      ))
    }

    {/* Client-Side Router for page transitions */}
    <ClientRouter />

    {/* Font Definitions */}
    <AstroFont
      config={[
        {
          src: [],
          name: 'DM Sans',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,100..1000&display=swap',
          preload: true,
          display: 'swap',
          selector: 'h1, h2, h3, h4',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Work Sans',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Work+Sans:wght@100..900&display=swap',
          preload: true,
          display: 'swap',
          selector: 'body',
          fallback: 'sans-serif',
        },
      ]}
    />

    {/* Remove duplicate font links during transitions */}
    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
      document.addEventListener('astro:before-swap', e =>
        [
          ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
            'link[as="font"]'
          ),
        ].forEach(link => link.remove())
      );
    </script>
  </head>
  <body class="bg-off-white selection:bg-blue-400 selection:text-slate-700">
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
