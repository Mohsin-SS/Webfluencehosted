---
import Navbar from '@sections/Navbar.astro';
import Footer from '@sections/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { SEO, type Props as SEOProps } from 'astro-seo';
import type { WithContext, Thing } from 'schema-dts';
import '@styles/global.css';
import GoogleAnalytics from '@common/GoogleAnalytics.astro';
import MetaPixel from '@common/MetaPixel.astro';
import {
  canonicalUrl,
  organizationSchema,
  websiteSchema,
  SITE_URL,
  google,
} from '@/data/business';

interface Props {
  seo?: SEOProps; // Optional SEO properties to customize meta tags
  schema?: WithContext<Thing> | WithContext<Thing>[]; // Optional schema.org properties for structured data
}

// Extract `seo` and `schema` from properties or define defaults
const { seo, schema } = Astro.props;
const socialImage = `${SITE_URL}/social.png`; // Path to the default social sharing image

// Clean canonical URL (no .html, /case-studies -> /work); pages can override.
const canonical = String(seo?.canonical ?? canonicalUrl(Astro.url.pathname));

const defaultTitle =
  'Webfluence — Performance Marketing & Software Company in Lahore';
const defaultDescription =
  'Webfluence is a performance marketing and software development company in Lahore, Pakistan. We run Google and Meta campaigns, create social media content, and build ERP, CRM, mobile and web apps for growing businesses.';

const title = seo?.title ?? defaultTitle;
const description = seo?.description ?? defaultDescription;

// Define default JSON-LD Schema.org data if no schema is passed
const defaultSchema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'en',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#organization` },
} as WithContext<Thing>;

// Pages build their own schema with `Astro.url.href`, which in the static
// build is the `.html` file URL. Swap it for the canonical URL everywhere.
const withCanonicalUrls = (item: WithContext<Thing>): WithContext<Thing> =>
  JSON.parse(JSON.stringify(item).split(Astro.url.href).join(canonical));

const pageSchemas = (schema ? [schema].flat() : [defaultSchema]).map(
  withCanonicalUrls
);
---

<html lang="en" class="scroll-pt-24">
  <head>
    <script is:inline>
      // Mark JS as available (scroll reveals only hide content when it is).
      // Re-added after each page swap, which replaces <html> attributes.
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', () =>
        document.documentElement.classList.add('js')
      );

      // Ensure page starts from top on reload
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.addEventListener('beforeunload', () => {
        window.scrollTo(0, 0);
      });
      if (!window.location.hash) {
        window.scrollTo(0, 0);
      }
      window.addEventListener('pageshow', () => {
        if (!window.location.hash) {
          window.scrollTo(0, 0);
        }
      });
    </script>
    {/* SEO Meta Tags */}
    <SEO
      charset="utf-8"
      title={title}
      description={description}
      canonical={canonical}
      noindex={seo?.noindex}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: socialImage,
          url: canonical,
        },
        optional: {
          description,
          siteName: 'Webfluence',
          locale: 'en_US',
        },
        image: {
          alt: 'Webfluence — performance marketing and software development, Lahore',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: socialImage,
        imageAlt: 'Webfluence — performance marketing and software development, Lahore',
      }}
      extend={{
        link: [
          { rel: 'icon', href: '/logos/WFLogo.png', type: 'image/png' },
          { rel: 'apple-touch-icon', href: '/logos/WFLogo.png' },
          { rel: 'manifest', href: '/manifest.webmanifest' },
        ],
        meta: [
          { name: 'viewport', content: 'width=device-width, initial-scale=1' },
          { name: 'theme-color', content: '#f3f7fc' },
          { name: 'generator', content: `${Astro.generator}` },
          ...(google.searchConsoleVerification
            ? [
                {
                  name: 'google-site-verification',
                  content: google.searchConsoleVerification,
                },
              ]
            : []),
        ],
      }}
    />
    {/* Schema.org JSON-LD */}
    {/* Site-wide business entity (must match Google Business Profile) */}
    {/* Rendered raw (not via <Schema>), which HTML-escapes "&" to "&amp;" inside the JSON. */}
    {
      [organizationSchema, websiteSchema, ...pageSchemas].map(item => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item).replace(/</g, '\\u003c')}
        />
      ))
    }

    {/* Google Analytics (renders only when an ID is set in business.ts) */}
    <GoogleAnalytics />

    {/* Meta Pixel (renders only when a Pixel ID is set in business.ts) */}
    <MetaPixel />

    {/* Client-Side Router for page transitions */}
    <ClientRouter />

    {/* Fonts: Bricolage Grotesque (headlines), Geist (text), Geist Mono (labels) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Geist+Mono:wght@400;500&family=Geist:wght@400..600&display=swap"
    />
  </head>
  <body class="text-ink">
    {/* Page-wide light behind the glass */}
    <div class="light-fields" aria-hidden="true"></div>

    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      // Motion engine: scroll reveals, number count-ups and the cursor
      // spotlight on glass cards. Everything is skipped for visitors who ask
      // for reduced motion; content is always in the HTML regardless.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      let observer: IntersectionObserver | null = null;

      function countUp(el: HTMLElement) {
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target)) return;
        const decimals = (el.dataset.count!.split('.')[1] || '').length;
        const prefix = el.dataset.prefix ?? '';
        const suffix = el.dataset.suffix ?? '';
        const start = performance.now();
        const duration = 1600;
        const frame = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - t, 4);
          el.textContent = `${prefix}${(target * eased).toFixed(decimals)}${suffix}`;
          if (t < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }

      function initMotion() {
        observer?.disconnect();
        const items = document.querySelectorAll<HTMLElement>(
          '[data-reveal]:not(.is-in), [data-count]:not([data-counted])'
        );
        if (reduce.matches || !('IntersectionObserver' in window)) {
          items.forEach(el => el.classList.add('is-in'));
          return;
        }
        observer = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('is-in');
              if (el.dataset.count !== undefined && !el.dataset.counted) {
                el.dataset.counted = '';
                countUp(el);
              }
              observer?.unobserve(el);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        items.forEach(el => observer!.observe(el));
      }

      // One delegated listener feeds every [data-spotlight] card.
      document.addEventListener(
        'pointermove',
        event => {
          const card = (event.target as Element).closest?.<HTMLElement>(
            '[data-spotlight]'
          );
          if (!card) return;
          const box = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${event.clientX - box.left}px`);
          card.style.setProperty('--my', `${event.clientY - box.top}px`);
        },
        { passive: true }
      );

      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
