---
import { twMerge } from 'tailwind-merge';

export interface Props {
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  rel?: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  /**
   * primary:   solid blue with a white arrow chip
   * secondary: outlined, arrow follows the label
   * tertiary:  plain blue text link with an arrow
   */
  variant?: 'primary' | 'secondary' | 'tertiary';
  size?: 'md' | 'sm';
  /** Set to false to drop the arrow. */
  arrow?: boolean;
  className?: string;
  id?: string;
}

const {
  type,
  href,
  rel,
  target,
  variant = 'primary',
  size = 'md',
  arrow = true,
  className,
  id,
} = Astro.props;

const base =
  'group inline-flex items-center justify-center text-nowrap font-normal transition-colors duration-200 select-none';

const sizes = {
  md: {
    box: 'h-[52px] text-base',
    chip: 'size-8 rounded-lg',
    icon: 'size-3.5',
  },
  sm: { box: 'h-10 text-sm', chip: 'size-6 rounded-md', icon: 'size-3' },
}[size];

const variants = {
  primary: `rounded-[10px] bg-brand text-white hover:bg-blue-800 gap-3 ${
    arrow ? (size === 'sm' ? 'pl-4 pr-2' : 'pl-5 pr-2.5') : 'px-6'
  }`,
  secondary: `rounded-[10px] border border-slate-400 bg-white text-ink hover:border-ink hover:bg-mist gap-2.5 ${
    size === 'sm' ? 'px-4' : 'px-5'
  }`,
  tertiary: 'h-auto gap-2 text-brand hover:text-blue-800',
}[variant];

const classes = twMerge(base, sizes.box, variants, className);
const Tag = href ? 'a' : 'button';
const tagProps = href ? { href, rel, target } : { type: type || 'button' };

// Up-right arrow
const arrowPath = 'M7 17 17 7M8 7h9v9';
---

<Tag id={id} class={classes} {...tagProps}>
  <span><slot /></span>
  {
    arrow && variant === 'primary' && (
      <span
        class={`text-brand grid shrink-0 place-items-center bg-white ${sizes.chip}`}
        aria-hidden="true"
      >
        <svg
          class={`${sizes.icon} transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5`}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d={arrowPath} />
        </svg>
      </span>
    )
  }
  {
    arrow && variant !== 'primary' && (
      <svg
        class={`${sizes.icon} shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5`}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={arrowPath} />
      </svg>
    )
  }
</Tag>
