---
import { twMerge } from 'tailwind-merge';

export interface Props {
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  rel?: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  /**
   * primary:   solid blue with a white arrow chip
   * secondary: outlined, arrow follows the label
   * tertiary:  plain blue text link with an arrow
   */
  variant?: 'primary' | 'secondary' | 'tertiary';
  size?: 'md' | 'sm';
  /** Set to false to drop the arrow. */
  arrow?: boolean;
  className?: string;
  id?: string;
}

const {
  type,
  href,
  rel,
  target,
  variant = 'primary',
  size = 'md',
  arrow = true,
  className,
  id,
} = Astro.props;

const base =
  'btn group relative inline-flex items-center justify-center text-nowrap font-bold uppercase tracking-[0.02em] select-none rounded-full transition-[transform,background-color,color,border-color] duration-300';

const sizes = {
  md: { box: 'h-12 px-7 text-[0.95rem] gap-2', icon: 'size-3.5' },
  sm: { box: 'h-10 px-5 text-[0.82rem] gap-1.5', icon: 'size-3' },
}[size];

const variants = {
  // Solid pill (Nexera "LET'S TALK"): black on light, white on dark;
  // turns brand blue on hover.
  primary: 'bg-btn text-btn-fg hover:bg-brand hover:text-white hover:-translate-y-0.5',
  // Card-coloured pill.
  secondary:
    'bg-card text-ink-deep border border-card-2 hover:border-ink-deep hover:-translate-y-0.5',
  tertiary: 'h-auto px-0 gap-2 normal-case tracking-normal font-semibold text-accent hover:text-ink-deep',
}[variant];

const classes = twMerge(base, sizes.box, variants, className);
const Tag = href ? 'a' : 'button';
const tagProps = href ? { href, rel, target } : { type: type || 'button' };

// Up-right arrow
const arrowPath = 'M7 17 17 7M8 7h9v9';
---

<Tag id={id} class={classes} {...tagProps}>
  <span><slot /></span>
  {
    arrow && (
      <svg
        class={`${sizes.icon} shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5`}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={arrowPath} />
      </svg>
    )
  }
</Tag>
