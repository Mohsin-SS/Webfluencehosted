---
import { twMerge } from 'tailwind-merge';
import { Icons } from './icons.ts';

interface Path {
  d: string;
  class?: string;
}

const { name, class: className, ...attributes } = Astro.props;
let icon = (Icons as any)[name] || {};
let paths: Path[] = icon.paths || [];

// twMerge lets a class passed by the caller win over the icon's default
// (e.g. text-white over text-slate-500).
const combinedClass = twMerge(icon.class, className);
---

{
  icon ? (
    <svg
      {...attributes}
      class={combinedClass}
      viewBox={icon.viewBox}
      fill={icon.fill}
      stroke={icon.stroke}
      stroke-width={icon.strokeWidth}
      stroke-linecap={icon.strokeLinecap}
      stroke-linejoin={icon.strokeLinejoin}
    >
      <title>{icon.title}</title>
      {paths.map((path: Path) => (
        <path d={path.d} class={path.class || ''} />
      ))}
    </svg>
  ) : (
    'Icon not found'
  )
}
