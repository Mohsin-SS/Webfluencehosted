---
import { business } from '@/data/business';
import { softwareServices, marketingServices, products } from '@/data/site';

// Contact form from the Nexera design. The site is static (no server), so
// "Send message" opens the visitor's email app with the enquiry filled in,
// addressed to the business email. data-lead-form makes Google Analytics and
// the Meta Pixel count it as a lead. To deliver enquiries without the email
// app, point the form at a form service (e.g. Formspree) instead.
const options = [
  ...marketingServices.map(s => s.title),
  ...softwareServices.map(s => s.title),
  ...products.map(p => p.title),
  'Something else',
];

const field =
  'w-full rounded-lg border border-[#718096] bg-[#4a5568] px-4 py-3 text-white placeholder:text-[#9ca3af]/70 outline-none transition-[border-color,box-shadow] duration-200 focus:border-accent focus:ring-[3px] focus:ring-accent/40';
const label = 'mb-2 block text-left text-sm font-bold text-[#d1d5db]';
---

<form class="contact-form flex flex-col gap-6" data-lead-form data-mailto={business.email}>
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="cf-name" class={label}>Name</label>
      <input id="cf-name" name="name" type="text" required placeholder="Your name" autocomplete="name" class={field} />
    </div>
    <div>
      <label for="cf-email" class={label}>Email</label>
      <input id="cf-email" name="email" type="email" required placeholder="your.email@example.com" autocomplete="email" class={field} />
    </div>
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="cf-phone" class={label}>Phone or WhatsApp <span class="font-normal text-[#9ca3af]">(optional)</span></label>
      <input id="cf-phone" name="phone" type="tel" placeholder="+92 3xx xxxxxxx" autocomplete="tel" class={field} />
    </div>
    <div>
      <label for="cf-service" class={label}>What do you need?</label>
      <select id="cf-service" name="service" required class={field}>
        <option value="" disabled selected>Choose a service</option>
        {options.map(o => <option value={o}>{o}</option>)}
      </select>
    </div>
  </div>
  <div>
    <label for="cf-message" class={label}>Message</label>
    <textarea id="cf-message" name="message" rows="6" required placeholder="Tell us about your project or inquiry..." class={field}></textarea>
  </div>
  <div class="mt-2 flex flex-col items-center gap-3">
    <button type="submit" class="pill-btn bg-white text-black hover:bg-brand hover:text-white">
      Send message
    </button>
    <p class="text-center text-xs text-[#9ca3af]">
      Opens your email app with your message to {business.email}.
    </p>
  </div>
</form>

<script>
  function initContactForms() {
    document.querySelectorAll<HTMLFormElement>('form[data-mailto]').forEach(form => {
      if (form.dataset.ready) return;
      form.dataset.ready = '1';
      form.addEventListener('submit', event => {
        event.preventDefault();
        const data = new FormData(form);
        const get = (k: string) => String(data.get(k) ?? '').trim();
        const subject = `Website enquiry: ${get('service') || 'General'} – ${get('name')}`;
        const body = [
          `Name: ${get('name')}`,
          `Email: ${get('email')}`,
          get('phone') ? `Phone/WhatsApp: ${get('phone')}` : '',
          `Service: ${get('service')}`,
          '',
          get('message'),
        ]
          .filter((line, i) => line !== '' || i === 4)
          .join('\n');
        window.location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    });
  }

  document.addEventListener('astro:page-load', initContactForms);
</script>
