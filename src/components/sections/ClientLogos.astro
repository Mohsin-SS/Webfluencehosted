---
import { clients } from '@/data/site';

const title = 'Brands that build and grow with Webfluence';
// Order lives in src/data/site.ts (`clients`).
const logos = clients.map(c => ({ src: c.logo, alt: c.name, scale: c.scale }));

// One extra copy is the minimum needed for a seamless loop; more would
// show the same brand twice on screen at once.
const marqueeLogos = [...logos, ...logos];
---

<section class="relative isolate overflow-hidden py-14 sm:py-20">
  {/* Band behind the card: soft blocks with stripe runs top and bottom */}
  <div
    class="absolute inset-x-0 top-1/2 -z-10 h-[78%] -translate-y-1/2"
    aria-hidden="true"
  >
    <div
      class="via-ice/70 absolute inset-0 bg-linear-to-r from-blue-50 to-blue-50"
    >
    </div>
    <div
      class="stripes stripes-fade-x absolute inset-x-[8%] top-0 h-7 [--stripe-color:rgb(20_118_235/0.32)]"
    >
    </div>
    <div
      class="stripes stripes-fade-x absolute inset-x-[8%] bottom-0 h-7 [--stripe-color:rgb(20_118_235/0.32)]"
    >
    </div>
  </div>

  <div class="wrap">
    <div
      class="rounded-2xl border border-slate-200 bg-white/70 px-4 py-9 shadow-[0_20px_50px_-36px_rgb(20_20_20/0.5)] backdrop-blur-md sm:px-8 sm:py-11"
    >
      <h2
        class="text-center text-xl font-semibold tracking-tight sm:text-[1.75rem]"
      >
        {title}
      </h2>

      {/* Marquee */}
      {/* py-4 gives enlarged logos room inside the overflow clip; mt-4 and
          -mb-4 cancel it so the card keeps its size. */}
      <div
        class="logo-mask relative mt-4 -mb-4 flex w-full overflow-hidden py-4"
      >
        <ul class="logo-marquee flex items-center" aria-label="Client logos">
          {
            marqueeLogos.map((logo, i) => (
              <li
                class="mx-5 flex h-16 w-36 shrink-0 items-center justify-center sm:mx-8 sm:h-20 sm:w-44"
                aria-hidden={i >= logos.length ? 'true' : undefined}
              >
                <img
                  src={logo.src}
                  alt={i >= logos.length ? '' : logo.alt}
                  class="max-h-full max-w-full object-contain mix-blend-multiply"
                  style={logo.scale ? `transform: scale(${logo.scale})` : undefined}
                  loading="lazy"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .logo-mask {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  /* The list is rendered twice, so -50% lands exactly on the second copy. */
  .logo-marquee {
    animation: marquee 50s linear infinite;
  }

  .logo-marquee:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
