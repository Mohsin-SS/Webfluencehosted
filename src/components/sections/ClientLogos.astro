---
const title = 'Trusted by Innovative Brands';
const logos = [
  { src: '/logos/education-links.png', alt: 'Education Links' },
  { src: '/logos/fastaxi.png', alt: 'Fastaxi' },
  { src: '/logos/property-linkers.png', alt: 'Property Linkers' },
  { src: '/logos/times-consultant.png', alt: 'Times Consultant' },
  { src: '/logos/ghausia-floor-mills.png', alt: 'Ghausia Floor Mills' },
  { src: '/logos/zamindar-premium.png', alt: 'Zamindar Premium' },
  { src: '/logos/data-foods.png', alt: 'Data Foods' },
  { src: '/logos/dfm.png', alt: 'DFM' },
  { src: '/logos/slap-media.png', alt: 'Slap Media' },
  { src: '/logos/carology.png', alt: 'The Carology' },
  { src: '/logos/image copy 3.png', alt: 'Data Flour Mills' },
  { src: '/logos/image copy 6.png', alt: 'Pitstop 63' },
  { src: '/logos/image copy 7.png', alt: 'Gari Baich' },
  { src: '/logos/adoro.png', alt: 'Adoro' },
  { src: '/logos/latch.png', alt: 'Latch' },
  { src: '/logos/zelvior.png', alt: 'Zelvior' },
  { src: '/logos/modus-1.avif', alt: 'Modus' },
  { src: '/logos/maktron.jpeg', alt: 'Maktron' },
  { src: '/logos/ahm-developers.jpg', alt: 'AHM Developers' },
];

// One extra copy is the minimum needed for a seamless loop; more would
// show the same brand twice on screen at once.
const marqueeLogos = [...logos, ...logos];
---

<section class="border-y border-slate-200 bg-slate-50 py-10 sm:py-16 overflow-hidden">
  <div class="mx-auto w-full px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">
        {title}
      </h2>
    </div>

    {/* Marquee Container */}
    <div class="relative flex w-full overflow-hidden mask-image-linear-gradient">
      <div class="animate-marquee flex items-center">
        {
          marqueeLogos.map(logo => (
            <div class="mx-5 sm:mx-7 flex flex-shrink-0 items-center justify-center h-20 sm:h-24 w-44 sm:w-52">
              <img
                src={logo.src}
                alt={logo.alt}
                class="max-h-16 sm:max-h-20 max-w-[160px] sm:max-w-[190px] w-auto h-auto object-contain transition-transform duration-300 hover:scale-105"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .mask-image-linear-gradient {
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  
  .animate-marquee {
    animation: marquee 45s linear infinite;
    /* The array is rendered twice, so -50% lands exactly on the second copy */
  }
  
  .animate-marquee:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
