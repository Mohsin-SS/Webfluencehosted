---
import { clients } from '@/data/site';

const title = 'Brands that build and grow with Webfluence';
// Order lives in src/data/site.ts (`clients`).
const logos = clients.map(c => ({ src: c.logo, alt: c.name, scale: c.scale }));

// One extra copy is the minimum needed for a seamless loop; more would
// show the same brand twice on screen at once.
const marqueeLogos = [...logos, ...logos];
---

<section class="py-10 sm:py-14" aria-labelledby="clients-heading">
  <h2
    id="clients-heading"
    data-reveal
    class="wrap text-center text-sm font-semibold tracking-[0.1em] text-slate-500 uppercase"
    style="font-family: var(--font-sans); line-height: 1.5"
  >
    {title}
  </h2>

  {/* py-4 gives enlarged logos room inside the overflow clip. */}
  <div class="logo-mask relative mt-8 flex w-full overflow-hidden py-4">
    <ul class="logo-marquee flex items-center" aria-label="Client logos">
      {
        marqueeLogos.map((logo, i) => (
          <li
            class="logo-card mr-4 flex h-24 w-40 shrink-0 items-center justify-center rounded-2xl px-5 sm:mr-6 sm:h-28 sm:w-48"
            aria-hidden={i >= logos.length ? 'true' : undefined}
          >
            <img
              src={logo.src}
              alt={i >= logos.length ? '' : logo.alt}
              class="logo-img max-h-[70%] max-w-full object-contain mix-blend-multiply"
              style={logo.scale ? `--s: ${logo.scale}` : undefined}
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .logo-mask {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  /* The list is rendered twice, so -50% lands exactly on the second copy. */
  .logo-marquee {
    animation: marquee 45s linear infinite;
  }

  .logo-marquee:hover {
    animation-play-state: paused;
  }

  /* Light cards so the dark logo artwork reads on the black page. */
  .logo-card {
    background-color: var(--color-logo-card);
    box-shadow: 0 5px 10px rgb(0 0 0 / 0.08);
    transition: transform 0.3s ease;
  }

  .logo-card:hover {
    transform: translateY(-4px);
  }

  .logo-img {
    transform: scale(var(--s, 1));
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
