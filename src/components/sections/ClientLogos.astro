---
import { clients } from '@/data/site';

const title = 'Brands that build and grow with Webfluence';
// Order lives in src/data/site.ts (`clients`).
const logos = clients.map(c => ({ src: c.logo, alt: c.name, scale: c.scale }));

// One extra copy is the minimum needed for a seamless loop; more would
// show the same brand twice on screen at once.
const marqueeLogos = [...logos, ...logos];
---

<section class="wrap relative py-10 sm:py-14" aria-labelledby="clients-heading">
  <div class="shell">
    <h2
      id="clients-heading"
      data-reveal
      class="text-center font-mono text-xs font-medium tracking-[0.1em] text-slate-500 uppercase"
    >
      {title}
    </h2>

    {/* Glass band with the marquee. py-4 gives enlarged logos room inside
        the overflow clip. */}
    <div data-reveal style="--i: 1" class="glass mt-6 rounded-[28px] px-2 py-3 sm:py-4">
      <div class="logo-mask relative flex w-full overflow-hidden py-4">
        <ul class="logo-marquee flex items-center" aria-label="Client logos">
          {
            marqueeLogos.map((logo, i) => (
              <li
                class="mx-5 flex h-14 w-32 shrink-0 items-center justify-center sm:mx-8 sm:h-[4.5rem] sm:w-40"
                aria-hidden={i >= logos.length ? 'true' : undefined}
              >
                <img
                  src={logo.src}
                  alt={i >= logos.length ? '' : logo.alt}
                  class="logo-img max-h-full max-w-full object-contain mix-blend-multiply"
                  style={logo.scale ? `--s: ${logo.scale}` : undefined}
                  loading="lazy"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .logo-mask {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  /* The list is rendered twice, so -50% lands exactly on the second copy. */
  .logo-marquee {
    animation: marquee 50s linear infinite;
  }

  .logo-marquee:hover {
    animation-play-state: paused;
  }

  .logo-img {
    transform: scale(var(--s, 1));
    filter: saturate(0.9);
    transition:
      transform 0.5s var(--ease-out-expo),
      filter 0.5s;
  }

  .logo-img:hover {
    transform: scale(calc(var(--s, 1) * 1.08));
    filter: saturate(1.1);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
