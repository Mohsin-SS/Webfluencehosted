---
import Button from '@ui/Button.astro';
import { caseStudies } from '@/data/site';

// Staggered portfolio grid from the Nexera design: tall images, every second
// card shifted down. Case studies in client order, then a product.
const items = [
  ...caseStudies.map(c => ({
    href: c.href,
    image: c.image,
    alt: c.imageAlt,
    label: `${c.client} · ${c.tag}`,
    title: c.title,
  })),
  {
    href: '/products/education-crm',
    image: '/crm-images/3.webp',
    alt: 'Education Consultancy CRM university directory',
    label: 'Webfluence product · CRM',
    title: 'Education Consultancy CRM for students, applications and agents',
  },
];
---

<section id="work" class="wrap scroll-mt-24 py-16 sm:py-24" aria-labelledby="work-heading">
  <div class="mb-12 text-center">
    <h2 id="work-heading" class="section-title" data-reveal>
      Our <span class="text-accent">portfolio</span>
    </h2>
    <p class="section-description mx-auto mt-4 max-w-2xl" data-reveal style="--i: 1">
      Software we shipped and campaigns we ran, with what each one changed for
      the client.
    </p>
  </div>

  <ul class="grid justify-items-center gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item, i) => (
        <li class={`w-full max-w-[440px] ${i % 2 ? 'stagger' : ''}`} data-reveal style={`--i: ${i % 3}`}>
          <a href={item.href} class="pf-card group flex flex-col">
            <span class="block overflow-hidden">
              <img src={item.image} alt={item.alt} class="pf-img" loading="lazy" decoding="async" />
            </span>
            <span class="text-accent mt-5 block text-xs font-semibold tracking-[0.1em] uppercase">
              {item.label}
            </span>
            <h3 class="mt-2 text-[1.3rem] leading-snug font-bold group-hover:text-accent transition-colors duration-300">
              {item.title}
            </h3>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-14 text-center" data-reveal>
    <Button href="/support/whitepapers">See all case studies</Button>
  </div>
</section>

<style>
  .pf-card {
    transition: transform 0.3s ease;
  }

  .pf-card:hover {
    transform: translateY(-5px);
  }

  .pf-img {
    width: 100%;
    height: 473px;
    object-fit: cover;
    object-position: top;
    box-shadow: 0 10px 15px rgb(0 0 0 / 0.2);
    transition: transform 0.6s ease;
  }

  .pf-card:hover .pf-img {
    transform: scale(1.04);
  }

  @media (max-width: 639px) {
    .pf-img {
      height: 340px;
    }

    .stagger {
      margin-top: 25px;
    }
  }

  @media (min-width: 640px) {
    .stagger {
      margin-top: 50px;
    }
  }
</style>
