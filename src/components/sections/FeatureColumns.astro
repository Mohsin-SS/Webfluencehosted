---
import Icon from '@ui/icons/Icon.astro';

interface Props {
  /** Tiny uppercase label above the heading. */
  eyebrow?: string;
  /** Heading text; `accent` is appended in blue. */
  title: string;
  accent?: string;
  intro?: string;
  items: { icon: string; title: string; description: string }[];
}

const { eyebrow, title, accent, intro, items } = Astro.props;
---

<section class="wrap py-16 sm:py-24">
  <div class="mb-12 text-center">
    {eyebrow && <p class="eyebrow eyebrow-center" data-reveal>{eyebrow}</p>}
    <h2 class="section-title mt-4" data-reveal style="--i: 1">
      {title}
      {accent && <span class="text-accent"> {accent}</span>}
    </h2>
    {intro && <p class="section-description mx-auto mt-4 max-w-2xl" data-reveal style="--i: 2">{intro}</p>}
  </div>

  <ul class="grid gap-6 md:grid-cols-3 lg:gap-8">
    {
      items.map((item, i) => (
        <li data-reveal data-spotlight style={`--i: ${i}`} class="glass flex flex-col rounded-2xl p-6 sm:p-8">
          <span class="bg-brand mb-5 grid size-12 place-items-center rounded-xl">
            <Icon name={item.icon} class="size-6 text-white" />
          </span>
          <h3 class="font-display mb-2 text-[1.75rem] leading-none font-normal tracking-[0.02em] uppercase">{item.title}</h3>
          <p class="text-slate-700">{item.description}</p>
        </li>
      ))
    }
  </ul>
</section>
