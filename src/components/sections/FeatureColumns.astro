---
import Icon from '@ui/icons/Icon.astro';

interface Props {
  /** Tiny uppercase label above the heading. */
  eyebrow?: string;
  /** Heading text; `accent` is appended in blue. */
  title: string;
  accent?: string;
  intro?: string;
  items: { icon: string; title: string; description: string }[];
}

const { eyebrow, title, accent, intro, items } = Astro.props;
---

<section class="lit wrap py-16 sm:py-24 [--l1x:20%] [--l1y:30%] [--l2y:0%]">
  <div class="shell">
    <div class="max-w-2xl">
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h2 data-reveal style="--i: 1" class="mt-5 text-4xl leading-[1.05] text-balance sm:text-5xl">
        {title}
        {accent && <span class="text-signal"> {accent}</span>}
      </h2>
      {intro && <p data-reveal style="--i: 2" class="mt-5 text-[16px] leading-8">{intro}</p>}
    </div>

    <ul class="mt-12 grid gap-4 md:grid-cols-3 lg:gap-5">
      {
        items.map((item, i) => (
          <li
            data-reveal
            data-spotlight
            style={`--i: ${i}`}
            class="feature glass rounded-[28px] p-7 sm:p-8"
          >
            <span class="feature-icon">
              <Icon name={item.icon} class="size-6 text-white" />
            </span>
            <h3 class="mt-8 text-xl">{item.title}</h3>
            <p class="mt-3 text-[15px] leading-7">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feature {
    transition: transform 0.6s var(--ease-out-expo);
  }

  .feature:hover {
    transform: translateY(-4px);
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: linear-gradient(140deg, var(--color-brand), var(--color-lagoon));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 10px 22px -10px rgb(20 118 235 / 0.7);
  }
</style>
