---
import Icon from '@ui/icons/Icon.astro';

// Scrolling pills of services (Nexera "animated cards"), in priority order.
const pills = [
  { name: 'Performance marketing', icon: 'cursorRays' },
  { name: 'Creative & media content', icon: 'lightbulb' },
  { name: 'ERP systems', icon: 'dataBase' },
  { name: 'CRM platforms', icon: 'portfolio' },
  { name: 'Mobile apps', icon: 'mobile' },
  { name: 'WhatsApp chatbots', icon: 'chatBubble' },
  { name: 'Web development', icon: 'newWindow' },
  { name: 'SEO', icon: 'documentMagnifyingGlass' },
];
// Two copies: the strip moves by exactly one copy for a seamless loop.
const loop = [...pills, ...pills];
---

<section class="pill-strip py-10 sm:py-16" aria-label="Services">
  <ul class="pill-track flex w-max">
    {
      loop.map((p, i) => (
        <li
          class="pill-card mr-4 flex shrink-0 items-center gap-3 rounded-full border border-card-2 bg-card px-6 py-3 font-medium whitespace-nowrap text-ink-deep sm:mr-6"
          aria-hidden={i >= pills.length ? 'true' : undefined}
        >
          <Icon name={p.icon} class="size-5 text-accent" />
          <span>{p.name}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .pill-strip {
    overflow: hidden;
    /* Fade on the left only, as in the design. */
    mask-image: linear-gradient(to right, transparent, #000 20%);
  }

  .pill-track {
    animation: pills 28s linear infinite;
  }

  .pill-strip:hover .pill-track {
    animation-play-state: paused;
  }

  @keyframes pills {
    to {
      transform: translateX(-50%);
    }
  }
</style>
