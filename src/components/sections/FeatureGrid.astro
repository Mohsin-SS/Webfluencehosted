---
import Icon from '@ui/icons/Icon.astro';

// Content for the section title and subtitle
const title =
  'Why choose <span class="text-blue-700">Webfluence</span>?';
const subTitle =
  'Experience the perfect balance of technical expertise and creative vision. From startups to enterprises, Webfluence empowers teams to build scalable software and data-driven marketing strategies while maintaining a seamless user experience. Transform the way you scale your digital presence.';

const features = [
  {
    borderClasses: 'md:border-l md:border-r',
    gradientClasses: 'bg-linear-to-l/oklch from-blue-200 to-transparent',
    icon: 'cursorRays',
    heading: 'Built for scale',
    description:
      "Whether you're an ambitious startup or a large enterprise, our software architectures are built to scale securely. From scalable APIs to complex database design, we ensure your technology grows with you.",
  },
  {
    borderClasses: 'border-b border-t md:border-b-0',
    gridClasses: 'md:col-start-2 md:col-end-3',
    gradientClasses: 'bg-linear-to-t/oklch from-blue-200 to-transparent',
    icon: 'cog',
    heading: 'Enterprise-grade quality',
    description:
      'Harness the full power of advanced software engineering. From rigorous testing to seamless deployment, Webfluence delivers exceptional performance with no compromises on quality.',
  },
  {
    borderClasses: 'md:border-l md:border-r md:border-t',
    gridClasses: 'md:col-end-4',
    gradientClasses: 'bg-linear-to-tl/oklch from-blue-200 to-transparent',
    icon: 'puzzle',
    heading: 'SEO-Friendly Solutions',
    description:
      'We integrate technical SEO best practices into everything we build. Our websites and platforms are optimized for speed, semantic structure, and search engine visibility from day one.',
  },
];
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
>
  <div
    class="grid grid-flow-row-dense grid-cols-1 md:grid-cols-3 md:grid-rows-2"
  >
    {/* Section container for the title and subtitle */}
    <div
      class="mx-auto max-w-lg pb-5 text-center md:col-span-2 lg:mx-0 lg:flex-auto lg:text-left"
    >
      <h2
        class="text-2xl font-semibold tracking-tight text-balance text-slate-800 md:text-3xl md:leading-tight"
      >
        <Fragment set:html={title} />
      </h2>
      <p
        class="mt-6 text-start text-lg/8 text-pretty text-slate-700 sm:text-center md:text-start"
      >
        {subTitle}
      </p>
    </div>

    {/* Feature Cards */}
    {
      features &&
        features.map(feature => (
          <div
            class={`group relative mx-auto flex flex-col border-dashed border-slate-400 py-10 ${feature.borderClasses} ${feature.gridClasses}`}
          >
            <div
              class={`group pointer-events-none absolute inset-0 h-full w-full ${feature.gradientClasses} opacity-0 transition duration-300 group-hover:opacity-100`}
            />
            <div class="relative z-10 mb-4 px-10">
              <Icon name={feature.icon} />
            </div>
            <div class="relative z-10 mb-2 px-10 text-lg font-semibold">
              <span class="inline-block text-balance text-slate-800 transition duration-300 group-hover:translate-x-2">
                {feature.heading}
              </span>
            </div>
            <p class="z-10 max-w-sm px-4 text-sm text-pretty text-slate-700 sm:max-w-lg md:mx-auto">
              {feature.description}
            </p>
          </div>
        ))
    }
  </div>
</section>
