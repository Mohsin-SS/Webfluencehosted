---
import FooterForm from '@ui/forms/FooterForm.astro';
import ContactInfo from '@common/ContactInfo.astro';
import { business, addressLine } from '@/data/business';

// Props for customization
const companyName = business.name;
const companyDescription =
  'Webfluence is a software development and digital marketing company in Lahore, Pakistan, providing comprehensive solutions from ERP systems to performance marketing.';

// Contact information for the company (shared with the schema; see src/data/business.ts)
const contactDetails = {
  name: business.name,
  address: addressLine,
  phone: business.phone,
  email: business.email,
  website: 'www.webfluence.tech',
};

---

<footer
  class="mt-auto w-full bg-linear-to-t/oklch from-blue-200 via-transparent to-white pb-10"
>
  <div class="mx-auto mt-auto w-full max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8">
    <hr class="mb-10 border-slate-200" />

    <div class="grid grid-cols-2 gap-6 md:grid-cols-5">
      {/* Company Information */}
      <div class="col-span-full self-center xl:col-span-2">
        <a
          href="/"
          class="flex-none text-xl font-semibold text-slate-700 uppercase focus:opacity-80 focus:outline-hidden"
          aria-label="{companyName} Homepage"
        >
          {companyName}
        </a>
        <p class="mt-5 text-pretty text-slate-600 lg:w-5/12 xl:w-10/12">
          {companyDescription}
        </p>
      </div>

      {/* Contact Information Section */}
      <div class="col-span-1 md:col-span-2 xl:col-span-1 xl:col-start-3">
        <ContactInfo {...contactDetails} />
      </div>

      {/* Email Subscription Form */}
      <div class="col-span-2 md:col-span-3 xl:col-span-2">
        <h3 class="font-semibold text-slate-700">More information?</h3>
        <FooterForm />
      </div>
    </div>
  </div>
</footer>
