---
import {
  softwareServices,
  marketingServices,
  products,
  caseStudies,
  companyLinks,
} from '@/data/site';
// Contact details are shared with the schema; see src/data/business.ts
import { business, addressLine, phoneE164 } from '@/data/business';

const year = new Date().getFullYear();

const columns = [
  { heading: 'Marketing', links: marketingServices },
  { heading: 'Software', links: softwareServices },
  { heading: 'Products', links: products },
  {
    heading: 'Case studies',
    links: caseStudies.map(c => ({ title: c.client, href: c.href })),
  },
];

const linkClass =
  'text-white/75 transition-colors duration-200 hover:text-white focus-visible:text-white';
---

<footer class="band-night text-sm text-white">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="wrap">
  <div class="shell grid gap-x-8 gap-y-12 pt-20 pb-16 sm:grid-cols-2 lg:grid-cols-12">
    {/* Brand + company */}
    <div class="lg:col-span-3">
      <a
        href="/"
        class="flex items-center gap-2.5"
        aria-label={`${business.name} home`}
        translate="no"
      >
        <img
          src="/logos/WFLogo.png"
          alt=""
          width="40"
          height="40"
          class="size-10 object-contain mix-blend-screen invert"
          loading="lazy"
        />
        <span class="font-display text-[19px] leading-none font-bold tracking-[0.01em]"
          >WEBFLUENCE</span
        >
      </a>
      <p class="mt-5 max-w-xs leading-relaxed text-white/70">
        Performance marketing and software development company in Lahore,
        Pakistan.
      </p>
      <ul class="mt-6 space-y-2.5">
        {
          companyLinks.map(link => (
            <li>
              <a href={link.href} class={linkClass}>
                {link.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Link columns */}
    <div
      class="grid grid-cols-2 gap-x-8 gap-y-10 sm:col-span-2 md:grid-cols-4 lg:col-span-6"
    >
      {
        columns.map(column => (
          <div>
            <h3 class="font-mono text-[11px] font-medium tracking-[0.1em] text-white/50 uppercase">{column.heading}</h3>
            <ul class="mt-4 space-y-2.5">
              {column.links.map(link => (
                <li>
                  <a href={link.href} class={linkClass}>
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Contact */}
    <div class="glass-dark rounded-3xl p-6 lg:col-span-3">
      <h3 class="font-mono text-[11px] font-medium tracking-[0.1em] text-white/50 uppercase">Contact us</h3>
      <address class="mt-4 space-y-2.5 not-italic">
        <p class="text-base font-medium">{business.name}</p>
        <p class="text-white/85">{addressLine}</p>
        <p>
          <span class="text-white/70">Phone:</span>{' '}
          <a href={`tel:${phoneE164}`} class={linkClass}>{business.phone}</a>
        </p>
        <p>
          <span class="text-white/70">Email:</span>{' '}
          <a href={`mailto:${business.email}`} class={linkClass}
            >{business.email}</a
          >
        </p>
      </address>
    </div>
  </div>

  </div>
  <div class="wrap border-t border-white/10">
    <div
      class="shell flex flex-col gap-2 py-6 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {business.name}. All rights reserved.</p>
      <p>
        <a href="https://www.webfluence.tech" class={linkClass}
          >www.webfluence.tech</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-glow {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: -1;
    width: min(70rem, 100%);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgb(124 196 255 / 0.7), rgb(47 208 240 / 0.7), transparent);
    box-shadow: 0 0 40px 6px rgb(20 118 235 / 0.35);
  }
</style>
