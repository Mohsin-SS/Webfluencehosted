---
import type { Faq } from '@/data/schema';

// Questions as real headings with the answer straight underneath, always
// visible in the HTML, so search engines and AI assistants can lift a
// question and its answer as one unit. Pair with faqSchema() on the page.
interface Props {
  items: Faq[];
  title?: string;
  eyebrow?: string;
}

const {
  items,
  title = 'Frequently asked questions',
  eyebrow = 'FAQ',
} = Astro.props;
---

<section class="lit wrap py-16 sm:py-24 [--l1x:40%] [--l1y:10%] [--l2y:20%]" aria-labelledby="faq-heading">
  <div class="shell grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2
        id="faq-heading"
        data-reveal
        style="--i: 1"
        class="mt-5 text-4xl leading-[1.05] text-balance sm:text-5xl"
      >
        {title}
      </h2>
      <p data-reveal style="--i: 2" class="mt-5 max-w-sm text-[15px] leading-7">
        Something else on your mind?{' '}
        <a href="/contact" class="text-brand font-medium underline-offset-4 hover:underline">Ask the team</a>,
        or browse the{' '}
        <a href="/support/knowledge-base" class="text-brand font-medium underline-offset-4 hover:underline">knowledge base</a>.
      </p>
    </div>

    <div class="grid gap-4">
      {
        items.map((item, i) => (
          <div
            data-reveal
            data-spotlight
            style={`--i: ${Math.min(i, 4)}`}
            class="glass rounded-3xl p-6 sm:p-7"
          >
            <h3 class="faq-q text-[1.15rem] leading-snug sm:text-xl">
              {item.question}
            </h3>
            <p class="mt-3 text-[15px] leading-7">{item.answer}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-q {
    position: relative;
    padding-left: 1.1rem;
  }

  .faq-q::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    bottom: 0.35em;
    width: 3px;
    border-radius: 3px;
    background: linear-gradient(var(--color-brand), var(--color-lagoon));
  }
</style>
