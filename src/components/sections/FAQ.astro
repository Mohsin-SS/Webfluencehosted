---
import type { Faq } from '@/data/schema';

// FAQ accordion from the Nexera design: header on the left, questions on the
// right. Built on <details>, so every answer is in the HTML (search engines
// and AI assistants read it) and it works without JavaScript. Each question
// is a real heading. Pair with faqSchema() on the page.
interface Props {
  items: Faq[];
  title?: string;
  eyebrow?: string;
}

const { items, title = 'Frequently asked questions' } = Astro.props;
const words = title.split(' ');
const last = words.pop();
---

<section class="wrap py-16 sm:py-24" aria-labelledby="faq-heading">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-10 md:flex-row md:items-start md:gap-16">
    <div class="text-center md:sticky md:top-28 md:max-w-[40%] md:flex-1 md:text-left">
      <h2 id="faq-heading" class="section-title" data-reveal>
        {words.join(' ')}{' '}<span class="text-accent">{last}</span>
      </h2>
      <p class="section-description mt-4" data-reveal style="--i: 1">
        Answers to common questions about our services. Something else on
        your mind?{' '}
        <a href="/contact" class="text-accent font-semibold hover:underline">Ask the team</a>.
      </p>
    </div>

    <div class="w-full md:flex-[2]">
      {
        items.map((item, i) => (
          <details class="faq-item group" open={i === 0} data-reveal style={`--i: ${Math.min(i, 4)}`}>
            <summary class="faq-q">
              <h3 class="text-lg leading-snug font-semibold">{item.question}</h3>
              <svg class="faq-icon size-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="faq-a">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item {
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-card);
    transition: background-color 0.3s ease;
  }

  .faq-item:hover {
    background-color: var(--color-panel);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-ink-deep);
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    color: var(--color-muted);
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .faq-a {
    padding: 0 1.5rem 1.25rem;
    color: var(--color-slate-700);
    line-height: 1.6;
    animation: faq-open 0.4s ease-out;
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
