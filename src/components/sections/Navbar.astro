---
import Button from '@ui/Button.astro';
import {
  softwareServices,
  marketingServices,
  products,
  caseStudies,
  supportLinks,
  companyLinks,
} from '@/data/site';

const currentPath = Astro.url.pathname.replace(/\.html$/, '');

const primaryCTA = { text: 'Start a project', href: '/contact' };

const isActive = (prefixes: string[]) =>
  prefixes.some(p => currentPath === p || currentPath.startsWith(p + '/'));

// Each dropdown is a list of columns; a column is a labelled list of links.
const menus = [
  {
    id: 'services',
    label: 'Services',
    active: isActive([
      ...marketingServices.map(s => s.href),
      ...softwareServices.map(s => s.href),
    ]),
    width: 'lg:w-[44rem]',
    columns: [
      {
        heading: 'Marketing',
        accent: 'bg-linear-to-r from-leaf to-lagoon',
        items: marketingServices,
      },
      { heading: 'Software', accent: 'bg-brand', items: softwareServices },
    ],
  },
  {
    id: 'products',
    label: 'Products',
    active: isActive(['/products']),
    width: 'lg:w-[24rem]',
    columns: [{ heading: 'Our products', accent: 'bg-brand', items: products }],
  },
  {
    id: 'work',
    label: 'Case studies',
    active: isActive(['/work', '/case-studies']),
    width: 'lg:w-[44rem]',
    split: true,
    columns: [
      {
        heading: 'Client work',
        accent: 'bg-brand',
        items: caseStudies.map(c => ({
          title: c.client,
          href: c.href,
          description: c.summary,
          logo: c.logo,
        })),
      },
    ],
  },
  {
    id: 'support',
    label: 'Support',
    active: isActive(['/support']),
    width: 'lg:w-[24rem]',
    columns: [
      { heading: 'Resources', accent: 'bg-brand', items: supportLinks },
    ],
  },
];

const linkBase =
  'flex w-full items-center gap-1.5 rounded-md px-3 py-2 text-[15px] lg:text-[13.5px] text-ink hover:text-brand focus-visible:text-brand transition-colors';
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white transition-shadow duration-300 data-[scrolled]:shadow-[0_1px_0_0_var(--color-slate-200),0_8px_24px_-18px_rgb(20_20_20/0.35)]"
>
  <nav
    class="wrap relative lg:flex lg:h-[72px] lg:items-center lg:justify-between lg:gap-6"
    aria-label="Main"
  >
    <div class="flex h-[64px] items-center justify-between lg:h-auto">
      <a
        class="flex flex-none items-center gap-2.5"
        href="/"
        aria-label="Webfluence home"
        translate="no"
      >
        <img
          src="/logos/WFLogo.png"
          alt=""
          width="40"
          height="40"
          class="size-10 object-contain mix-blend-multiply"
        />
        <span
          class="text-ink text-[19px] leading-none font-bold tracking-[0.02em]"
          >WEBFLUENCE</span
        >
      </a>

      <button
        type="button"
        class="hs-collapse-toggle text-ink hover:bg-mist relative flex size-10 items-center justify-center rounded-md border border-slate-300 lg:hidden"
        id="hs-header-base-collapse"
        aria-expanded="false"
        aria-controls="hs-header-base"
        aria-label="Toggle navigation"
        data-hs-collapse="#hs-header-base"
      >
        <svg
          class="hs-collapse-open:hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
        <svg
          class="hs-collapse-open:block hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
        >
      </button>
    </div>

    <div
      id="hs-header-base"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 lg:block"
      aria-labelledby="hs-header-base-collapse"
    >
      <div
        class="max-h-[75vh] overflow-y-auto border-t border-slate-200 py-3 lg:max-h-none lg:overflow-visible lg:border-0 lg:py-0"
      >
        <div class="flex flex-col gap-1 lg:flex-row lg:items-center">
          <div
            class="flex grow flex-col gap-0.5 lg:flex-row lg:items-center lg:justify-center lg:gap-1"
          >
            {
              menus.map(menu => (
                <div class="hs-dropdown [--adaptive:none] [--is-collapse:true] [--strategy:static] lg:[--is-collapse:false] lg:[--strategy:absolute] lg:[--trigger:hover]">
                  <button
                    id={`menu-${menu.id}`}
                    type="button"
                    class={`hs-dropdown-toggle ${linkBase} ${menu.active ? 'text-brand font-semibold' : ''}`}
                    aria-haspopup="menu"
                    aria-expanded="false"
                  >
                    {menu.label}
                    <svg
                      class="hs-dropdown-open:rotate-180 ml-auto size-3.5 transition-transform duration-200 lg:ml-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>

                  <div
                    class={`hs-dropdown-menu hs-dropdown-open:opacity-100 relative start-0 top-full z-10 hidden w-full opacity-0 transition-[opacity,margin] duration-200 before:absolute before:start-0 before:-top-4 before:h-4 before:w-full lg:left-1/2 lg:mt-0 lg:-translate-x-1/2 ${menu.width}`}
                    role="menu"
                    aria-orientation="vertical"
                    aria-labelledby={`menu-${menu.id}`}
                  >
                    <div class="relative overflow-hidden px-3 pt-1 pb-3 lg:rounded-2xl lg:border lg:border-slate-200 lg:bg-white lg:p-6 lg:shadow-[0_24px_48px_-24px_rgb(20_20_20/0.3)]">
                      <div
                        class="stripes stripes-fade-b pointer-events-none absolute inset-x-6 top-0 hidden h-8 [--stripe-color:rgb(20_118_235/0.18)] lg:block"
                        aria-hidden="true"
                      />
                      <div
                        class={`relative grid gap-x-8 gap-y-4 ${menu.columns.length > 1 ? 'lg:grid-cols-[1.25fr_1fr]' : ''}`}
                      >
                        {menu.columns.map(column => (
                          <div>
                            <p class="mb-2 flex items-center gap-2 px-2 text-[11px] tracking-[0.14em] text-slate-500 uppercase">
                              <span
                                class={`h-0.5 w-5 rounded-full ${column.accent}`}
                              />
                              {column.heading}
                            </p>
                            <ul
                              class={`grid gap-0.5 ${menu.split ? 'sm:grid-cols-2' : ''}`}
                            >
                              {column.items.map((item: any) => (
                                <li>
                                  <a
                                    href={item.href}
                                    class="group/item hover:bg-mist focus-visible:bg-mist flex items-start gap-3 rounded-lg p-2"
                                    aria-current={
                                      currentPath === item.href
                                        ? 'page'
                                        : undefined
                                    }
                                  >
                                    {item.logo && (
                                      <span class="grid size-10 shrink-0 place-items-center rounded-lg border border-slate-200 bg-white p-1">
                                        <img
                                          src={item.logo}
                                          alt=""
                                          class="max-h-full max-w-full object-contain"
                                          loading="lazy"
                                        />
                                      </span>
                                    )}
                                    <span class="min-w-0">
                                      <span class="text-ink group-hover/item:text-brand block text-sm font-medium">
                                        {item.title}
                                      </span>
                                      <span class="mt-0.5 block text-xs leading-relaxed text-slate-500">
                                        {item.description}
                                      </span>
                                    </span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }

            {
              companyLinks.map(link => (
                <a
                  href={link.href}
                  class={`${linkBase} lg:w-auto ${currentPath === link.href ? 'text-brand font-semibold' : ''}`}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                >
                  {link.title}
                </a>
              ))
            }
          </div>

          <div class="mt-3 px-3 lg:mt-0 lg:px-0">
            <Button href={primaryCTA.href} variant="primary" size="sm"
              >{primaryCTA.text}</Button
            >
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Preline powers the dropdowns and the mobile collapse.
  document.addEventListener('astro:page-load', async () => {
    const { HSStaticMethods } = await import('preline');
    HSStaticMethods.autoInit();
  });

  // Add a hairline + soft shadow once the page has scrolled.
  const markScrolled = () => {
    const header = document.getElementById('site-header');
    if (!header) return;
    if (window.scrollY > 4) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  };
  window.addEventListener('scroll', markScrolled, { passive: true });
  document.addEventListener('astro:page-load', markScrolled);
</script>
