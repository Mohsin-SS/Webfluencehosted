---
import Button from '@ui/Button.astro';
import {
  softwareServices,
  marketingServices,
  products,
  caseStudies,
  supportLinks,
  companyLinks,
} from '@/data/site';

const currentPath = Astro.url.pathname.replace(/\.html$/, '');

const primaryCTA = { text: "Let's talk", href: '/contact' };

const isActive = (prefixes: string[]) =>
  prefixes.some(p => currentPath === p || currentPath.startsWith(p + '/'));

// Each dropdown is a list of columns; a column is a labelled list of links.
const menus = [
  {
    id: 'services',
    label: 'Services',
    active: isActive([
      ...marketingServices.map(s => s.href),
      ...softwareServices.map(s => s.href),
    ]),
    width: 'lg:w-[44rem]',
    columns: [
      {
        heading: 'Marketing',
        accent: 'bg-linear-to-r from-leaf to-lagoon',
        items: marketingServices,
      },
      { heading: 'Software', accent: 'bg-brand', items: softwareServices },
    ],
  },
  {
    id: 'products',
    label: 'Products',
    active: isActive(['/products']),
    width: 'lg:w-[24rem]',
    columns: [{ heading: 'Our products', accent: 'bg-brand', items: products }],
  },
  {
    id: 'work',
    label: 'Case studies',
    active: isActive(['/work', '/case-studies']),
    width: 'lg:w-[44rem]',
    split: true,
    columns: [
      {
        heading: 'Client work',
        accent: 'bg-brand',
        items: caseStudies.map(c => ({
          title: c.client,
          href: c.href,
          description: c.summary,
          logo: c.logo,
        })),
      },
    ],
  },
  {
    id: 'support',
    label: 'Support',
    active: isActive(['/support']),
    width: 'lg:w-[24rem]',
    columns: [
      { heading: 'Resources', accent: 'bg-brand', items: supportLinks },
    ],
  },
];

const linkBase =
  'flex w-full items-center gap-1.5 px-3 py-2 text-[15px] lg:text-[13.5px] font-medium uppercase tracking-[0.04em] text-ink-deep hover:text-accent focus-visible:text-accent transition-colors duration-300';

// Sun / moon toggle. Shows the moon in light mode (switch to dark) and the
// sun in dark mode; the script below does the switching.
const themeToggle =
  'theme-toggle grid size-10 shrink-0 place-items-center rounded-full border border-glass-line bg-card/70 text-ink-deep transition-[transform,background-color] duration-300 hover:-translate-y-0.5 hover:bg-card';
---

<header id="site-header" class="sticky top-0 z-50 px-4 pt-3 sm:px-6 xl:px-8">
  {/* Floating glass pill: logo left, uppercase links, theme toggle, CTA. */}
  <nav
    class="nav-pill relative rounded-[28px] px-3 transition-[background-color,box-shadow] duration-300 lg:flex lg:h-[64px] lg:items-center lg:justify-between lg:gap-4 lg:rounded-full lg:pr-2.5 lg:pl-5"
    aria-label="Main"
  >
    <div class="flex h-[58px] items-center justify-between gap-2 lg:h-auto">
      <a
        class="flex flex-none items-center gap-2.5"
        href="/"
        aria-label="Webfluence home"
        translate="no"
      >
        <img
          src="/logos/WFLogo.png"
          alt=""
          width="40"
          height="40"
          class="size-10 rounded-full object-contain mix-blend-multiply dark:mix-blend-screen dark:invert"
        />
        <span
          class="text-ink-deep text-[1.4rem] leading-none font-bold tracking-[0.01em]"
          >WEBFLUENCE</span
        >
      </a>

      <span class="ml-auto lg:hidden">
        <button type="button" class={themeToggle} data-theme-toggle aria-label="Switch to dark theme">
          <svg class="icon-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
          <svg class="icon-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </span>

      <button
        type="button"
        class="hs-collapse-toggle text-ink-deep relative flex size-10 items-center justify-center rounded-full lg:hidden"
        id="hs-header-base-collapse"
        aria-expanded="false"
        aria-controls="hs-header-base"
        aria-label="Toggle navigation"
        data-hs-collapse="#hs-header-base"
      >
        <svg
          class="hs-collapse-open:hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
        <svg
          class="hs-collapse-open:block hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
        >
      </button>
    </div>

    <div
      id="hs-header-base"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 lg:block"
      aria-labelledby="hs-header-base-collapse"
    >
      <div
        class="max-h-[75vh] overflow-y-auto border-t border-card py-3 lg:max-h-none lg:overflow-visible lg:border-0 lg:py-0"
      >
        <div class="flex flex-col gap-1 lg:flex-row lg:items-center">
          <div
            class="flex grow flex-col gap-0.5 lg:flex-row lg:items-center lg:justify-center lg:gap-1"
          >
            {
              menus.map(menu => (
                <div class="hs-dropdown [--adaptive:none] [--is-collapse:true] [--strategy:static] lg:[--is-collapse:false] lg:[--strategy:absolute] lg:[--trigger:hover]">
                  <button
                    id={`menu-${menu.id}`}
                    type="button"
                    class={`hs-dropdown-toggle ${linkBase} ${menu.active ? 'text-accent font-semibold' : ''}`}
                    aria-haspopup="menu"
                    aria-expanded="false"
                  >
                    {menu.label}
                    <svg
                      class="hs-dropdown-open:rotate-180 ml-auto size-3.5 transition-transform duration-200 lg:ml-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>

                  <div
                    class={`hs-dropdown-menu hs-dropdown-open:opacity-100 relative start-0 top-full z-10 hidden w-full opacity-0 transition-[opacity,margin] duration-200 before:absolute before:start-0 before:-top-4 before:h-4 before:w-full lg:left-1/2 lg:mt-0 lg:-translate-x-1/2 ${menu.width}`}
                    role="menu"
                    aria-orientation="vertical"
                    aria-labelledby={`menu-${menu.id}`}
                  >
                    <div class="nav-sheet relative overflow-hidden px-1 pt-1 pb-3 lg:mt-2 lg:rounded-2xl lg:p-5">
                      <div
                        class={`relative grid gap-x-8 gap-y-4 ${menu.columns.length > 1 ? 'lg:grid-cols-[1.25fr_1fr]' : ''}`}
                      >
                        {menu.columns.map(column => (
                          <div>
                            <p class="mb-2 flex items-center gap-2 px-2 text-[11px] font-semibold tracking-[0.1em] text-slate-500 uppercase">
                              <span
                                class={`h-0.5 w-5 rounded-full ${column.accent}`}
                              />
                              {column.heading}
                            </p>
                            <ul
                              class={`grid gap-0.5 ${menu.split ? 'sm:grid-cols-2' : ''}`}
                            >
                              {column.items.map((item: any) => (
                                <li>
                                  <a
                                    href={item.href}
                                    class="group/item flex items-start gap-3 rounded-xl p-2.5 transition-colors duration-200 hover:bg-card focus-visible:bg-card"
                                    aria-current={
                                      currentPath === item.href
                                        ? 'page'
                                        : undefined
                                    }
                                  >
                                    {item.logo && (
                                      <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-white p-1">
                                        <img
                                          src={item.logo}
                                          alt=""
                                          class="max-h-full max-w-full object-contain"
                                          loading="lazy"
                                        />
                                      </span>
                                    )}
                                    <span class="min-w-0">
                                      <span class="group-hover/item:text-accent text-ink-deep block text-sm font-semibold">
                                        {item.title}
                                      </span>
                                      <span class="mt-0.5 block text-xs leading-relaxed text-slate-500">
                                        {item.description}
                                      </span>
                                    </span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }

            {
              companyLinks.map(link => (
                <a
                  href={link.href}
                  class={`${linkBase} lg:w-auto ${currentPath === link.href ? 'text-accent font-semibold' : ''}`}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                >
                  {link.title}
                </a>
              ))
            }
          </div>

          <div class="mt-3 flex items-center gap-2 px-2 pb-3 lg:mt-0 lg:px-0 lg:pb-0">
            <button type="button" class={`${themeToggle} hidden lg:grid`} data-theme-toggle aria-label="Switch to dark theme">
              <svg class="icon-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
              <svg class="icon-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
            <Button href={primaryCTA.href} variant="primary" size="sm"
              >{primaryCTA.text}</Button
            >
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Preline powers the dropdowns and the mobile collapse.
  document.addEventListener('astro:page-load', async () => {
    const { HSStaticMethods } = await import('preline');
    HSStaticMethods.autoInit();
  });

  // Firm up the glass bar once the page has scrolled.
  const markScrolled = () => {
    const header = document.getElementById('site-header');
    if (!header) return;
    if (window.scrollY > 4) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  };
  window.addEventListener('scroll', markScrolled, { passive: true });
  document.addEventListener('astro:page-load', markScrolled);
</script>

<style is:global>
  /* Glass pill. Only the standard backdrop-filter here: the CSS minifier
     merges a -webkit-/standard pair in one rule and keeps just one. Older
     Safari gets its prefixed blur from the @supports rule below. */
  .nav-pill {
    background: var(--color-glass);
    border: 1px solid var(--color-glass-line);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 10px 30px -12px rgb(0 0 0 / 0.25);
    backdrop-filter: blur(18px) saturate(170%);
  }

  @supports (-webkit-backdrop-filter: none) and (not (backdrop-filter: none)) {
    .nav-pill {
      -webkit-backdrop-filter: blur(18px) saturate(170%);
    }
  }

  /* Firmer glass once the page scrolls under it. */
  #site-header[data-scrolled] .nav-pill {
    background: color-mix(in srgb, var(--color-card) 82%, transparent);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 14px 34px -14px rgb(0 0 0 / 0.35);
  }

  /* Sun when the chosen theme is dark, moon when it is light. Keyed to the
     saved choice (data-theme), not to html.dark, which the testimonials
     flip changes temporarily. */
  .theme-toggle .icon-sun {
    display: none;
  }

  html[data-theme='dark'] .theme-toggle .icon-sun {
    display: block;
  }

  html[data-theme='dark'] .theme-toggle .icon-moon {
    display: none;
  }

  /* Dropdown sheet. A blurred element inside the blurred pill cannot blur
     the page behind it, so the sheet is solid. */
  @media (min-width: 1024px) {
    .nav-sheet {
      background: var(--color-card);
      border: 1px solid var(--color-glass-line);
      box-shadow: 0 24px 48px -20px rgb(0 0 0 / 0.35);
    }
  }
</style>

<script>
  // Theme toggle: saves the choice and re-renders (BaseLayout owns the
  // rendering so the testimonials flip keeps working).
  function initThemeToggle() {
    const label = () =>
      document.documentElement.dataset.theme === 'dark'
        ? 'Switch to light theme'
        : 'Switch to dark theme';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(btn => {
      btn.setAttribute('aria-label', label());
      btn.onclick = () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', next);
        } catch {}
        document.documentElement.dataset.theme = next;
        (window as any).__renderTheme?.();
        document
          .querySelectorAll('[data-theme-toggle]')
          .forEach(b => b.setAttribute('aria-label', label()));
      };
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
