---
import Icon from '@ui/icons/Icon.astro';
import { softwareServices } from '@/data/site';

// Services in priority order (see the ORDER note in src/data/site.ts).
// Card size follows priority: performance marketing gets the widest card.
const software = softwareServices.filter(s => s.href !== '/web-development');

const adoro = [
  { value: 57, prefix: '+', suffix: '%', label: 'Monthly sales' },
  { value: 65, prefix: '+', suffix: '%', label: 'Store visits' },
  { value: 32, prefix: '+', suffix: '%', label: 'Average order value' },
];

const channels = ['Google Ads', 'Meta Ads', 'Purchase tracking', 'Landing pages'];
const creative = ['Social media content', 'Short video', 'Brand identity', 'UI/UX'];

const arrow = 'M7 17 17 7M8 7h9v9';
---

<section id="services" class="lit wrap py-16 sm:py-24 [--l1y:30%] [--l2y:-4%]" aria-labelledby="services-heading">
  <div class="shell">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>What we do</p>
      <h2
        id="services-heading"
        data-reveal
        style="--i: 1"
        class="mt-5 text-4xl leading-[1.05] sm:text-5xl"
      >
        Marketing that sells, and the <span class="text-signal">systems</span> behind it.
      </h2>
      <p data-reveal style="--i: 2" class="mt-5 text-[16px] leading-8">
        Start with the service you need most. One team runs all of it, so your
        ads, content, website and software work from the same numbers.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-6 lg:gap-5">
      {/* 1. Performance marketing */}
      <a
        href="/digital-marketing"
        data-reveal
        data-spotlight
        class="bento glass group flex flex-col rounded-[28px] p-7 sm:p-9 lg:col-span-4"
      >
        <div class="flex items-start justify-between gap-6">
          <span class="bento-icon"><Icon name="cursorRays" class="size-6 text-white" /></span>
          <span class="bento-go" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg>
          </span>
        </div>
        <h3 class="mt-8 text-[1.75rem] leading-tight sm:text-3xl">Performance marketing</h3>
        <p class="mt-3 max-w-lg text-[15px] leading-7">
          Google Ads and Meta Ads run on real sales data, with tracking that
          counts purchases, not page views.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {channels.map(c => <li class="pill">{c}</li>)}
        </ul>

        <div class="mt-8 rounded-2xl bg-white/55 p-5 ring-1 ring-white/80">
          <p class="font-mono text-[11px] tracking-[0.08em] text-slate-500 uppercase">
            Adoro (ECS) results
          </p>
          <dl class="mt-3 grid grid-cols-3 gap-3">
            {
              adoro.map(stat => (
                <div>
                  <dd
                    class="font-display text-leaf text-3xl font-bold tracking-tight sm:text-4xl"
                    data-count={stat.value}
                    data-prefix={stat.prefix}
                    data-suffix={stat.suffix}
                  >
                    {stat.prefix}{stat.value}{stat.suffix}
                  </dd>
                  <dt class="mt-1 text-xs leading-5 text-slate-600 sm:text-[13px]">{stat.label}</dt>
                </div>
              ))
            }
          </dl>
        </div>
      </a>

      {/* 2. Creative & media content */}
      <a
        href="/creative"
        data-reveal
        data-spotlight
        style="--i: 1"
        class="bento glass group flex flex-col rounded-[28px] p-7 sm:p-8 lg:col-span-2"
      >
        <div class="flex items-start justify-between gap-6">
          <span class="bento-icon"><Icon name="lightbulb" class="size-6 text-white" /></span>
          <span class="bento-go" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg>
          </span>
        </div>
        <h3 class="mt-8 text-2xl leading-tight">Creative &amp; media content</h3>
        <p class="mt-3 text-[15px] leading-7">
          Content made and posted for you, so your feed stays consistent and
          your ads stay fresh.
        </p>
        <ul class="mt-auto flex flex-wrap gap-2 pt-6">
          {creative.map(c => <li class="pill">{c}</li>)}
        </ul>
      </a>

      {/* 3. Software development */}
      <div
        data-reveal
        data-spotlight
        class="bento glass flex flex-col rounded-[28px] p-7 sm:p-8 lg:col-span-2"
      >
        <span class="bento-icon"><Icon name="cog" class="size-6 text-white" /></span>
        <h3 class="mt-8 text-2xl leading-tight">Software development</h3>
        <p class="mt-3 text-[15px] leading-7">
          Systems built around how your business runs.
        </p>
        <ul class="mt-5 divide-y divide-white/80 border-t border-white/80">
          {
            software.map(s => (
              <li>
                <a
                  href={s.href}
                  class="group/link flex items-center justify-between gap-4 py-3 text-[15px] font-medium text-ink-deep transition-colors hover:text-brand"
                >
                  {s.title}
                  <svg class="size-3.5 transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* 4. Web development */}
      <a
        href="/web-development"
        data-reveal
        data-spotlight
        style="--i: 1"
        class="bento glass group flex flex-col rounded-[28px] p-7 sm:p-8 lg:col-span-2"
      >
        <div class="flex items-start justify-between gap-6">
          <span class="bento-icon"><Icon name="newWindow" class="size-6 text-white" /></span>
          <span class="bento-go" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg>
          </span>
        </div>
        <h3 class="mt-8 text-2xl leading-tight">Web development</h3>
        <p class="mt-3 text-[15px] leading-7">
          Fast websites, Shopify stores and web apps, built to rank and to
          convert the traffic your ads send.
        </p>
        <p class="mt-auto pt-6 font-mono text-[11px] tracking-[0.08em] text-slate-500 uppercase">
          Recent: Latch · Zelvior Official
        </p>
      </a>

      {/* 5. SEO */}
      <a
        href="/seo"
        data-reveal
        data-spotlight
        style="--i: 2"
        class="bento glass group flex flex-col rounded-[28px] p-7 sm:p-8 lg:col-span-2"
      >
        <div class="flex items-start justify-between gap-6">
          <span class="bento-icon"><Icon name="documentMagnifyingGlass" class="size-6 text-white" /></span>
          <span class="bento-go" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={arrow} /></svg>
          </span>
        </div>
        <h3 class="mt-8 text-2xl leading-tight">SEO</h3>
        <p class="mt-3 text-[15px] leading-7">
          Technical fixes, on-page work and content, reported on the leads it
          brings rather than rankings alone.
        </p>
      </a>
    </div>
  </div>
</section>

<style>
  .bento {
    transition:
      transform 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo);
  }

  a.bento:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      0 0 0 1px rgb(20 118 235 / 0.1),
      0 34px 70px -34px rgb(10 40 90 / 0.45);
  }

  .bento-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    color: #fff;
    background: linear-gradient(140deg, var(--color-brand), var(--color-lagoon));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 10px 22px -10px rgb(20 118 235 / 0.7);
  }

  .bento-go {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    color: var(--color-ink-deep);
    background: rgb(255 255 255 / 0.7);
    box-shadow: 0 0 0 1px rgb(14 52 110 / 0.08);
    transition:
      transform 0.5s var(--ease-out-expo),
      background 0.3s,
      color 0.3s;
  }

  .bento-go svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  a.bento:hover .bento-go {
    transform: rotate(45deg);
    background: var(--color-brand);
    color: #fff;
  }

  .pill {
    border-radius: 9999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.8125rem;
    color: var(--color-ink-deep);
    background: rgb(255 255 255 / 0.65);
    box-shadow: 0 0 0 1px rgb(14 52 110 / 0.08);
  }
</style>
