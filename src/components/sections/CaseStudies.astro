---
const caseStudies = [
  {
    badge: 'Education & AI CRM',
    client: 'Times Consultant',
    title: 'AI CRM & WhatsApp Automation for 500+ Overseas Students',
    description:
      'Times Consultant needed to eliminate scattered WhatsApp chats and disorganized spreadsheets. We engineered a unified, role-based CRM with AI performance tracking and automated WhatsApp lead capture.',
    image: '/crm-images/1.webp',
    imageAlt: 'Times Consultant CRM Dashboard',
    metrics: [
      { value: '45%', label: 'Faster Lead Response' },
      { value: '10k+', label: 'Automated Chats Handled' },
      { value: '100%', label: 'Centralized Lead Data' },
    ],
    testimonial: {
      quote: 'Mohsin’s team understood our workflow better than we expected. Now everything lives in one CRM.',
      author: 'Ali, Operations Director',
    },
    href: '/products/education-crm',
    ctaText: 'Explore Education CRM',
  },
  {
    badge: 'Enterprise ERP & Analytics',
    client: 'ACME Corporation',
    title: 'Modernizing Legacy Operations with Real-Time ERP Integration',
    description:
      'Struggling with disconnected silos and slow order cycles, ACME partnered with Webfluence to design a centralized ERP system featuring automated lead routing, live inventory sync, and executive dashboards.',
    image: '/crm-images/2.png',
    imageAlt: 'ACME ERP Analytics Dashboard',
    metrics: [
      { value: '30%', label: 'Productivity Increase' },
      { value: 'Real-Time', label: 'Inventory Sync' },
      { value: 'Unified', label: 'Cross-Department View' },
    ],
    testimonial: {
      quote: 'A custom CRM integrated directly with our existing ERP, giving us an instant 360° operational view.',
      author: 'Operations Team Lead',
    },
    href: '/crm',
    ctaText: 'View CRM & ERP Solutions',
  },
  {
    badge: 'AI Software & Web App',
    client: 'Commercial Builders',
    title: 'Construction Price Estimator AI for Accurate Project Budgeting',
    description:
      'Eliminated weeks of manual bidding calculations by deploying an AI cost estimation tool that generates precise material, labor, and BOQ estimates in seconds from architectural inputs.',
    image: '/crm-images/3.webp',
    imageAlt: 'Construction Price Estimator Interface',
    metrics: [
      { value: '98%', label: 'Estimation Accuracy' },
      { value: '10x', label: 'Faster Proposal Turnaround' },
      { value: 'Instant', label: 'BOQ Generation' },
    ],
    testimonial: {
      quote: 'Takes the guesswork out of budgeting. Clients receive instant, credible cost estimates on the spot.',
      author: 'Lead Architect',
    },
    href: '/products/construction-price-estimator',
    ctaText: 'View AI Estimator',
  },
];
---

<section
  id="case-studies"
  class="relative py-16 sm:py-24 bg-white border-b border-slate-200/80 overflow-hidden"
  aria-label="Case Studies"
>
  <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="mx-auto max-w-3xl text-center mb-14 sm:mb-20">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-blue-100 text-blue-700">
        Proven Impact
      </span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Real Results. Engineered to Scale.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Explore how we help industry leaders untangle complex operations, automate workflows, and build software that drives measurable bottom-line growth.
      </p>
    </div>

    {/* Case Studies List */}
    <div class="space-y-16 sm:space-y-24">
      {
        caseStudies.map((study, idx) => {
          const isEven = idx % 2 === 1;
          return (
            <article class="group relative rounded-3xl border border-slate-200/90 bg-slate-50/50 p-6 sm:p-10 lg:p-12 hover:border-blue-200 hover:shadow-xl hover:bg-white transition-all duration-300">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                {/* Content Column */}
                <div class={`lg:col-span-6 space-y-6 ${isEven ? 'lg:order-2' : 'lg:order-1'}`}>
                  {/* Badge & Client */}
                  <div class="flex items-center gap-3 flex-wrap">
                    <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200/60">
                      {study.badge}
                    </span>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                      Client: {study.client}
                    </span>
                  </div>

                  {/* Title & Description */}
                  <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 leading-snug group-hover:text-blue-700 transition-colors">
                    {study.title}
                  </h3>
                  <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
                    {study.description}
                  </p>

                  {/* Metrics Grid */}
                  <div class="grid grid-cols-3 gap-3 py-4 border-y border-slate-200/70">
                    {study.metrics.map(metric => (
                      <div>
                        <div class="text-xl sm:text-2xl font-extrabold text-blue-600">
                          {metric.value}
                        </div>
                        <div class="text-xs text-slate-500 mt-1 font-medium leading-tight">
                          {metric.label}
                        </div>
                      </div>
                    ))}
                  </div>

                  {/* Pull Quote */}
                  <div class="bg-blue-50/60 border-l-3 border-blue-600 rounded-r-xl p-4">
                    <p class="text-xs sm:text-sm italic text-slate-700">
                      "{study.testimonial.quote}"
                    </p>
                    <p class="text-xs font-semibold text-slate-800 mt-1.5">
                      — {study.testimonial.author}
                    </p>
                  </div>

                  {/* Link Button */}
                  <div class="pt-2">
                    <a
                      href={study.href}
                      class="inline-flex items-center gap-2 text-sm sm:text-base font-semibold text-blue-600 hover:text-blue-800 group/link transition-colors"
                    >
                      <span>{study.ctaText}</span>
                      <svg
                        class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                  </div>
                </div>

                {/* Media Column */}
                <div class={`lg:col-span-6 ${isEven ? 'lg:order-1' : 'lg:order-2'}`}>
                  <div class="relative rounded-2xl overflow-hidden border border-slate-200/80 bg-white shadow-md group-hover:shadow-xl transition-all duration-300">
                    <img
                      src={study.image}
                      alt={study.imageAlt}
                      class="w-full h-auto max-h-[420px] object-cover object-top transform group-hover:scale-102 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/15 via-transparent to-transparent pointer-events-none" />
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
