---
import { caseStudies } from '@/data/site';

const subTitle =
  'Software we shipped and campaigns we ran, with what each one changed for the client.';

const arrowButton =
  'glass-thin grid size-11 place-items-center rounded-full text-ink-deep transition-[transform,opacity] duration-300 hover:-translate-y-0.5 disabled:opacity-35 disabled:hover:translate-y-0';
---

<section
  id="work"
  class="lit wrap scroll-mt-24 py-16 sm:py-24 [--l1x:30%] [--l1y:20%] [--l2y:10%]"
  aria-labelledby="work-heading"
  data-rail
>
  <div class="shell">
  <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
    <div class="max-w-xl">
      <p class="eyebrow" data-reveal>Case studies</p>
      <h2
        id="work-heading"
        data-reveal
        style="--i: 1"
        class="mt-5 text-4xl leading-[1.05] sm:text-5xl"
      >
        Work and <span class="text-signal">results</span>
      </h2>
      <p data-reveal style="--i: 2" class="mt-5 text-[16px] leading-8">{subTitle}</p>
    </div>

    <div class="flex gap-3" data-reveal style="--i: 2">
      <button
        type="button"
        class={arrowButton}
        aria-label="Previous case studies"
        data-rail-prev
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"></path></svg
        >
      </button>
      <button
        type="button"
        class={arrowButton}
        aria-label="Next case studies"
        data-rail-next
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
        >
      </button>
    </div>
  </div>

  <ul
    class="rail-track -mx-4 mt-10 flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pt-2 pb-10"
    data-rail-track
  >
    {
      caseStudies.map((study, i) => (
        <li
          class="w-[84%] shrink-0 snap-start sm:w-[46%] lg:w-[calc((100%-2.5rem)/3)]"
          data-reveal
          style={`--i: ${Math.min(i, 3)}`}
        >
          <a
            href={study.href}
            data-spotlight
            class="work-card glass group flex h-full flex-col overflow-hidden rounded-[28px] p-2.5"
          >
            <div class="bg-ice relative aspect-[16/10] overflow-hidden rounded-[20px]">
              <img
                src={study.image}
                alt={study.imageAlt}
                class="size-full object-cover object-top transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.05]"
                loading="lazy"
              />
              <span class="glass-thin absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-medium text-ink-deep">
                {study.tag}
              </span>
            </div>
            <div class="flex grow flex-col px-3.5 pt-5 pb-4">
              <p class="font-mono text-[11px] tracking-[0.08em] text-slate-500 uppercase">
                {study.client}
              </p>
              <h3 class="mt-2 text-lg leading-snug">
                {study.title}
              </h3>
              <p class="text-brand mt-auto flex items-center gap-2 pt-5 text-sm font-medium">
                Read case study
                <svg
                  class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  </div>
</section>

<style>
  .work-card {
    transition:
      transform 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo);
  }

  .work-card:hover {
    transform: translateY(-5px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      0 0 0 1px rgb(20 118 235 / 0.1),
      0 36px 70px -34px rgb(10 40 90 / 0.5);
  }

  .rail-track {
    scrollbar-width: none;
  }

  .rail-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initRails() {
    document.querySelectorAll<HTMLElement>('[data-rail]').forEach(rail => {
      const track = rail.querySelector<HTMLElement>('[data-rail-track]');
      const prev = rail.querySelector<HTMLButtonElement>('[data-rail-prev]');
      const next = rail.querySelector<HTMLButtonElement>('[data-rail-next]');
      if (!track || !prev || !next) return;

      const step = () => {
        const card = track.querySelector<HTMLElement>('li');
        return card ? card.offsetWidth + 20 : track.clientWidth;
      };

      const update = () => {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled =
          track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };

      prev.addEventListener('click', () =>
        track.scrollBy({ left: -step(), behavior: 'smooth' })
      );
      next.addEventListener('click', () =>
        track.scrollBy({ left: step(), behavior: 'smooth' })
      );
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  }

  document.addEventListener('astro:page-load', initRails);
</script>
