---
import Button from '@ui/Button.astro';

// "About" from the Nexera design (text only): a paragraph whose words light
// up one by one as it scrolls in (BaseLayout drives [data-words]). The full
// text is in the HTML; only the brightness animates.
const text =
  'Webfluence is a performance marketing and software development company in Lahore, Pakistan. We run Google and Meta ad campaigns, create social media and video content, and build ERP, CRM, mobile and web applications for businesses across Pakistan and internationally. Every campaign is judged on the sales it brings, not on likes, and the same team can build the website, CRM or WhatsApp automation those leads land in.';
const words = text.split(' ');
---

<section class="wrap py-16 sm:py-24 lg:py-32" aria-labelledby="about-heading">
  <div class="mx-auto max-w-5xl text-center">
    <h2 id="about-heading" class="section-title" data-reveal>
      About <span class="text-accent">Webfluence</span>
    </h2>
    <p class="mt-8 text-xl leading-[1.7] sm:text-2xl sm:leading-[1.65]" data-words>
      {
        words.map((w, i) => (
          <>
            <span class="word">{w}</span>
            {i < words.length - 1 ? ' ' : ''}
          </>
        ))
      }
    </p>
    <div class="mt-10" data-reveal>
      <Button href="/about" variant="secondary">More about us</Button>
    </div>
  </div>
</section>

<style>
  .word {
    display: inline-block;
    opacity: 0.3;
    color: var(--color-muted);
    transition:
      opacity 0.2s ease-out,
      color 0.2s ease-out;
  }

  .word:global(.bright) {
    opacity: 1;
    color: var(--color-ink-deep);
  }

  /* Without JS (or before it runs) the text is fully readable. */
  :global(html:not(.js)) .word {
    opacity: 1;
    color: var(--color-ink-deep);
  }
</style>
