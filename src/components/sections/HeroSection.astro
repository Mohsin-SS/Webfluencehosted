---
import Button from '@ui/Button.astro';

const eyebrow = 'Performance marketing & software company in Lahore, Pakistan';
const headline = 'Your digital growth partner';
// Words typed after "for" in the headline. The first one is what shows
// without JavaScript or with reduced motion.
// Order follows the service priority in src/data/site.ts.
const typedWords = [
  'performance marketing',
  'social media content',
  'ERP systems',
  'custom CRMs',
  'mobile apps',
  'websites',
  'SEO',
];
const longestWord = typedWords.reduce((a, b) => (b.length > a.length ? b : a));

const subTitle =
  'Webfluence runs the marketing that grows your business and builds the software that runs it: performance marketing on Google and Meta, creative and social media content, ERP and CRM systems, mobile apps, websites and SEO from one team.';

const primaryCTA = { text: 'Book a consultation', href: '/contact' };
const secondaryCTA = { text: 'Our services', href: '/#services' };
---

<section class="hero-band overflow-hidden">
  {/* Text-only hero, centred. The rotating client screenshots that used to
      sit on the right were removed (2026-11-13). */}
  <div
    class="mx-auto w-full max-w-5xl px-6 pt-16 pb-16 text-center sm:px-10 lg:pt-24 lg:pb-24"
  >
    <h1>
      {/* Same type as the .eyebrow label, without its left rule (centred). */}
      <span
        class="text-ink mb-7 inline-block text-[0.6875rem] leading-[1.6] tracking-[0.14em]"
        >{eyebrow}</span
      >
      <span
        class="block text-[2.5rem] leading-[1.16] sm:text-5xl sm:leading-[1.14] lg:text-6xl xl:text-[4rem]"
      >
        {headline}
        <span class="sr-only"> for software and marketing</span>
        <span class="text-brand-bright grid" aria-hidden="true">
          {/* Invisible copy of the longest word holds the height, so the
              page below does not jump when a long word wraps on phones. */}
          <span class="invisible col-start-1 row-start-1"
            >for {longestWord}</span
          >
          <span class="col-start-1 row-start-1"
            >for <span data-typed data-words={JSON.stringify(typedWords)}
              >{typedWords[0]}</span
            ><span class="typed-caret"></span></span
          >
        </span>
      </span>
    </h1>

    <p class="text-ink mx-auto mt-7 max-w-2xl text-base leading-[2.1]">
      {subTitle}
    </p>

    <div
      class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4"
    >
      <Button href={primaryCTA.href} variant="primary"
        >{primaryCTA.text}</Button
      >
      <Button href={secondaryCTA.href} variant="tertiary"
        >{secondaryCTA.text}</Button
      >
    </div>
  </div>
</section>

<style>
  .typed-caret {
    display: inline-block;
    width: 3px;
    height: 0.9em;
    margin-left: 0.08em;
    vertical-align: -0.08em;
    background: currentColor;
    animation: caret 1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typed-caret {
      display: none;
    }
  }
</style>

<script>
  let timers: number[] = [];

  function startHero() {
    timers.forEach(t => window.clearTimeout(t));
    timers = [];

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (reduceMotion) return;

    const later = (fn: () => void, ms: number) => {
      timers.push(window.setTimeout(fn, ms));
    };

    // Typed word in the headline
    const typed = document.querySelector<HTMLElement>('[data-typed]');
    if (typed) {
      const words: string[] = JSON.parse(typed.dataset.words || '[]');
      let word = 0;
      let length = words[0]?.length ?? 0;
      let deleting = true;

      const tick = () => {
        const current = words[word];
        length += deleting ? -1 : 1;
        typed.textContent = current.slice(0, length);

        if (deleting && length === 0) {
          deleting = false;
          word = (word + 1) % words.length;
          later(tick, 350);
        } else if (!deleting && length === words[word].length) {
          deleting = true;
          later(tick, 2200);
        } else {
          later(tick, deleting ? 45 : 85);
        }
      };

      if (words.length > 1) later(tick, 2600);
    }
  }

  document.addEventListener('astro:page-load', startHero);
</script>
