---
import Button from '@ui/Button.astro';

// Hero from the Nexera design: centred, three lines of Bebas Neue with the
// middle line in the accent, and a highlighted pill phrase in the intro.
---

<section class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
  {/* Brand-colour gradients: three soft glows that drift slowly, a faint
      dot grid, and a fade into the page at the bottom. Blue and lagoon
      only (no purple). */}
  <div class="hero-bg" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
    <span class="blob blob-c"></span>
    <span class="hero-dots"></span>
    <span class="hero-fade"></span>
  </div>

  <div class="wrap relative py-16 text-center sm:py-24 lg:py-32">
    <h1 id="hero-title" class="hero-title">
      {/* {' '} keeps the h1 text "Performance Marketing & Software" for
          search engines; the lines are blocks, so it does not show. */}
      <span class="hero-line" style="--d: 0.05s">Performance</span>{' '}
      <span class="hero-line text-accent" style="--d: 0.15s">Marketing</span>{' '}
      <span class="hero-line" style="--d: 0.25s">&amp; Software</span>
    </h1>

    <p class="hero-in mx-auto mt-8 max-w-3xl text-lg leading-[1.7] text-slate-500 sm:text-xl" style="--d: 0.4s">
      A Lahore team driving sales for brands across Pakistan and abroad
      through Google and Meta ads, content and{' '}
      <span class="hero-pill">software that runs the business.</span>
    </p>

    <div class="hero-in mt-10 flex flex-wrap items-center justify-center gap-3" style="--d: 0.55s">
      <Button href="/contact">Book a consultation</Button>
      <Button href="/#work" variant="secondary">See our work</Button>
    </div>
  </div>
</section>

<style>
  .hero-title {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 0.85;
    letter-spacing: 0.01em;
    margin: 0;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 4.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: clamp(5.5rem, 8.5vw, 9rem);
    }
  }

  .hero-line {
    display: block;
    animation: hero-rise 1s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }

  .hero-in {
    animation: hero-in 0.9s ease-out both;
    animation-delay: var(--d, 0s);
  }

  /* The highlighted phrase from the design. */
  .hero-pill {
    display: inline-block;
    background-color: #2e2e2e;
    color: #fff;
    font-style: italic;
    padding: 0 0.35em;
    border-radius: 1rem;
  }

  /* --- gradients ---------------------------------------------------- */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(60px);
    opacity: var(--blob-opacity, 0.55);
    will-change: transform;
  }

  /* Signal blue, top left */
  .blob-a {
    width: min(46rem, 90vw);
    height: min(46rem, 90vw);
    left: -12%;
    top: -30%;
    background: radial-gradient(circle, #1476eb 0%, rgb(20 118 235 / 0) 68%);
    animation: drift-a 18s ease-in-out infinite alternate;
  }

  /* Lagoon, top right */
  .blob-b {
    width: min(42rem, 85vw);
    height: min(42rem, 85vw);
    right: -14%;
    top: -18%;
    background: radial-gradient(circle, #01a4ca 0%, rgb(1 164 202 / 0) 68%);
    animation: drift-b 22s ease-in-out infinite alternate;
  }

  /* Deep blue to sky, low centre behind the buttons */
  .blob-c {
    width: min(52rem, 110vw);
    height: min(30rem, 60vw);
    left: 50%;
    bottom: -22%;
    translate: -50% 0;
    background: radial-gradient(ellipse, #7cc4ff 0%, rgb(11 95 208 / 0.6) 35%, rgb(11 95 208 / 0) 70%);
    animation: drift-c 20s ease-in-out infinite alternate;
  }

  /* Light theme: softer glows so black text stays crisp. */
  :global(html:not(.dark)) .hero-bg {
    --blob-opacity: 0.42;
  }

  :global(html.dark) .hero-bg {
    --blob-opacity: 0.45;
  }

  /* Faint dot grid, strongest around the headline. */
  .hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(11 95 208 / 0.22) 1px, transparent 1.5px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 45%, #000 20%, transparent 75%);
  }

  :global(html.dark) .hero-dots {
    background-image: radial-gradient(rgb(255 255 255 / 0.12) 1px, transparent 1.5px);
  }

  /* Blend into the page at the bottom edge. */
  .hero-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--color-page));
  }

  @keyframes drift-a {
    to {
      transform: translate3d(8%, 12%, 0) scale(1.08);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate3d(-10%, 10%, 0) scale(1.12);
    }
  }

  @keyframes drift-c {
    to {
      transform: translate3d(0, -8%, 0) scale(1.1);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 40%, 0);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }
  }
</style>
