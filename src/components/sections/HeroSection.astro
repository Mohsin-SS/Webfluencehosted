---
import Button from '@ui/Button.astro';

// Hero: "the signal". A growth line draws itself across the hero, and glass
// tags appear along it with real outcomes from Webfluence case studies. The
// line is illustrative (no axes or values); every tag cites its client.

const eyebrow = 'Performance marketing & software company in Lahore, Pakistan';
const lines = [
  { text: 'Marketing that shows up ' }, // trailing space keeps the h1 text readable as one sentence
  { text: 'in your ', accent: 'sales.' },
];
const subTitle =
  'Webfluence runs performance marketing on Google and Meta, makes the content behind it, and builds the software your business runs on: ERP, CRM, apps and websites. One team in Lahore, judged on what it earns.';

const primaryCTA = { text: 'Book a consultation', href: '/contact' };
const secondaryCTA = { text: 'See client results', href: '/#work' };

// The line, in a 1200 x 440 box. Points rise with small dips, like a real
// campaign; Catmull-Rom smoothing turns them into one curve.
const W = 1200;
const H = 440;
const points: [number, number][] = [
  [0, 404], [90, 391], [170, 396], [260, 369], [340, 377], [430, 340],
  [520, 347], [610, 298], [700, 305], [790, 244], [880, 228], [960, 181],
  [1040, 134], [1120, 100], [1200, 64],
];

function smoothPath(pts: [number, number][]) {
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0]},${p2[1]}`;
  }
  return d;
}

const line = smoothPath(points);
const area = `${line} L${W},${H} L0,${H} Z`;

// Tags pinned to points on the line, in the order the line reaches them.
const tags = [
  {
    at: points[6],
    client: 'Times Consultant',
    text: 'Every WhatsApp inquiry logged in one CRM',
    delay: 1.5,
    hideOnPhone: true,
  },
  {
    at: points[9],
    client: 'Adoro (ECS)',
    text: 'Ad tracking rebuilt around real purchases',
    delay: 2.05,
    hideOnPhone: true,
  },
  {
    at: points[12],
    client: 'Adoro (ECS)',
    metric: '+57%',
    text: 'monthly sales',
    delay: 2.6,
  },
];
---

<section class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
  {/* Moving light, only in the hero */}
  <div class="hero-light" aria-hidden="true">
    <span class="hero-light-a"></span>
    <span class="hero-light-b"></span>
  </div>
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="wrap relative z-10 pt-16 sm:pt-20 lg:pt-24">
    <div class="shell">
      <h1 id="hero-title" class="max-w-4xl">
        <span class="eyebrow hero-in" style="--d: 0.05s">{eyebrow}</span>
        <span
          class="font-display mt-7 block text-[2.7rem] leading-[1.02] font-[650] tracking-[-0.045em] sm:text-6xl lg:text-[4.6rem] xl:text-[5.4rem]"
        >
          {
            lines.map((l, i) => (
              <span class="hero-line block overflow-hidden pb-[0.08em]">
                <span class="hero-rise block" style={`--d: ${0.15 + i * 0.12}s`}>
                  {l.text}
                  {l.accent && <span class="text-signal">{l.accent}</span>}
                </span>
              </span>
            ))
          }
        </span>
      </h1>

      <p
        class="hero-in text-ink mt-7 max-w-xl text-[17px] leading-8"
        style="--d: 0.45s"
      >
        {subTitle}
      </p>

      <div
        class="hero-in mt-9 flex flex-wrap items-center gap-3"
        style="--d: 0.6s"
      >
        <Button href={primaryCTA.href} variant="primary">{primaryCTA.text}</Button>
        <Button href={secondaryCTA.href} variant="secondary">{secondaryCTA.text}</Button>
      </div>
    </div>
  </div>

  {/* The signal line */}
  <div class="signal relative z-0 mt-24 sm:-mt-10 lg:-mt-52 xl:-mt-[17rem]" aria-hidden="true">
    <svg
      class="block h-auto w-full overflow-visible"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <linearGradient id="signal-stroke" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#1476eb" stop-opacity="0.25"></stop>
          <stop offset="0.45" stop-color="#1476eb"></stop>
          <stop offset="1" stop-color="#01a4ca"></stop>
        </linearGradient>
        <linearGradient id="signal-fill" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#2b8cff" stop-opacity="0.22"></stop>
          <stop offset="1" stop-color="#2b8cff" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="signal-area" d={area} fill="url(#signal-fill)"></path>
      <path
        class="signal-glow"
        d={line}
        pathLength="1"
        fill="none"
        stroke="url(#signal-stroke)"
        stroke-width="14"
        stroke-linecap="round"></path>
      <path
        class="signal-line"
        d={line}
        pathLength="1"
        fill="none"
        stroke="url(#signal-stroke)"
        stroke-width="3.5"
        stroke-linecap="round"></path>
      <path
        class="signal-pulse"
        d={line}
        pathLength="1"
        fill="none"
        stroke="#ffffff"
        stroke-width="3.5"
        stroke-linecap="round"></path>
      {
        tags.map(t => (
          <g class="signal-dot" style={`--d: ${t.delay}s`}>
            <circle cx={t.at[0]} cy={t.at[1]} r="16" fill="#2b8cff" opacity="0.18" class="signal-ring" />
            <circle cx={t.at[0]} cy={t.at[1]} r="6.5" fill="#fff" stroke="#1476eb" stroke-width="3" />
          </g>
        ))
      }
    </svg>

    {
      tags.map(t => (
        <div
          class={`signal-tag absolute ${t.hideOnPhone ? 'hidden sm:block' : ''}`}
          style={`left: ${(t.at[0] / W) * 100}%; top: ${(t.at[1] / H) * 100}%; --d: ${t.delay + 0.1}s`}
        >
          <div class="glass-thin rounded-2xl px-3.5 py-2.5 sm:px-4 sm:py-3">
            <p class="font-mono text-[10px] tracking-[0.08em] text-slate-500 uppercase sm:text-[11px]">
              {t.client}
            </p>
            {t.metric ? (
              <p class="mt-0.5 flex items-baseline gap-1.5 whitespace-nowrap">
                <span class="font-display text-leaf text-2xl font-bold tracking-tight sm:text-3xl">
                  {t.metric}
                </span>
                <span class="text-ink-deep text-sm font-medium">{t.text}</span>
              </p>
            ) : (
              <p class="text-ink-deep mt-0.5 max-w-[13rem] text-[13px] leading-snug font-medium sm:text-sm">
                {t.text}
              </p>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* --- entrance ------------------------------------------------------ */
  .hero-rise {
    animation: hero-rise 1.2s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }

  .hero-in {
    animation: hero-in 1.1s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes hero-rise {
    from {
      transform: translate3d(0, 105%, 0);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
      filter: blur(6px);
    }
  }

  /* --- atmosphere ---------------------------------------------------- */
  .hero-light {
    position: absolute;
    inset: -10% -10% 0;
    z-index: -2;
    pointer-events: none;
  }

  .hero-light span {
    position: absolute;
    border-radius: 9999px;
    will-change: transform;
  }

  .hero-light-a {
    width: 46rem;
    height: 46rem;
    right: -6rem;
    top: -12rem;
    background: radial-gradient(circle, rgb(1 164 202 / 0.28), transparent 65%);
    animation: drift-a 22s ease-in-out infinite alternate;
  }

  .hero-light-b {
    width: 40rem;
    height: 40rem;
    left: -10rem;
    bottom: -14rem;
    background: radial-gradient(circle, rgb(20 118 235 / 0.24), transparent 65%);
    animation: drift-b 26s ease-in-out infinite alternate;
  }

  @keyframes drift-a {
    to {
      transform: translate3d(-8rem, 6rem, 0) scale(1.08);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate3d(9rem, -5rem, 0) scale(1.1);
    }
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(20 118 235 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(20 118 235 / 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 70% at 70% 40%, #000, transparent 75%);
  }

  /* --- the signal line ----------------------------------------------- */
  .signal-line,
  .signal-glow {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.4s var(--ease-out-expo) 0.55s forwards;
  }

  .signal-glow {
    opacity: 0.18;
    filter: blur(6px);
  }

  .signal-area {
    opacity: 0;
    animation: fade 1.6s ease 1.6s forwards;
  }

  /* A short light that keeps travelling along the line. */
  .signal-pulse {
    stroke-dasharray: 0.05 0.95;
    stroke-dashoffset: 0.05;
    opacity: 0;
    animation:
      fade 0.6s ease 3s forwards,
      travel 5.5s linear 3s infinite;
  }

  .signal-dot {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 0.7s var(--ease-spring) var(--d) both;
  }

  .signal-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: ring 2.6s ease-out calc(var(--d) + 0.6s) infinite;
  }

  .signal-tag {
    transform: translate(-50%, calc(-100% - 18px));
    opacity: 0;
    animation: tag-in 0.9s var(--ease-spring) var(--d) both;
  }

  /* The last tag sits left of its point so it never runs off-screen. */
  .signal-tag:last-of-type {
    transform: translate(calc(-100% + 2.5rem), calc(-100% - 18px));
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @keyframes travel {
    to {
      stroke-dashoffset: -0.95;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes ring {
    from {
      transform: scale(0.6);
      opacity: 0.9;
    }
    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes tag-in {
    from {
      opacity: 0;
      margin-top: 14px;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      margin-top: 0;
      /* "none", not blur(0): any filter on an ancestor stops the glass
         inside from blurring what is behind it. */
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-pulse,
    .hero-light span,
    .signal-ring {
      animation: none;
    }
  }
</style>
