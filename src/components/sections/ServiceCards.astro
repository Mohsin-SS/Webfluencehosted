---
import Icon from '@ui/icons/Icon.astro';

// Services, in priority order (see src/data/site.ts). Text cards in the
// Nexera card style: icon, Bebas title and description; on hover the card
// fills with the brand blue.
const services = [
  {
    title: 'Performance marketing',
    text: 'Google Ads and Meta Ads run on real sales data, with tracking that counts purchases, not page views.',
    href: '/digital-marketing',
    icon: 'cursorRays',
  },
  {
    title: 'Creative & media content',
    text: 'Social media content, short video and brand design, made and posted for you so your feed stays consistent.',
    href: '/creative',
    icon: 'lightbulb',
  },
  {
    title: 'ERP, CRM & mobile apps',
    text: 'Custom ERP and CRM systems and cross-platform mobile apps, built around how your business runs.',
    href: '/erp',
    icon: 'dataBase',
  },
  {
    title: 'Web development',
    text: 'Fast websites, Shopify stores and web apps, built to rank and to convert the traffic your ads send.',
    href: '/web-development',
    icon: 'newWindow',
  },
  {
    title: 'WhatsApp chatbots',
    text: 'AI WhatsApp assistants that answer customers 24/7, take orders and log every chat in your CRM.',
    href: '/whatsapp-chatbot',
    icon: 'chatBubble',
  },
  {
    title: 'SEO',
    text: 'Technical fixes, on-page work and content, reported on the leads it brings rather than rankings alone.',
    href: '/seo',
    icon: 'documentMagnifyingGlass',
  },
];
---

<section id="services" class="wrap py-16 sm:py-24" aria-labelledby="services-heading">
  <div class="mb-12 text-center">
    <h2 id="services-heading" class="section-title" data-reveal>
      Services we <span class="text-accent">offer</span>
    </h2>
    <p class="section-description mx-auto mt-4 max-w-2xl" data-reveal style="--i: 1">
      Marketing that sells, and the systems behind it. One team runs all of it,
      so your ads, content, website and software work from the same numbers.
    </p>
  </div>

  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
    {
      services.map((s, i) => (
        <li data-reveal style={`--i: ${i % 3}`}>
          <a href={s.href} class="svc-card group">
            <span class="svc-icon">
              <Icon name={s.icon} class="size-7 text-white" />
            </span>
            <h3 class="svc-title">{s.title}</h3>
            <p class="svc-text">{s.text}</p>
            <span class="svc-more">
              Learn more
              <svg class="size-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .svc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 300px;
    padding: 2rem;
    border-radius: 1rem;
    background-color: var(--color-card);
    box-shadow: 0 10px 15px rgb(0 0 0 / 0.08);
    transition:
      background-color 0.4s ease,
      transform 0.3s ease,
      box-shadow 0.4s ease;
  }

  .svc-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background-color: var(--color-brand);
    transition: background-color 0.4s ease;
  }

  .svc-title {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink-deep);
    transition: color 0.4s ease;
  }

  .svc-text {
    margin-top: 0.75rem;
    line-height: 1.65;
    color: var(--color-ink);
    transition: color 0.4s ease;
  }

  .svc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    transition: color 0.4s ease;
  }

  /* Hover / keyboard focus: the card fills with the brand blue. */
  .svc-card:hover,
  .svc-card:focus-visible {
    /* Deeper than --color-brand so white text passes 4.5:1. */
    background-color: #0b5fd0;
    transform: translateY(-6px);
    box-shadow: 0 20px 30px -12px rgb(20 118 235 / 0.45);
  }

  .svc-card:hover .svc-icon,
  .svc-card:focus-visible .svc-icon {
    background-color: rgb(255 255 255 / 0.18);
  }

  .svc-card:hover :is(.svc-title, .svc-text, .svc-more),
  .svc-card:focus-visible :is(.svc-title, .svc-text, .svc-more) {
    color: #fff;
  }
</style>
