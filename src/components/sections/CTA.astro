---
import Button from '@ui/Button.astro';

interface Props {
  title?: string;
  subTitle?: string;
  cta?: { text: string; href: string };
}

const {
  title = "Let's talk about what's next",
  subTitle = 'Tell us what you want to build or grow, and our team will map out the software or marketing plan to get you there.',
  cta = { text: 'Book a consultation', href: '/contact' },
} = Astro.props;
---

<section class="pt-16 sm:pt-24">
  <div class="wrap pb-20 text-center sm:pb-28">
    <h2 class="text-3xl sm:text-[2.125rem] sm:leading-tight">{title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-[15px] leading-8">{subTitle}</p>
    <div class="mt-8 flex justify-center">
      <Button href={cta.href} variant="primary">{cta.text}</Button>
    </div>
  </div>

  {/* Closing band that sits on top of the footer */}
  <div class="flex h-20 sm:h-28" aria-hidden="true">
    <div class="relative w-[42%] bg-blue-50">
      <div
        class="stripes stripes-fade-x absolute inset-0 [--stripe-color:rgb(20_118_235/0.22)]"
      >
      </div>
    </div>
    <div class="from-sky to-brand grow bg-linear-to-r"></div>
  </div>
</section>
