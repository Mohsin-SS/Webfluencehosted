---
import Button from '@ui/Button.astro';
import { business, phoneE164 } from '@/data/business';

interface Props {
  title?: string;
  subTitle?: string;
  cta?: { text: string; href: string };
}

const {
  title = "Let's talk about what's next",
  subTitle = 'Tell us what you want to build or grow, and our team will map out the software or marketing plan to get you there.',
  cta = { text: 'Book a consultation', href: '/contact' },
} = Astro.props;
---

<section class="wrap overflow-x-clip pt-10 pb-20 sm:pt-16 sm:pb-28" aria-labelledby="cta-heading">
  <div class="cta-stage shell relative isolate">
    {/* Light that the glass panel blurs */}
    <div class="cta-light" aria-hidden="true">
      <span class="cta-light-a"></span>
      <span class="cta-light-b"></span>
    </div>

    <div
      data-reveal
      class="glass mx-auto max-w-5xl rounded-[36px] px-6 py-14 text-center sm:px-14 sm:py-20"
    >
      <p class="eyebrow justify-center">Start a project</p>
      <h2 id="cta-heading" class="mx-auto mt-5 max-w-3xl text-4xl leading-[1.05] text-balance sm:text-[3.4rem]">
        {title}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-[16px] leading-8">{subTitle}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href={cta.href} variant="primary">{cta.text}</Button>
        <Button href={`tel:${phoneE164}`} variant="secondary" arrow={false}>
          Call {business.phone}
        </Button>
      </div>
      <p class="mt-6 text-sm text-slate-500">
        Or email{' '}
        <a href={`mailto:${business.email}`} class="text-brand font-medium underline-offset-4 hover:underline">{business.email}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta-light {
    position: absolute;
    inset: -2rem 0;
    z-index: -1;
    pointer-events: none;
  }

  .cta-light span {
    position: absolute;
    border-radius: 9999px;
    filter: blur(2px);
  }

  .cta-light-a {
    width: 28rem;
    height: 28rem;
    left: 6%;
    top: 0;
    background: radial-gradient(circle, rgb(20 118 235 / 0.55), transparent 65%);
    animation: cta-a 14s ease-in-out infinite alternate;
  }

  .cta-light-b {
    width: 26rem;
    height: 26rem;
    right: 6%;
    bottom: -2rem;
    background: radial-gradient(circle, rgb(1 164 202 / 0.5), transparent 65%);
    animation: cta-b 16s ease-in-out infinite alternate;
  }

  @keyframes cta-a {
    to {
      transform: translate3d(5rem, 3rem, 0);
    }
  }

  @keyframes cta-b {
    to {
      transform: translate3d(-5rem, -2rem, 0);
    }
  }
</style>
