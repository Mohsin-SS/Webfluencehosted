---
import Button from '@ui/Button.astro';

// Content for the section title and subtitle
const title =
  'Transform your business today. <br /> Get started with <span class="font-medium text-blue-700">Web</span><span class="font-light text-slate-400">fluence</span>.';
const subTitle =
  "Partner with Webfluence and let our experts architect the perfect software or digital marketing solution to drive your business forward.";

// Call-to-action configuration for the primary button
const primaryCTA = { text: 'Book a Consultation', href: '/contact' };
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
>
  <div class="mx-auto mb-10 max-w-3xl text-center lg:mb-14">
    <h2 class="text-4xl text-balance text-slate-800 sm:text-5xl">
      <Fragment set:html={title} />
    </h2>
    <p class="text-lg\/8 mt-5 text-pretty text-slate-600">
      {subTitle}
    </p>
    <Button
      href={primaryCTA.href}
      variant="primary"
      className="mt-7 inline-flex border-none px-3.5!">{primaryCTA.text}</Button
    >
  </div>
</section>
