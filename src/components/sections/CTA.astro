---
import Button from '@ui/Button.astro';
import { business, phoneE164 } from '@/data/business';

// Call-to-action box from the Nexera design (dark card, Bebas title).
interface Props {
  title?: string;
  subTitle?: string;
  cta?: { text: string; href: string };
}

const {
  title = 'Ready to start your next project?',
  subTitle = 'Tell us what you want to build or grow, and our team will map out the software or marketing plan to get you there.',
  cta = { text: 'Book a consultation', href: '/contact' },
} = Astro.props;
---

<section class="wrap py-16" aria-labelledby="cta-heading">
  <div class="glass rounded-2xl px-6 py-16 text-center sm:px-12" data-reveal>
    <h2 id="cta-heading" class="section-title mx-auto max-w-4xl">{title}</h2>
    <p class="text-ink mx-auto mt-5 max-w-3xl text-lg">{subTitle}</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <Button href={cta.href}>{cta.text}</Button>
      <Button href={`tel:${phoneE164}`} variant="secondary" arrow={false}>
        Call {business.phone}
      </Button>
    </div>
  </div>
</section>
