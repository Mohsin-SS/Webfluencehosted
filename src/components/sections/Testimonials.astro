---
import { testimonials } from '@/data/testimonials';

const title = 'What our clients say';
---

<section class="wrap py-16 sm:py-24" aria-labelledby="testimonials-heading">
  <h2
    id="testimonials-heading"
    class="text-center text-3xl sm:text-[2.125rem] sm:leading-tight"
  >
    {title}
  </h2>

  <div
    class="relative mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-white"
    data-slider
  >
    {/* Wide, faint stripe field behind the quotes */}
    <div
      class="stripes absolute inset-0 [--stripe-color:rgb(20_118_235/0.07)] [--stripe-gap:26px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-r from-white via-white/85 to-white/30"
      aria-hidden="true"
    >
    </div>

    <ul
      class="slider-track relative flex snap-x snap-mandatory overflow-x-auto"
      tabindex="0"
      aria-label="Client testimonials"
      data-slider-track
    >
      {
        testimonials.map(t => (
          <li class="w-full shrink-0 snap-center">
            <figure class="grid items-center gap-x-14 gap-y-8 px-6 py-10 sm:px-12 sm:py-14 md:grid-cols-[minmax(0,1fr)_auto]">
              <div>
                <blockquote class="text-ink text-[15px] leading-8">
                  “{t.quote}”
                </blockquote>
                <figcaption class="mt-7">
                  <p class="text-ink text-2xl font-bold tracking-tight">
                    {t.name}
                  </p>
                  <p class="mt-1 text-sm">{t.role}</p>
                </figcaption>
              </div>
              {t.logo && (
                <div class="grid size-36 place-items-center justify-self-start rounded-2xl border border-slate-200 bg-white p-5 sm:size-44 md:justify-self-end">
                  <img
                    src={t.logo}
                    alt={t.company ?? ''}
                    class="max-h-full max-w-full object-contain"
                    loading="lazy"
                  />
                </div>
              )}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-7 flex justify-center gap-2" data-slider-dots>
    {
      testimonials.map((t, i) => (
        <button
          type="button"
          class="slider-dot bg-sky/50 h-2 w-4 rounded-full transition-all duration-300"
          aria-label={`Show testimonial from ${t.name}`}
          aria-current={i === 0 ? 'true' : undefined}
          data-index={i}
        />
      ))
    }
  </div>
</section>

<style>
  .slider-track {
    scrollbar-width: none;
  }

  .slider-track::-webkit-scrollbar {
    display: none;
  }

  .slider-dot[aria-current='true'] {
    width: 2rem;
    background-color: var(--color-brand-bright);
  }
</style>

<script>
  function initSliders() {
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach(slider => {
      const track = slider.querySelector<HTMLElement>('[data-slider-track]');
      const dots = [
        ...(slider.parentElement?.querySelectorAll<HTMLElement>(
          '[data-slider-dots] button'
        ) ?? []),
      ];
      if (!track || !dots.length) return;

      const setActive = (index: number) => {
        dots.forEach((dot, i) => {
          if (i === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
        });
      });

      let frame = 0;
      track.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            setActive(Math.round(track.scrollLeft / track.clientWidth));
          });
        },
        { passive: true }
      );
    });
  }

  document.addEventListener('astro:page-load', initSliders);
</script>
