---
import { testimonials } from '@/data/testimonials';

// Client testimonials from the Nexera design: star-rated cards in a two-column
// grid. While this section is on screen the page flips to a light theme
// ([data-flip-light], handled in BaseLayout).
const star =
  'M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 18.896l-7.416 3.817 1.48-8.279L.001 9.306l8.332-1.151L12 .587z';
---

<section
  class="wrap py-16 sm:py-24"
  aria-labelledby="testimonials-heading"
  data-flip-light
>
  <div class="mb-12 text-center">
    <h2 id="testimonials-heading" class="section-title" data-reveal>
      See why our clients <br /><span class="text-accent">trust</span> us
    </h2>
    <p class="section-description tm-desc mx-auto mt-4 max-w-2xl" data-reveal style="--i: 1">
      We get the details right, keep our promises and report on the numbers
      that matter. Here is what our clients say.
    </p>
  </div>

  <ul class="grid gap-6 md:grid-cols-2 lg:gap-8">
    {
      testimonials.map((t, i) => (
        <li
          data-reveal
          style={`--i: ${i % 2}`}
          class={`tm-card flex flex-col rounded-2xl p-6 sm:p-8 ${i === testimonials.length - 1 && testimonials.length % 2 ? 'md:col-span-2' : ''}`}
        >
          <figure class="flex h-full flex-col">
            <div class="mb-4 flex gap-0.5" aria-label={`${t.rating} out of 5 stars`} role="img">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="size-5 fill-current text-[#fbbf24]" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={star} />
                </svg>
              ))}
            </div>
            <blockquote class="tm-quote grow text-lg leading-[1.7]">“{t.quote}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-4">
              {t.logo ? (
                <span class="grid size-12 shrink-0 place-items-center overflow-hidden rounded-full bg-white p-1.5">
                  <img src={t.logo} alt="" class="max-h-full max-w-full object-contain" loading="lazy" />
                </span>
              ) : (
                <span class="bg-brand grid size-12 shrink-0 place-items-center rounded-full text-sm font-bold text-white">
                  {t.initials}
                </span>
              )}
              <span>
                <span class="tm-name block font-semibold">{t.name}</span>
                <span class="tm-role block text-sm">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .tm-card {
    background-color: var(--color-card);
    box-shadow: 0 10px 15px rgb(0 0 0 / 0.2);
    transition:
      background-color 0.5s ease-in-out,
      box-shadow 0.5s ease-in-out;
  }

  .tm-quote {
    color: var(--color-slate-700);
    transition: color 0.5s ease-in-out;
  }

  .tm-name {
    color: var(--color-ink-deep);
  }

  .tm-role,
  .tm-desc {
    color: var(--color-slate-500);
  }

  :global(html.flip-light) .tm-card {
    box-shadow: 0 4px 8px rgb(0 0 0 / 0.1);
  }
</style>
