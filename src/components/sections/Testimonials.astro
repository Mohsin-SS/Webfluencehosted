---
import { testimonials } from '@/data/testimonials';
---

<section
  id="testimonials"
  class="relative border-y border-slate-200/80 bg-slate-50/60 py-16 sm:py-24 overflow-hidden"
  aria-label="Client Testimonials"
>
  <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="mx-auto max-w-2xl text-center mb-12 sm:mb-16">
      <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">
        Client Stories
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Loved by industry leaders.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Don't just take our word for it — see how Webfluence helps ambitious teams streamline operations and scale.
      </p>
    </div>

    {/* Slider Container */}
    <div class="relative" data-testimonials-carousel>
      {/* Cards Viewport */}
      <div class="overflow-hidden" data-carousel-viewport>
        <div
          class="flex gap-6 transition-transform duration-500 ease-out"
          data-carousel-track
        >
          {
            testimonials.map((t) => (
              <div
                class="flex-shrink-0 w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-7 sm:p-8 shadow-sm hover:shadow-md transition-shadow"
                data-carousel-slide
              >
                <div>
                  {/* Rating Stars */}
                  <div class="flex items-center gap-1 text-amber-400 mb-5">
                    {Array.from({ length: t.rating }).map(() => (
                      <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>

                  {/* Quote */}
                  <blockquote class="text-slate-700 text-sm sm:text-base leading-relaxed italic">
                    “{t.quote}”
                  </blockquote>
                </div>

                {/* Client Info */}
                <div class="mt-6 pt-5 border-t border-slate-100 flex items-center gap-3.5">
                  <div class="h-11 w-11 flex-shrink-0 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center ring-4 ring-blue-50">
                    {t.initials}
                  </div>
                  <div>
                    <h3 class="text-sm font-semibold text-slate-900">{t.name}</h3>
                    <p class="text-xs text-slate-500 mt-0.5">{t.role}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {/* Controls: Prev/Next & Dots */}
      <div class="mt-10 flex items-center justify-between">
        <div class="flex items-center gap-2" data-carousel-dots>
          {/* Dots injected by script */}
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
            aria-label="Previous testimonials"
            data-carousel-prev
          >
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
          <button
            type="button"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:bg-slate-100 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
            aria-label="Next testimonials"
            data-carousel-next
          >
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initTestimonialsCarousel() {
    const container = document.querySelector('[data-testimonials-carousel]');
    if (!container) return;

    const track = container.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = container.querySelectorAll<HTMLElement>('[data-carousel-slide]');
    const prevBtn = container.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = container.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dotsContainer = container.querySelector<HTMLElement>('[data-carousel-dots]');

    if (!track || slides.length === 0 || !prevBtn || !nextBtn || !dotsContainer) return;

    let currentIndex = 0;

    function getVisibleCount() {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 768) return 2;
      return 1;
    }

    function getMaxIndex() {
      const visible = getVisibleCount();
      return Math.max(0, slides.length - visible);
    }

    function renderDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      const maxIndex = getMaxIndex();
      for (let i = 0; i <= maxIndex; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `h-2.5 rounded-full transition-all cursor-pointer ${
          i === currentIndex ? 'w-8 bg-blue-600' : 'w-2.5 bg-slate-300 hover:bg-slate-400'
        }`;
        dot.setAttribute('aria-label', `Go to testimonial slide ${i + 1}`);
        dot.addEventListener('click', () => {
          currentIndex = i;
          update();
        });
        dotsContainer.appendChild(dot);
      }
    }

    function update() {
      if (!track || !prevBtn || !nextBtn || !dotsContainer) return;
      const maxIndex = getMaxIndex();
      if (currentIndex > maxIndex) currentIndex = maxIndex;
      if (currentIndex < 0) currentIndex = 0;

      const firstSlide = slides[0];
      const gap = 24; // 1.5rem (gap-6)
      const slideWidth = firstSlide.offsetWidth;
      const offset = currentIndex * (slideWidth + gap);

      track.style.transform = `translateX(-${offset}px)`;

      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex >= maxIndex;

      const dots = dotsContainer.querySelectorAll('button');
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.className = 'h-2.5 w-8 rounded-full bg-blue-600 transition-all cursor-pointer';
        } else {
          dot.className = 'h-2.5 w-2.5 rounded-full bg-slate-300 hover:bg-slate-400 transition-all cursor-pointer';
        }
      });
    }

    prevBtn.addEventListener('click', () => {
      currentIndex--;
      update();
    });

    nextBtn.addEventListener('click', () => {
      currentIndex++;
      update();
    });

    window.addEventListener('resize', () => {
      renderDots();
      update();
    });

    renderDots();
    update();
  }

  // Run on initial load and after view transitions
  initTestimonialsCarousel();
  document.addEventListener('astro:after-swap', initTestimonialsCarousel);
</script>
