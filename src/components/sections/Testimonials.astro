---
import { testimonials } from '@/data/testimonials';

const title = 'What our clients say';
---

<section class="lit wrap py-16 sm:py-24 [--l1y:35%] [--l2x:10%] [--l2y:-10%]" aria-labelledby="testimonials-heading">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow" data-reveal>Client words</p>
        <h2
          id="testimonials-heading"
          data-reveal
          style="--i: 1"
          class="mt-5 text-4xl leading-[1.05] sm:text-5xl"
        >
          {title}
        </h2>
      </div>
      <div class="flex gap-2" data-reveal style="--i: 2" data-slider-dots>
        {
          testimonials.map((t, i) => (
            <button
              type="button"
              class="slider-dot h-2 w-4 rounded-full bg-slate-300 transition-all duration-500"
              aria-label={`Show testimonial from ${t.name}`}
              aria-current={i === 0 ? 'true' : undefined}
              data-index={i}
            />
          ))
        }
      </div>
    </div>

    <div
      class="glass relative mt-10 overflow-hidden rounded-[32px]"
      data-slider
      data-reveal
      style="--i: 2"
    >
      <span class="quote-mark" aria-hidden="true">“</span>
      <ul
        class="slider-track relative flex snap-x snap-mandatory overflow-x-auto"
        tabindex="0"
        aria-label="Client testimonials"
        data-slider-track
      >
        {
          testimonials.map(t => (
            <li class="w-full shrink-0 snap-center">
              <figure class="grid items-center gap-x-14 gap-y-8 px-7 py-10 sm:px-14 sm:py-16 md:grid-cols-[minmax(0,1fr)_auto]">
                <div>
                  <blockquote class="font-display text-ink-deep text-xl leading-[1.45] font-medium tracking-[-0.015em] sm:text-[1.65rem]">
                    {t.quote}
                  </blockquote>
                  <figcaption class="mt-8 flex items-center gap-4">
                    <span class="avatar" aria-hidden="true">{t.initials}</span>
                    <span>
                      <span class="text-ink-deep block text-base font-semibold">{t.name}</span>
                      <span class="block text-sm text-slate-500">{t.role}</span>
                    </span>
                  </figcaption>
                </div>
                {t.logo && (
                  <div class="grid size-32 place-items-center justify-self-start rounded-3xl bg-white/80 p-5 ring-1 ring-white sm:size-40 md:justify-self-end">
                    <img
                      src={t.logo}
                      alt={t.company ?? ''}
                      class="max-h-full max-w-full object-contain mix-blend-multiply"
                      loading="lazy"
                    />
                  </div>
                )}
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .slider-track {
    scrollbar-width: none;
  }

  .slider-track::-webkit-scrollbar {
    display: none;
  }

  .slider-dot[aria-current='true'] {
    width: 2.25rem;
    background: linear-gradient(90deg, var(--color-brand), var(--color-lagoon));
  }

  .quote-mark {
    position: absolute;
    top: -2.5rem;
    right: 2rem;
    font-family: var(--font-display);
    font-size: 16rem;
    line-height: 1;
    background: linear-gradient(160deg, rgb(20 118 235 / 0.16), rgb(1 164 202 / 0.04));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    pointer-events: none;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #fff;
    background: linear-gradient(140deg, var(--color-brand), var(--color-lagoon));
  }
</style>

<script>
  function initSliders() {
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach(slider => {
      const track = slider.querySelector<HTMLElement>('[data-slider-track]');
      const dots = [
        ...(slider.closest('section')?.querySelectorAll<HTMLElement>(
          '[data-slider-dots] button'
        ) ?? []),
      ];
      if (!track || !dots.length) return;

      const setActive = (index: number) => {
        dots.forEach((dot, i) => {
          if (i === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
        });
      });

      let frame = 0;
      track.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            setActive(Math.round(track.scrollLeft / track.clientWidth));
          });
        },
        { passive: true }
      );
    });
  }

  document.addEventListener('astro:page-load', initSliders);
</script>
