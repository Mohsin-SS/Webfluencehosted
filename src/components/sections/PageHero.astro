---
import Button from '@ui/Button.astro';
import Icon from '@ui/icons/Icon.astro';

interface Props {
  /** Small tracked label above the title. */
  eyebrow?: string;
  title: string;
  lead: string;
  cta?: { text: string; href: string };
  /** Icon shown on the summary card. */
  icon?: string;
  /** Heading and short list shown on the summary card. */
  summaryTitle?: string;
  points?: string[];
}

const {
  eyebrow,
  title,
  lead,
  cta,
  icon = 'cog',
  summaryTitle = 'What is included',
  points = [],
} = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="page-glow" aria-hidden="true"></div>
  <div class="wrap relative py-16 text-center sm:py-24 lg:py-28">
    {eyebrow && <p class="eyebrow eyebrow-center" data-reveal>{eyebrow}</p>}
    <h1 class="page-title mx-auto mt-6 max-w-5xl" data-reveal style="--i: 1">{title}</h1>
    <p class="mx-auto mt-7 max-w-3xl text-lg leading-[1.7] text-slate-500 sm:text-xl" data-reveal style="--i: 2">
      {lead}
    </p>
    {
      cta && (
        <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal style="--i: 3">
          <Button href={cta.href}>{cta.text}</Button>
          <Button href="#faq-heading" variant="secondary">Read the FAQ</Button>
        </div>
      )
    }
    {
      points.length > 0 && (
        <div class="mt-12" data-reveal style="--i: 4">
          <p class="text-xs font-semibold tracking-[0.1em] text-slate-500 uppercase">{summaryTitle}</p>
          <ul class="mt-4 flex flex-wrap justify-center gap-3">
            {points.map(point => (
              <li class="text-ink-deep flex items-center gap-2.5 rounded-full border border-card-2 bg-card px-5 py-2.5 font-medium">
                <Icon name={icon} class="text-accent size-5" />
                {point}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .page-title {
    font-size: 3rem;
    line-height: 0.9;
  }

  @media (min-width: 640px) {
    .page-title {
      font-size: 4.5rem;
    }
  }

  @media (min-width: 1024px) {
    .page-title {
      font-size: clamp(5rem, 7vw, 7.5rem);
    }
  }

  .page-glow {
    position: absolute;
    left: 50%;
    top: 10%;
    width: min(56rem, 120vw);
    height: 24rem;
    translate: -50% 0;
    background: radial-gradient(closest-side, rgb(20 118 235 / 0.2), transparent);
    pointer-events: none;
  }
</style>
