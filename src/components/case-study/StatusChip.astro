---
interface Props {
  status?: 'live' | 'in-progress' | 'planned' | 'done';
  label?: string;
}

const { status = 'in-progress', label } = Astro.props;

const map: Record<string, { text: string; cls: string }> = {
  live:        { text: label ?? 'Live',        cls: 'chip-live' },
  done:        { text: label ?? 'Done',        cls: 'chip-done' },
  'in-progress':{ text: label ?? 'In progress', cls: 'chip-progress' },
  planned:     { text: label ?? 'Planned',     cls: 'chip-planned' },
};

const { text, cls } = map[status] ?? map['in-progress'];
---
<span class={`cs-chip ${cls}`}>{text}</span>

<style>
.cs-chip{display:inline-flex;align-items:center;border-radius:999px;padding:.15rem .6rem;font-size:.72rem;font-weight:600;gap:.3rem}
.chip-live{color:#0b6a50;background:#e6f5ef;border:1px solid #b7e0cd}
.chip-done{color:#0b6a50;background:#e6f5ef;border:1px solid #b7e0cd}
.chip-progress{color:#7c4a00;background:#fff3dc;border:1px solid #f2d39b}
.chip-planned{color:#374151;background:#f3f4f6;border:1px solid #d1d5db}
.chip-live::before,.chip-done::before{content:'';width:.45rem;height:.45rem;border-radius:50%;background:currentColor;display:inline-block}
.chip-progress::before{content:'';width:.45rem;height:.45rem;border-radius:50%;background:currentColor;display:inline-block;opacity:.7}
</style>
