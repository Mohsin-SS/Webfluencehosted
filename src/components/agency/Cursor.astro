---
// Custom cursor: an accent dot that grows into a bubble over links,
// and into a "View" bubble over [data-cursor="view"] elements.
---

<div class="cursor" data-cursor-root aria-hidden="true">
  <div class="cursor-ball">
    <svg class="cursor-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span class="cursor-label">View</span>
  </div>
</div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .cursor.is-visible {
    opacity: 1;
  }

  .cursor-ball {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: var(--color-wf-accent);
    color: #fff;
    transition:
      width 0.35s var(--ease-out-expo),
      height 0.35s var(--ease-out-expo),
      margin 0.35s var(--ease-out-expo),
      background-color 0.25s;
  }

  .cursor-arrow,
  .cursor-label {
    grid-area: 1 / 1;
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.2s,
      transform 0.35s var(--ease-out-expo);
  }

  .cursor-arrow {
    width: 20px;
    height: 20px;
  }

  .cursor-label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .cursor[data-state='link'] .cursor-ball {
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    background: var(--color-wf-accent);
  }

  .cursor[data-state='view'] .cursor-ball {
    width: 96px;
    height: 96px;
    margin: -48px 0 0 -48px;
    background: var(--color-wf-accent);
  }

  .cursor[data-state='link'] .cursor-arrow,
  .cursor[data-state='view'] .cursor-label {
    opacity: 1;
    transform: scale(1);
  }

  .cursor[data-state='hidden'] .cursor-ball {
    width: 0;
    height: 0;
    margin: 0;
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '@/scripts/agency/motion';

  const root = document.querySelector<HTMLElement>('[data-cursor-root]');
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  if (root && finePointer && !prefersReducedMotion) {
    document.documentElement.classList.add('has-custom-cursor');

    const moveX = gsap.quickTo(root, 'x', { duration: 0.18, ease: 'power3.out' });
    const moveY = gsap.quickTo(root, 'y', { duration: 0.18, ease: 'power3.out' });

    window.addEventListener('pointermove', event => {
      if (event.pointerType !== 'mouse') return;
      moveX(event.clientX);
      moveY(event.clientY);
      root.classList.add('is-visible');
    });

    document.documentElement.addEventListener('pointerleave', () => {
      root.classList.remove('is-visible');
    });

    document.addEventListener('pointerover', event => {
      const target = event.target as Element;
      if (target.closest('input, textarea, [data-cursor="none"]')) {
        root.dataset.state = 'hidden';
      } else if (target.closest('[data-cursor="view"]')) {
        root.dataset.state = 'view';
      } else if (target.closest('a, button, label, select, summary')) {
        root.dataset.state = 'link';
      } else {
        delete root.dataset.state;
      }
    });
  }
</script>
