---
import { contact } from '@/data/agency';
---

<a
  class="chat-launcher"
  href={contact.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Webfluence on WhatsApp"
>
  <span class="chat-bubble">Hi! Let's Chat 😀</span>
  <span class="chat-avatar" aria-hidden="true">
    <img src="/logos/WFLogo.png" alt="" width="56" height="56" />
    <span class="chat-dot"></span>
  </span>
</a>

<style>
  .chat-launcher {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chat-launcher {
      animation: chat-in 0.8s var(--ease-out-expo) 1.5s both;
    }
  }

  @keyframes chat-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  .chat-bubble {
    padding: 0.7rem 1rem;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 8px 24px rgb(11 11 15 / 0.12),
      0 0 0 1px rgb(11 11 15 / 0.06);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .chat-avatar {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 8px 24px rgb(11 11 15 / 0.18);
    transition: transform 0.4s var(--ease-out-expo);
  }

  /* Crop the logo PNG to its "WF." monogram. */
  .chat-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    transform: scale(1.45);
    clip-path: circle(34% at 50% 52%);
  }

  .chat-dot {
    position: absolute;
    right: 0;
    bottom: 0.1rem;
    width: 0.85rem;
    height: 0.85rem;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #2bd86b;
  }

  .chat-launcher:hover .chat-avatar {
    transform: scale(1.08);
  }
</style>
