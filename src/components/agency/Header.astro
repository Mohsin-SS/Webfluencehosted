---
import Icon from '@ui/icons/Icon.astro';
import { navLinks, serviceMenu, caseStudyMenu } from '@/data/agency';

const [linksBefore, linksAfter] = [navLinks.slice(0, 2), navLinks.slice(2)];
---

<header class="site-header" data-header>
  <div class="wf-container header-inner">
    <a href="/" class="header-logo" aria-label="Webfluence home">
      <img src="/logos/WFLogo.png" alt="" width="44" height="44" />
      <span>Webfluence</span>
    </a>

    <nav class="header-nav" aria-label="Primary">
      {
        linksBefore.map(link => (
          <a href={link.href} class="nav-link">
            {link.label}
          </a>
        ))
      }

      <div class="nav-dropdown" data-dropdown>
        <button
          type="button"
          class="nav-link"
          aria-expanded="false"
          aria-controls="services-menu"
          data-dropdown-toggle
        >
          Services
          <svg class="nav-chevron" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
        </button>

        <div class="mega" id="services-menu">
          <div class="mega-panel">
            {
              serviceMenu.map(group => (
                <div class="mega-col">
                  <p class="mega-title">{group.title}</p>
                  <ul>
                    {group.links.map(link => (
                      <li>
                        <a href={link.href} class="mega-link">
                          <span class="mega-icon">
                            <Icon name={link.icon} class="size-5" aria-hidden="true" />
                          </span>
                          <span class="roll" data-text={link.label}>
                            <span>{link.label}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
            <a href="/products" class="mega-feature">
              <span class="mega-feature-kicker">Our products</span>
              <span class="mega-feature-title">Education CRM &amp; Construction Estimator AI</span>
              <span class="mega-all">
                Explore products
                <span class="mega-all-line"></span>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="nav-dropdown nav-dropdown--case" data-dropdown>
        <button
          type="button"
          class="nav-link"
          aria-expanded="false"
          aria-controls="case-studies-menu"
          data-dropdown-toggle
        >
          Case Studies
          <svg class="nav-chevron" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
        </button>

        <div class="mega mega--sm" id="case-studies-menu">
          <div class="case-panel">
            <p class="mega-title">Case Studies</p>
            <ul>
              {
                caseStudyMenu.map(cs => (
                  <li>
                    <a href={cs.href} class="mega-link">
                      <span class="mega-icon">
                        <Icon name={cs.icon} class="size-5" aria-hidden="true" />
                      </span>
                      <span class="roll" data-text={cs.title}>
                        <span>{cs.title}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      {
        linksAfter.map(link => (
          <a href={link.href} class="nav-link">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a href="#contact" class="lets-work">
        <span class="lets-work-dot" aria-hidden="true"></span>
        <span class="roll" data-text="Let's Work"><span>Let's Work</span></span>
      </a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <div class="wf-container mobile-menu-inner">
      {
        linksBefore.map(link => (
          <a href={link.href} class="mobile-link">
            {link.label}
          </a>
        ))
      }
      <details class="mobile-services">
        <summary class="mobile-link">Services</summary>
        <ul>
          {
            serviceMenu.flatMap(group => group.links).map(link => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </details>
      <details class="mobile-services">
        <summary class="mobile-link">Case Studies</summary>
        <ul>
          {
            caseStudyMenu.map(cs => (
              <li>
                <a href={cs.href}>{cs.title}</a>
              </li>
            ))
          }
        </ul>
      </details>
      {
        linksAfter.map(link => (
          <a href={link.href} class="mobile-link">
            {link.label}
          </a>
        ))
      }
      <a href="#contact" class="mobile-cta">Let's Work →</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: transform 0.5s var(--ease-out-expo);
  }

  /* The frosted background lives on a pseudo-element: backdrop-filter on the header itself
     would make it the containing block for the fixed mobile menu. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: var(--header-h);
    background: rgb(255 255 255 / 0.86);
    box-shadow: 0 1px 0 rgb(11 11 15 / 0.06);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  @media (min-width: 992px) {
    /* Equal side columns keep the nav optically centred between logo and CTA. */
    .header-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .header-actions {
      justify-self: end;
    }
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .header-logo img {
    width: 2.75rem;
    height: 2.75rem;
    mix-blend-mode: multiply;
  }

  .header-nav {
    display: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0;
    font-size: 1.1rem;
    font-weight: 400;
    transition: color 0.25s;
  }

  .nav-link:hover,
  .nav-dropdown[data-open] > .nav-link {
    color: var(--color-wf-accent);
  }

  .nav-chevron {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.3s;
  }

  .mega {
    position: absolute;
    top: 100%;
    left: 50%;
    width: min(72rem, calc(100vw - 2 * var(--gutter)));
    padding-top: 0.25rem;
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, 0.75rem);
    transition:
      opacity 0.25s,
      transform 0.45s var(--ease-out-expo),
      visibility 0s 0.25s;
  }

  .nav-dropdown--case {
    position: relative;
  }

  .nav-dropdown--case .mega--sm {
    position: absolute;
    top: 100%;
    left: 50%;
    width: min(20rem, calc(100vw - 2 * var(--gutter)));
  }

  .case-panel {
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow:
      0 30px 80px -20px rgb(11 11 15 / 0.25),
      0 0 0 1px rgb(11 11 15 / 0.06);
  }

  .case-panel ul {
    display: grid;
    gap: 0.35rem;
  }

  .nav-dropdown[data-open] .mega {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
    transition:
      opacity 0.25s,
      transform 0.45s var(--ease-out-expo);
  }

  .nav-dropdown[data-open] .nav-chevron {
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .nav-dropdown:hover .mega {
      visibility: visible;
      opacity: 1;
      transform: translate(-50%, 0);
      transition:
        opacity 0.25s,
        transform 0.45s var(--ease-out-expo);
    }

    .nav-dropdown:hover .nav-chevron {
      transform: rotate(180deg);
    }
  }

  /* The panel hangs below the header, so it must close when the header slides away. */
  .site-header.is-hidden .nav-dropdown .mega {
    visibility: hidden;
    opacity: 0;
  }

  .mega-panel {
    display: grid;
    grid-template-columns: repeat(4, 1fr) 1.2fr;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow:
      0 30px 80px -20px rgb(11 11 15 / 0.25),
      0 0 0 1px rgb(11 11 15 / 0.06);
  }

  .mega-title {
    margin-bottom: 1rem;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .mega-col ul {
    display: grid;
    gap: 0.35rem;
  }

  .mega-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 0;
    font-weight: 500;
    color: #2b2b35;
  }

  .mega-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
    background: var(--color-wf-soft);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .mega-link:hover .mega-icon {
    background: var(--color-wf-accent);
    color: #fff;
  }

  /* Text roll: a copy of the label slides up from below on hover. */
  .roll {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 1.3;
  }

  .roll > span,
  .roll::after {
    display: block;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .roll::after {
    content: attr(data-text);
    position: absolute;
    top: 100%;
    left: 0;
    color: var(--color-wf-accent);
  }

  .mega-link:hover .roll > span,
  .mega-link:hover .roll::after,
  .lets-work:hover .roll > span,
  .lets-work:hover .roll::after {
    transform: translateY(-100%);
  }

  .mega-feature {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--color-wf-ink);
    color: #fff;
  }

  .mega-feature-kicker {
    font-size: 0.85rem;
    color: var(--color-wf-lime);
  }

  .mega-feature-title {
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .mega-all {
    display: inline-flex;
    flex-direction: column;
    align-self: flex-start;
    gap: 0.3rem;
    margin-top: auto;
    font-weight: 600;
  }

  .mega-all-line {
    height: 2px;
    background: var(--color-wf-lime);
    transition: height 0.4s var(--ease-out-expo);
  }

  .mega-feature:hover .mega-all-line {
    height: 5px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lets-work {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .lets-work-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-wf-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lets-work-dot {
      animation: pulse 2s infinite;
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(47 91 255 / 0.55);
    }
    70% {
      box-shadow: 0 0 0 8px rgb(47 91 255 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(47 91 255 / 0);
    }
  }

  /* On small phones the CTA lives in the mobile menu instead. */
  @media (max-width: 479px) {
    .lets-work {
      display: none;
    }
  }

  .menu-toggle {
    display: grid;
    place-content: center;
    gap: 6px;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-wf-soft);
  }

  .menu-toggle span {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    overflow-y: auto;
    background: #fff;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 0.6s var(--ease-out-expo),
      visibility 0s 0.6s;
  }

  .mobile-menu.is-open {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.6s var(--ease-out-expo);
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1.5rem 3rem;
  }

  .mobile-link {
    display: block;
    padding: 0.5rem 0;
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    list-style: none;
  }

  .mobile-link::-webkit-details-marker {
    display: none;
  }

  .mobile-services ul {
    display: grid;
    gap: 0.6rem;
    padding: 0.25rem 0 1rem 0.25rem;
    font-size: 1.15rem;
    color: var(--color-wf-muted);
  }

  .mobile-cta {
    align-self: flex-start;
    margin-top: 1.5rem;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    background: var(--color-wf-accent);
    color: #fff;
    font-size: 1.15rem;
    font-weight: 600;
  }

  @media (min-width: 992px) {
    .header-nav {
      display: flex;
      align-items: center;
      gap: clamp(1.5rem, 2.6vw, 2.75rem);
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  import { lockScroll } from '@/scripts/agency/smooth-scroll';

  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const dropdowns = header.querySelectorAll<HTMLElement>('[data-dropdown]');
  const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const mobileMenu = header.querySelector<HTMLElement>('[data-mobile-menu]')!;

  let menuOpen = false;
  let lastY = window.scrollY;

  function onScroll() {
    const y = window.scrollY;
    header.classList.toggle('is-scrolled', y > 8 || menuOpen);
    const anyDropdownOpen = Array.from(dropdowns).some(d => d.hasAttribute('data-open'));
    const hide = y > lastY && y > 160 && !menuOpen && !anyDropdownOpen;
    header.classList.toggle('is-hidden', hide);
    lastY = y;
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  dropdowns.forEach(dd => {
    const toggle = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!toggle) return;
    toggle.addEventListener('click', e => {
      e.stopPropagation();
      const isOpen = dd.hasAttribute('data-open');
      dropdowns.forEach(other => {
        other.removeAttribute('data-open');
        other.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        dd.setAttribute('data-open', '');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', event => {
    dropdowns.forEach(dd => {
      if (!dd.contains(event.target as Node)) {
        dd.removeAttribute('data-open');
        dd.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  function setMenu(open: boolean) {
    menuOpen = open;
    mobileMenu.classList.toggle('is-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    header.classList.toggle('is-scrolled', open || window.scrollY > 8);
    lockScroll(open);
  }

  menuToggle.addEventListener('click', () => setMenu(!menuOpen));

  mobileMenu.addEventListener('click', event => {
    if ((event.target as Element).closest('a')) setMenu(false);
  });

  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    dropdowns.forEach(dd => {
      if (dd.hasAttribute('data-open')) {
        dd.removeAttribute('data-open');
        dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]')?.focus();
      }
    });
    if (menuOpen) {
      setMenu(false);
      menuToggle.focus();
    }
  });

  window.matchMedia('(min-width: 992px)').addEventListener('change', event => {
    if (event.matches && menuOpen) setMenu(false);
  });
</script>
