---
import { work } from '@/data/agency';

const barHeights = [38, 62, 48, 80, 66, 92, 74];
---

<section class="section work" id="work">
  <div class="wf-container">
    <div class="work-head">
      <h2 class="display-2" data-skew-up>Selected Work</h2>
      <a href="/products" class="work-all">All products <span aria-hidden="true">↗</span></a>
    </div>

    <div class="work-grid">
      {
        work.map(item => (
          <a
            href={item.href}
            class="work-card"
            data-size={item.size}
            data-tone={item.art === 'cta' ? 'dark' : 'light'}
            data-cursor={item.art === 'cta' ? undefined : 'view'}
            data-work-card
          >
            <div class="work-media">
              {item.image && <img class="work-img" src={item.image} alt="" loading="lazy" />}

              {item.art === 'blueprint' && (
                <div class="art art--blueprint" aria-hidden="true">
                  <svg class="art-building" viewBox="0 0 240 200" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M120 20 200 60 120 100 40 60Z" fill="rgb(255 255 255 / 0.12)" />
                    <path d="M40 60v80l80 40v-80ZM200 60v80l-80 40" />
                    <path d="M40 80l80 40 80-40M40 100l80 40 80-40M40 120l80 40 80-40" opacity="0.5" />
                    <path d="M60 70v80M80 80v80M100 90v80M140 90v80M160 80v80M180 70v80" opacity="0.35" />
                    <path d="M28 66v80M22 66h12M22 146h12" stroke-dasharray="3 4" opacity="0.8" />
                  </svg>
                  <ul class="art-checklist">
                    <li>Material takeoff</li>
                    <li>Labour &amp; overheads</li>
                    <li>Estimate ready</li>
                  </ul>
                </div>
              )}

              {item.art === 'chat' && (
                <div class="art art--chat" aria-hidden="true">
                  <div class="chat">
                    <p class="bubble bubble--bot">Hi 👋 How can I help you today?</p>
                    <p class="bubble bubble--user">Where's my order?</p>
                    <p class="bubble bubble--bot">Order #2381 is out for delivery 🚚</p>
                    <p class="bubble bubble--typing">
                      <span />
                      <span />
                      <span />
                    </p>
                  </div>
                </div>
              )}

              {item.art === 'bars' && (
                <div class="art art--bars" aria-hidden="true">
                  <div class="bars">
                    {barHeights.map(height => (
                      <span style={`--h: ${height}%`} />
                    ))}
                  </div>
                </div>
              )}

              {item.art === 'cta' && (
                <div class="art art--cta" aria-hidden="true">
                  <span class="cta-arrow">↗</span>
                </div>
              )}

              {item.video && <video class="work-video" muted loop playsinline preload="none" data-src={item.video} />}
              {item.cover ? (
                <img class="work-overlay work-overlay--image" src={item.cover} alt="" loading="lazy" />
              ) : (
                <>
                  <span class="work-overlay work-overlay--mono" aria-hidden="true" />
                  <span class="work-overlay work-overlay--tint" aria-hidden="true" />
                </>
              )}
            </div>

            <div class="work-content">
              <ul class="work-chips">
                {item.tags.map(tag => (
                  <li>{tag}</li>
                ))}
              </ul>
              <h3 class="work-title">{item.title}</h3>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .work-all {
    padding: 0.75rem 1.4rem;
    border: 1px solid rgb(11 11 15 / 0.15);
    border-radius: 999px;
    font-weight: 600;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .work-all:hover {
    background: var(--color-wf-ink);
    color: #fff;
  }

  .work-grid {
    display: grid;
    gap: clamp(1rem, 1.8vw, 1.5rem);
  }

  .work-card {
    position: relative;
    display: block;
    height: clamp(24rem, 110vw, 30rem);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-wf-ink);
    color: #fff;
    isolation: isolate;
  }

  .work-card[data-tone='dark'] {
    color: var(--color-wf-ink);
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(12, 1fr);
    }

    .work-card {
      height: clamp(24rem, 36vw, 36rem);
    }

    .work-card[data-size='lg'] {
      grid-column: span 7;
    }

    .work-card[data-size='sm'] {
      grid-column: span 5;
    }

    .work-card[data-size='full'] {
      grid-column: 1 / -1;
      height: clamp(26rem, 44vw, 44rem);
    }
  }

  .work-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: transform 0.9s var(--ease-out-expo);
  }

  .work-card:hover .work-media {
    transform: scale(1.04);
  }

  .work-img,
  .work-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .work-video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .work-card.is-playing .work-video {
    opacity: 1;
  }

  /* Cover image (or, without one, a desaturated tinted veil) over the visual. On hover it
     closes to a circle that shrinks away from the centre, revealing the full-colour card
     (75% radius covers every corner).
     Greyscale comes from a saturation blend rather than backdrop-filter, which Chrome clips
     to the circle's bounding box instead of the circle. */
  .work-overlay {
    position: absolute;
    inset: 0;
    clip-path: circle(75% at 50% 50%);
    transition: clip-path 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .work-overlay--image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .work-overlay--mono {
    background: #808080;
    mix-blend-mode: saturation;
  }

  .work-overlay--tint {
    background: rgb(11 11 15 / 0.5);
  }

  .work-card[data-tone='dark'] .work-overlay--tint {
    background: rgb(255 255 255 / 0.35);
  }

  .work-card:is(:hover, :focus-visible, .is-active) .work-overlay {
    clip-path: circle(0% at 50% 50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-overlay {
      transition: none;
    }
  }

  /* Scrims keep the chips and title readable over busy imagery. */
  .work-card[data-tone='light']::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(11 11 15 / 0.35), transparent 30%),
      linear-gradient(to top, rgb(11 11 15 / 0.85), rgb(11 11 15 / 0.35) 45%, transparent 70%);
    pointer-events: none;
  }

  .work-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .work-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .work-chips li {
    padding: 0.45rem 1rem;
    box-shadow: 0 4px 14px rgb(11 11 15 / 0.15);
    border-radius: 999px;
    background: #fff;
    color: var(--color-wf-ink);
    font-size: 0.9rem;
    font-weight: 500;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .work-chips li:nth-child(2) {
    background: var(--color-wf-accent);
    color: #fff;
  }

  .work-chips li:nth-child(3) {
    background: var(--color-wf-lime);
  }

  .work-card[data-tone='dark'] .work-chips li {
    background: var(--color-wf-ink);
    color: #fff;
  }

  .work-card:hover .work-chips li {
    transform: translateY(-3px);
  }

  .work-card:hover .work-chips li:nth-child(2) {
    transition-delay: 0.04s;
  }

  .work-card:hover .work-chips li:nth-child(3) {
    transition-delay: 0.08s;
  }

  .work-title {
    max-width: 22ch;
    font-size: clamp(1.75rem, 3.2vw, 3.25rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  /* Illustrated panels for projects without imagery. */
  .art {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .art--blueprint {
    background:
      linear-gradient(rgb(255 255 255 / 0.1) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgb(255 255 255 / 0.1) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--color-wf-accent);
    color: #fff;
  }

  .art-building {
    position: absolute;
    top: 50%;
    right: 6%;
    width: min(46%, 22rem);
    transform: translateY(-58%);
  }

  .art-checklist {
    position: absolute;
    top: 50%;
    left: clamp(1.25rem, 2.5vw, 2.25rem);
    display: grid;
    gap: 0.5rem;
    transform: translateY(-60%);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .art-checklist li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem 0.5rem 0.6rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.14);
    backdrop-filter: blur(6px);
  }

  .art-checklist li::before {
    content: '✓';
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: var(--color-wf-lime);
    color: var(--color-wf-ink);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Padding keeps the conversation clear of the chips above and the title below. */
  .art--chat {
    display: grid;
    place-items: center;
    padding: 5rem 1.25rem 7.5rem;
    background: radial-gradient(circle at 30% 20%, #1f6b4f, #0b2e22 70%);
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: min(100%, 20rem);
  }

  .bubble {
    max-width: 85%;
    padding: 0.7rem 0.95rem;
    border-radius: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .bubble--bot {
    align-self: flex-start;
    border-bottom-left-radius: 0.3rem;
    background: #fff;
    color: var(--color-wf-ink);
  }

  .bubble--user {
    align-self: flex-end;
    border-bottom-right-radius: 0.3rem;
    background: #25d366;
    color: #06281b;
  }

  .bubble--typing {
    display: flex;
    gap: 0.3rem;
    align-self: flex-start;
    background: rgb(255 255 255 / 0.18);
  }

  .bubble--typing span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bubble--typing span {
      animation: typing 1.2s infinite;
    }

    .bubble--typing span:nth-child(2) {
      animation-delay: 0.15s;
    }

    .bubble--typing span:nth-child(3) {
      animation-delay: 0.3s;
    }
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  .art--bars {
    background: radial-gradient(circle at 80% 0%, #25263a, var(--color-wf-ink) 65%);
  }

  .bars {
    position: absolute;
    right: clamp(1.25rem, 2.5vw, 2.25rem);
    bottom: 32%;
    left: clamp(1.25rem, 2.5vw, 2.25rem);
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    height: 46%;
  }

  .bars span {
    flex: 1;
    height: var(--h);
    border-radius: 0.5rem 0.5rem 0.2rem 0.2rem;
    background: rgb(255 255 255 / 0.14);
    transform-origin: bottom;
    transition:
      transform 0.8s var(--ease-out-expo),
      background-color 0.4s;
  }

  .bars span:nth-child(4),
  .bars span:nth-child(6) {
    background: var(--color-wf-accent);
  }

  .bars span:nth-child(7) {
    background: var(--color-wf-lime);
  }

  .work-card:hover .bars span {
    transform: scaleY(1.08);
  }

  .art--cta {
    background: var(--color-wf-lime);
  }

  .cta-arrow {
    position: absolute;
    top: 50%;
    right: clamp(1.5rem, 4vw, 3.5rem);
    font-size: clamp(6rem, 14vw, 13rem);
    font-weight: 300;
    line-height: 1;
    transform: translateY(-50%);
    transition: transform 0.7s var(--ease-out-expo);
  }

  .work-card:hover .cta-arrow {
    transform: translate(0.5rem, calc(-50% - 0.5rem)) rotate(8deg);
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '@/scripts/agency/motion';

  const cards = document.querySelectorAll<HTMLElement>('[data-work-card]');

  if (!prefersReducedMotion) {
    cards.forEach(card => {
      gsap.from(card, {
        y: 80,
        opacity: 0,
        duration: 1.3,
        ease: 'expo.out',
        scrollTrigger: { trigger: card, start: 'top 90%', once: true },
      });
    });
  }

  // Hover videos: play on hover with a mouse.
  const hoverCapable = window.matchMedia('(hover: hover)').matches;

  function play(card: HTMLElement, video: HTMLVideoElement) {
    if (!video.src && video.dataset.src) video.src = video.dataset.src;
    card.classList.add('is-playing');
    video.play().catch(() => card.classList.remove('is-playing'));
  }

  function stop(card: HTMLElement, video: HTMLVideoElement) {
    card.classList.remove('is-playing');
    video.pause();
  }

  // Touch screens have no hover: reveal (and play) a card while it is mostly in view.
  const inView = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        const card = entry.target as HTMLElement;
        card.classList.toggle('is-active', entry.isIntersecting);
        const video = card.querySelector('video');
        if (!video) return;
        if (entry.isIntersecting) play(card, video);
        else stop(card, video);
      });
    },
    { threshold: 0.6 }
  );

  cards.forEach(card => {
    if (!hoverCapable) {
      inView.observe(card);
      return;
    }
    const video = card.querySelector('video');
    if (!video) return;
    card.addEventListener('mouseenter', () => play(card, video));
    card.addEventListener('mouseleave', () => stop(card, video));
  });
</script>
