---
// Google Analytics 4 (gtag.js) plus lead tracking. Renders nothing until a
// Measurement ID is set in src/data/business.ts (`google.analyticsId`).
//
// The site uses Astro's ClientRouter, which swaps pages without a full
// reload, so the automatic page_view is turned off and one is sent on every
// `astro:page-load` (this fires on the first load too).
//
// Leads are sent as GA4's recommended `generate_lead` event, with `method`
// = phone | email | whatsapp | form. Mark them as key events in
// GA4 (Admin > Events) to use them as conversions in Google Ads.
import { google } from '@/data/business';

const id = google.analyticsId.trim();
---

{
  id && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${id}`}
      />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id, { send_page_view: false });

        document.addEventListener('astro:page-load', () => {
          gtag('event', 'page_view', {
            page_location: location.href,
            page_title: document.title,
          });
        });

        // Clicks on phone, email and WhatsApp links anywhere on the site.
        document.addEventListener('click', event => {
          const link = event.target.closest && event.target.closest('a[href]');
          if (!link) return;
          const href = link.getAttribute('href') || '';
          const method = href.startsWith('tel:')
            ? 'phone'
            : href.startsWith('mailto:')
              ? 'email'
              : /(^https?:\/\/)?(wa\.me|api\.whatsapp\.com)\//.test(href)
                ? 'whatsapp'
                : null;
          if (!method) return;
          gtag('event', 'generate_lead', {
            method,
            link_url: href.split('?')[0],
            page_path: location.pathname,
          });
        });

        // Forms marked with data-lead-form (only add it to a form that
        // actually delivers the enquiry, or GA will count false leads).
        document.addEventListener('submit', event => {
          const form = event.target;
          if (!form.matches || !form.matches('form[data-lead-form]')) return;
          gtag('event', 'generate_lead', {
            method: 'form',
            page_path: location.pathname,
          });
        });
      </script>
    </>
  )
}
