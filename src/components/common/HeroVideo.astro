---
import { Image } from 'astro:assets';
import chart from '@images/chart.webp';


---

{/* Hero Visual */}
<div class="relative m-auto w-full pt-16 sm:w-[90%]">


  <Image
    src={chart}
    alt="Chart"
    loading={'eager'}
    class="absolute inset-[25%_auto_auto_-8%] z-20 hidden w-[25%] sm:block"
  />

  <div class="aspect-auto">
    <img
      src="/hero-image/image.png"
      alt="VS Code UI with React"
      class="w-full h-auto rounded-xl shadow-lg"
    />
  </div>
</div>
