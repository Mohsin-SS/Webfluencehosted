---
const text = 'Introducing Webfluence';
const bannerText = 'Fastest growing IT company';
---

<div class="flex justify-start sm:justify-center">
  <div class="rounded-xl bg-slate-50 shadow-md">
    <div
      class="flex h-9 w-fit items-center justify-center gap-0 rounded-xl"
      aria-label={`${text} - ${bannerText}`}
    >
      <div
        class="flex h-full w-fit items-center gap-2 rounded-xl bg-linear-to-tr/oklch from-blue-800 to-blue-700 px-3"
      >
        <span class="text-sm text-white">{text}</span>
      </div>
      <div
        class="hidden h-full w-fit items-center justify-center gap-2 px-3 sm:flex"
      >
        <span class="text-slate-600 text-sm">{bannerText}</span>
      </div>
    </div>
  </div>
</div>
