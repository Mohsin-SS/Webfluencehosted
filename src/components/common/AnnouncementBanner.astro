---
const text = 'Introducing Webfluence';
const bannerText = 'Fastest growing IT company';
---

<div class="flex justify-center">
  <div class="rounded-xl bg-slate-50 shadow-md">
    <div
      class="flex h-9 w-fit items-center justify-center gap-0 rounded-xl"
      aria-label={`${text} - ${bannerText}`}
    >
      <div
        class="flex h-full w-fit items-center gap-1 sm:gap-2 rounded-xl bg-linear-to-tr/oklch from-blue-800 to-blue-700 px-2 sm:px-3"
      >
        <span class="text-[11px] sm:text-sm text-nowrap text-white">{text}</span>
      </div>
      <div
        class="flex h-full w-fit items-center justify-center gap-1 sm:gap-2 px-2 sm:px-3"
      >
        <span class="text-slate-600 text-[11px] sm:text-sm text-nowrap">{bannerText}</span>
      </div>
    </div>
  </div>
</div>
