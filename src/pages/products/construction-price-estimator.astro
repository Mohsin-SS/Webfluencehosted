---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  softwareSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'AI Construction Cost Estimator Software, Pakistan | Webfluence',
  description:
    'AI construction cost estimating software from Webfluence in Lahore, Pakistan. Get itemised material, labour and equipment estimates in minutes, synced to live supplier prices.',
};

const pageFaqs = faqs['construction-price-estimator'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  softwareSchema({
    url: Astro.url.href,
    name: 'Construction Price Estimator AI',
    category: 'BusinessApplication',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'Webfluence product',
  title: 'Construction Price Estimator AI',
  lead: 'Construction Price Estimator AI is Webfluence software that turns a project into an itemised estimate of materials, labour, equipment and overhead in minutes.',
  cta: { text: 'Request a demo', href: '/contact' },
  icon: 'chartPie',
};

const features = {
  eyebrow: 'What is included',
  title: 'Project estimates',
  accent: 'in minutes',
  items: [
    {
      icon: 'brain',
      title: 'AI Accuracy',
      description:
        'Train models on your historical project data to provide hyper-accurate cost predictions.',
    },
    {
      icon: 'chartPie',
      title: 'Instant Breakdown',
      description:
        'Get a detailed itemized breakdown of materials, labor, equipment, and overhead instantly.',
    },
    {
      icon: 'arrowPath',
      title: 'Live Pricing Sync',
      description:
        'Automatically sync with major supplier APIs to ensure material costs reflect real-time market prices.',
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
