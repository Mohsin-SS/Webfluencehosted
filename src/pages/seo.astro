---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  serviceSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'SEO Services in Lahore, Pakistan | Webfluence',
  description:
    'SEO services in Lahore, Pakistan. Webfluence handles on-page SEO, technical SEO and content strategy so more customers find your business on Google.',
};

const pageFaqs = faqs['seo'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  serviceSchema({
    url: Astro.url.href,
    name: 'SEO Services',
    serviceType: 'Search engine optimization',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'Search engine optimisation',
  title: 'Search Engine Optimization',
  lead: 'Webfluence runs SEO for businesses in Lahore, across Pakistan and abroad: technical fixes, on-page work and content that bring in leads and sales, not just rankings.',
  cta: { text: 'Start your campaign', href: '/contact' },
  icon: 'documentMagnifyingGlass',
};

const features = {
  eyebrow: 'What is included',
  title: 'Rankings that turn into',
  accent: 'leads and sales',
  items: [
    {
      icon: 'documentMagnifyingGlass',
      title: 'On-Page SEO',
      description:
        "Optimize your website's content, structure, and meta tags to ensure search engines understand your value.",
    },
    {
      icon: 'cog',
      title: 'Technical SEO',
      description:
        'Improve site speed, mobile-friendliness, and crawlability to resolve issues holding back your rankings.',
    },
    {
      icon: 'articles',
      title: 'Content Strategy',
      description:
        'Create high-quality, keyword-rich content that engages readers and earns authoritative backlinks.',
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
