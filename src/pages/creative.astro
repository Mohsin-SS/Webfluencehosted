---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  serviceSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'Creative & Branding Agency in Lahore, Pakistan | Webfluence',
  description:
    'Branding and creative services in Lahore, Pakistan. Webfluence designs brand identities, UI/UX and content that make your business stand out.',
};

const pageFaqs = faqs['creative'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  serviceSchema({
    url: Astro.url.href,
    name: 'Creative & Media Content',
    serviceType: 'Branding and design',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'Creative & media content',
  title: 'Creative & Branding',
  lead: 'Webfluence designs brand identities, UI/UX and content, from graphics and video to social media posts, so your business looks consistent everywhere.',
  cta: { text: 'Start your project', href: '/contact' },
  icon: 'lightbulb',
};

const features = {
  eyebrow: 'What is included',
  title: 'A brand people',
  accent: 'recognise and remember',
  items: [
    {
      icon: 'lightbulb',
      title: 'Brand Identity',
      description:
        'Develop a cohesive and unique brand identity that resonates with your target audience and stands out.',
    },
    {
      icon: 'puzzle',
      title: 'UI/UX Design',
      description:
        'Craft intuitive, user-centric interfaces that enhance usability and drive customer satisfaction.',
    },
    {
      icon: 'articles',
      title: 'Content Creation',
      description:
        "Produce engaging graphics, videos, and copywriting that tells your brand's unique story effectively.",
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
