---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  serviceSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'Performance & Digital Marketing Agency in Lahore | Webfluence',
  description:
    'Digital marketing agency in Lahore, Pakistan. Webfluence runs performance marketing, SEO and content, and creative campaigns measured on real leads and sales.',
};

const pageFaqs = faqs['digital-marketing'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  serviceSchema({
    url: Astro.url.href,
    name: 'Performance Marketing',
    serviceType: 'Performance marketing',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'Performance marketing',
  title: 'Digital Marketing & Performance',
  lead: 'Webfluence is a digital marketing agency in Lahore that runs Google Ads, Meta Ads, SEO and creative, measured on leads and sales. For Adoro (ECS) it grew monthly sales by 57%.',
  cta: { text: 'Start your campaign', href: '/contact' },
  icon: 'cursorRays',
};

const features = {
  eyebrow: 'What is included',
  title: 'Marketing measured on',
  accent: 'what it earns',
  items: [
    {
      icon: 'cursorRays',
      title: 'SEO & Content',
      description:
        'Rank higher on search engines and engage your audience with high-quality content optimized for conversion.',
    },
    {
      icon: 'brain',
      title: 'Performance Marketing',
      description:
        'Maximize your ROI through data-backed paid advertising campaigns across social and search networks.',
    },
    {
      icon: 'puzzle',
      title: 'Creative & Branding',
      description:
        'Stand out from the competition with stunning visual creatives, UI/UX designs, and compelling brand storytelling.',
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
