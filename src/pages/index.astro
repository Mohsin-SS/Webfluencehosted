---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Hero from '@sections/HeroSection.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import AboutWords from '@sections/AboutWords.astro';
import ServiceCards from '@sections/ServiceCards.astro';
import Testimonials from '@sections/Testimonials.astro';
import WhyWebfluence from '@sections/WhyWebfluence.astro';
import Deliverables from '@sections/Deliverables.astro';
import Showcase from '@sections/Showcase.astro';
import FAQ from '@sections/FAQ.astro';
import ContactSection from '@sections/ContactSection.astro';
import { faqs } from '@/data/faqs';
import { business } from '@/data/business';
import { webPageSchema, faqSchema } from '@/data/schema';

const pageFaqs = faqs['home'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: 'Webfluence — Performance Marketing & Software Company in Lahore',
    description: business.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
---

<BaseLayout schema={schema}>
  {/* Section order follows the Nexera design. */}
  <Hero />

  <ClientLogos />

  <AboutWords />

  <ServiceCards />

  <Testimonials />

  <WhyWebfluence />

  <Deliverables />

  <Showcase />

  <FAQ items={pageFaqs} />

  <ContactSection />
</BaseLayout>
