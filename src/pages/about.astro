---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import { webPageSchema } from '@/data/schema';

// Data describing the "About" section content
const aboutData = {
  title: 'Webfluence,',
  description:
    'is a software development and digital marketing company in Lahore, Pakistan. We build custom ERP and CRM systems, websites, mobile apps and WhatsApp chatbots, and run SEO, Google Ads, Meta Ads and creative work for businesses across Pakistan and internationally.',
  statistics: [
    {
      label: 'Digital Products Launched',
      value: '250+',
    },
    {
      label: 'Lines of Code Shipped',
      value: '10M+',
    },
    {
      label: 'Global Enterprise Clients',
      value: '45+',
    },
    {
      label: 'Years of Engineering Excellence',
      value: '10+',
    },
  ],
};

// Data describing the expertise section
const expertiseData = {
  title: 'Our core engineering expertise:',
  expertise: [
    {
      title: 'Enterprise Software Development:',
      description:
        'Architecting robust, scalable ERP and CRM systems tailored to streamline your complex business logic and operational workflows.',
    },
    {
      title: 'Cloud & API Integration:',
      description:
        'Building secure, high-availability microservices and RESTful APIs deployed seamlessly on AWS, Azure, and Google Cloud.',
    },
    {
      title: 'Mobile App Engineering:',
      description:
        'Delivering native and cross-platform mobile applications that provide flawless performance and captivating user experiences.',
    },
    {
      title: 'UI/UX & Product Design:',
      description:
        'Crafting intuitive, user-centric interfaces that bridge the gap between human psychology and complex software functionality.',
    },
    {
      title: 'Data-Driven Performance Marketing:',
      description:
        'Leveraging deep analytics and technical SEO to acquire and retain customers, maximizing your digital ROI.',
    },
    {
      title: 'Quality Assurance & DevOps:',
      description:
        'Ensuring 99.99% uptime with rigorous automated testing, CI/CD pipelines, and proactive infrastructure monitoring.',
    },
  ],
};

// SEO metadata for the page
const seo = {
  title: 'About Webfluence — Software Company in Lahore, Pakistan',
  description:
    'Webfluence is a Lahore-based software development and digital marketing company helping businesses across Pakistan and internationally grow with custom software and performance marketing.',
};

// Schema.org metadata for SEO
const schema = webPageSchema({
  type: 'AboutPage',
  url: Astro.url.href,
  name: 'About Webfluence',
  description: seo.description,
});
---

<BaseLayout seo={seo} schema={schema}>
  <section class="mx-auto px-4 pt-20 pb-12">
    <div class="">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <h1
          class="text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {aboutData.title}
        </h1>
        <p
          class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {aboutData.description}
        </p>
      </div>

      {/* Statistics Section */}
      <div class="mx-auto mt-10 max-w-2xl lg:mx-0 lg:max-w-none">
        <dl
          class="mt-16 grid grid-cols-1 gap-8 sm:mt-20 sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            aboutData.statistics.map(stat => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-base/7 text-slate-700">{stat.label}</dt>
                <dd class="text-4xl font-semibold tracking-tight text-slate-800">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* Mission Statement Section */}
  <section class="mx-auto px-4 py-16">
    <div class="rounded-3xl bg-slate-50 p-10 lg:p-16 text-center shadow-sm border border-slate-200">
      <h2 class="text-3xl font-bold text-slate-800 sm:text-4xl">Our Mission</h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg text-slate-600 leading-relaxed">
        To empower businesses by engineering intelligent, robust software solutions that redefine industry standards. We believe that technology should be an enabler, not a bottleneck. That's why we combine deep technical expertise with strategic thinking to build software that not only looks beautiful but scales effortlessly and delivers measurable impact.
      </p>
    </div>
  </section>

  {/* Expertise Section */}
  <section class="mx-auto px-4 py-24 lg:py-32">
    <div
      class="group relative isolate overflow-hidden rounded-3xl bg-blue-200 p-5 sm:p-11"
    >
      <div
        class="group to-off-white pointer-events-none absolute inset-0 -top-[10%] h-[120%] w-full rounded-xl bg-linear-to-r/oklch from-blue-200 opacity-0 transition duration-1000 group-hover:opacity-100"
      >
      </div>
      <div class="svgBlock mx-auto">
        <h2
          class="relative pl-4 text-2xl font-semibold text-balance text-slate-800 md:text-3xl md:leading-tight"
        >
          {expertiseData.title}
        </h2>
        <dl
          class="relative mt-10 grid max-w-xl grid-cols-1 items-start text-base/7 text-slate-600 sm:max-w-none lg:grid-flow-row-dense lg:auto-rows-fr lg:grid-cols-3 gap-y-10"
        >
          {
            expertiseData.expertise.map((item, index) => (
              <div
                class={`px-5 py-5 sm:px-10 lg:py-0 ${
                  index % 3 === 1
                    ? 'h-full border-y border-dashed border-slate-400 lg:border-x lg:border-y-0'
                    : ''
                } ${(index > 2) ? 'lg:mt-10' : ''}`}
              >
                <dt class="text-lg font-semibold text-balance text-slate-600">
                  {item.title}
                </dt>
                <dd class="mt-2 text-pretty text-slate-500">
                  {item.description}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <style>
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url(/guilloche.svg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px, 20px;
      opacity: 0.075;
      background-clip: padding-box;
      mask-image: linear-gradient(270deg, rgb(0, 0, 0), rgba(0, 0, 0, 0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
