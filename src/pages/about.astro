---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import CTA from '@sections/CTA.astro';
import { webPageSchema } from '@/data/schema';

// Data describing the "About" section content
const aboutData = {
  title: 'Webfluence',
  headline:
    'is a performance marketing and software company in Lahore, Pakistan.',
  description:
    'We run Google and Meta campaigns, create social media and video content, and build ERP, CRM, mobile and web applications for businesses across Pakistan and internationally.',
  statistics: [
    {
      label: 'Digital Products Launched',
      value: '250+',
    },
    {
      label: 'Lines of Code Shipped',
      value: '10M+',
    },
    {
      label: 'Global Enterprise Clients',
      value: '45+',
    },
    {
      label: 'Years of Engineering Excellence',
      value: '10+',
    },
  ],
};

// Data describing the expertise section
const expertiseData = {
  title: 'Our core engineering expertise:',
  expertise: [
    {
      title: 'Enterprise Software Development:',
      description:
        'Architecting robust, scalable ERP and CRM systems tailored to streamline your complex business logic and operational workflows.',
    },
    {
      title: 'Cloud & API Integration:',
      description:
        'Building secure, high-availability microservices and RESTful APIs deployed seamlessly on AWS, Azure, and Google Cloud.',
    },
    {
      title: 'Mobile App Engineering:',
      description:
        'Delivering native and cross-platform mobile applications that provide flawless performance and captivating user experiences.',
    },
    {
      title: 'UI/UX & Product Design:',
      description:
        'Crafting intuitive, user-centric interfaces that bridge the gap between human psychology and complex software functionality.',
    },
    {
      title: 'Data-Driven Performance Marketing:',
      description:
        'Leveraging deep analytics and technical SEO to acquire and retain customers, maximizing your digital ROI.',
    },
    {
      title: 'Quality Assurance & DevOps:',
      description:
        'Ensuring 99.99% uptime with rigorous automated testing, CI/CD pipelines, and proactive infrastructure monitoring.',
    },
  ],
};

// SEO metadata for the page
const seo = {
  title: 'About Webfluence — Software Company in Lahore, Pakistan',
  description:
    'Webfluence is a Lahore-based software development and digital marketing company helping businesses across Pakistan and internationally grow with custom software and performance marketing.',
};

// Schema.org metadata for SEO
const schema = webPageSchema({
  type: 'AboutPage',
  url: Astro.url.href,
  name: 'About Webfluence',
  description: seo.description,
});
---

<BaseLayout seo={seo} schema={schema}>
  <section class="hero-band lit [--l1x:50%] [--l1y:-10%] [--l2y:-30%]">
    <div class="wrap pt-14 pb-12 sm:pt-20 lg:pt-24">
      <div class="shell">
        <p class="eyebrow" data-reveal>About us</p>
        <h1 data-reveal style="--i: 1" class="mt-6 max-w-4xl text-[2.6rem] leading-[1.06] sm:text-6xl">
          <span class="text-signal">{aboutData.title}</span>{' '}
          <span class="text-ink-deep">{aboutData.headline}</span>
        </h1>
        <p data-reveal style="--i: 2" class="mt-6 max-w-2xl text-[17px] leading-8">
          {aboutData.description}
        </p>

        <dl class="mt-14 grid grid-cols-2 gap-4 lg:grid-cols-4">
          {
            aboutData.statistics.map((stat, i) => (
              <div data-reveal data-spotlight style={`--i: ${i}`} class="glass flex flex-col-reverse rounded-3xl p-6">
                <dt class="mt-2 text-sm leading-6 text-slate-600">{stat.label}</dt>
                <dd class="font-display text-ink-deep text-4xl font-bold tracking-tight sm:text-5xl">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* Mission */}
  <section class="wrap py-10 sm:py-16">
    <div class="band-night shell rounded-[36px] px-6 py-14 text-center sm:px-14 sm:py-20" data-reveal>
      <p class="eyebrow justify-center text-sky!">Our mission</p>
      <p class="font-display mx-auto mt-6 max-w-4xl text-2xl leading-[1.4] font-medium tracking-[-0.015em] text-white sm:text-[2rem]">
        To empower businesses by engineering intelligent, robust software solutions that redefine industry standards. We believe that technology should be an enabler, not a bottleneck. That's why we combine deep technical expertise with strategic thinking to build software that not only looks beautiful but scales effortlessly and delivers measurable impact.
      </p>
    </div>
  </section>

  {/* Expertise */}
  <section class="lit wrap py-16 sm:py-24 [--l1x:30%] [--l2y:10%]">
    <div class="shell">
      <p class="eyebrow" data-reveal>Expertise</p>
      <h2 data-reveal style="--i: 1" class="mt-5 max-w-2xl text-4xl leading-[1.05] sm:text-5xl">
        {expertiseData.title.replace(/:$/, '')}
      </h2>
      <dl class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
        {
          expertiseData.expertise.map((item, i) => (
            <div data-reveal data-spotlight style={`--i: ${i % 3}`} class="glass rounded-[28px] p-7">
              <dt class="font-display text-ink-deep text-xl font-semibold tracking-tight">
                {item.title.replace(/:$/, '')}
              </dt>
              <dd class="mt-3 text-[15px] leading-7">{item.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CTA />
</BaseLayout>
