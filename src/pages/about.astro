---
export const prerender = true;
import AgencyLayout from '@layout/AgencyLayout.astro';
import type { WithContext, Thing } from 'schema-dts';

const seo = {
  title: 'About Webfluence | We Build, We Innovate',
  description: 'Webfluence is a premier software engineering and digital innovation agency.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'en-US',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'About Webfluence',
  description: 'Webfluence is a premier software engineering and digital innovation agency.',
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'Webfluence',
  },
};

const stats = [
  { value: "250+", label: "Digital Products\nLaunched" },
  { value: "10M+", label: "Lines of Code\nShipped" },
  { value: "45+", label: "Global Enterprise\nClients" },
  { value: "10", label: "Years crafting\ndigital experiences" },
];

const expertise = [
  {
    title: 'Enterprise Software',
    description: 'Architecting robust, scalable ERP and CRM systems tailored to streamline your complex business logic.'
  },
  {
    title: 'Cloud & API Integration',
    description: 'Building secure, high-availability microservices and RESTful APIs on AWS, Azure, and Google Cloud.'
  },
  {
    title: 'Mobile App Engineering',
    description: 'Delivering native and cross-platform mobile applications with flawless performance.'
  },
  {
    title: 'UI/UX & Product Design',
    description: 'Crafting intuitive, user-centric interfaces bridging human psychology and software functionality.'
  },
];
---

<AgencyLayout seo={seo} schema={schema}>
  <!-- Specific Styles for About Page -->
  <style is:global>
    /* Custom Selection */
    ::selection {
      background-color: #ff00a3;
      color: white;
    }
  </style>

  <main class="bg-white text-black overflow-hidden pb-24 pt-24 font-sans selection:bg-[#ff00a3] selection:text-white">
    
    <!-- Hero Section -->
    <section class="w-full px-6 md:px-12 lg:px-24 pt-12">
      <h1 data-skew-up class="text-7xl sm:text-8xl md:text-[9rem] lg:text-[11rem] font-medium tracking-tighter leading-[1.0] text-black">
        We Build,<br/>
        We Innovate
      </h1>
      
      <div class="mt-16 w-full h-[50vh] md:h-[60vh] lg:h-[75vh] rounded-t-[3rem] overflow-hidden relative opacity-0" id="hero-img">
        <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2564&auto=format&fit=crop" alt="Abstract Innovation" class="w-full h-full object-cover object-center" />
      </div>
    </section>

    <!-- Intro Text Section -->
    <section class="w-full px-6 md:px-12 lg:px-24 py-24 md:py-32">
      <h2 data-skew-up class="text-4xl md:text-5xl lg:text-[3.5rem] font-medium tracking-tight leading-[1.15] max-w-[90%]">
        Webfluence is a digital agency.<br/>
        We craft impactful experiences with magic people, 🚀 buzzing people!
      </h2>
    </section>

    <!-- Stats Section -->
    <section class="w-full px-6 md:px-12 lg:px-24 pb-24">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 pb-12 border-b border-gray-200">
        {stats.map(stat => (
          <div class="flex items-center gap-4">
            <div class="text-5xl md:text-6xl font-normal text-black tracking-tighter" data-skew-up>
              {stat.value}
            </div>
            <div class="text-sm md:text-[15px] text-black font-medium leading-[1.3] whitespace-pre-line" data-skew-up>
              {stat.label}
            </div>
          </div>
        ))}
      </div>
      
      <div class="flex justify-end mt-32 mb-12">
        <div class="w-full md:w-[65%]">
          <!-- Text is explicitly black but animated from low opacity to full opacity -->
          <p data-split-word class="text-xl md:text-[1.8rem] text-black leading-relaxed font-light">
            Here are some achievements you’ll probably recognize that we’ve had the pleasure to reach. Cool, right? Now that we’ve got your attention, we often say the bigger the project, the less room there is for creative excitement as other priorities tend to overshadow design. But fear not we’re a team of enthusiasts who always deliver, no matter the challenge!
          </p>
        </div>
      </div>
    </section>

    <!-- Big Statement Section -->
    <section class="w-full px-6 md:px-12 lg:px-24 py-24 md:py-32">
      <h2 data-skew-up class="text-5xl md:text-6xl lg:text-[5rem] font-medium tracking-tight leading-[1.1] max-w-[95%]">
        We work with brands big and small, far and wide, on a broad range of design services.
      </h2>
    </section>

    <!-- Expertise Section -->
    <section class="w-full px-6 md:px-12 lg:px-24 pb-32">
       <div class="grid grid-cols-1 md:grid-cols-12 gap-5 lg:gap-6">
          {expertise.map((item, i) => {
            const colSpan = i % 4 === 0 || i % 4 === 3 ? 'md:col-span-7' : 'md:col-span-5';
            const images = [
              '/work/covers/pink_shapes.jpg',
              '/work/covers/neon_rock.jpg',
              'https://images.unsplash.com/photo-1614850523459-c2f4c699c52e?q=80&w=1000&auto=format&fit=crop',
              'https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=1000&auto=format&fit=crop'
            ];
            const imgSrc = images[i % 4];
            return (
              <div class={`group relative rounded-3xl overflow-hidden bg-[#0b0b0f] flex flex-col justify-end p-8 md:p-10 min-h-[400px] md:min-h-[460px] ${colSpan}`}>
                 <!-- Background Image -->
                 <img src={imgSrc} alt={item.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105 ease-out" />
                 
                 <!-- Gradient overlay to ensure text is readable -->
                 <div class="absolute inset-0 bg-gradient-to-t from-[#0b0b0f] via-[#0b0b0f]/40 to-transparent pointer-events-none"></div>
                 
                 <div class="relative z-20 text-white mt-auto">
                   <div class="flex gap-2 mb-4">
                     <div class="px-4 py-1.5 rounded-full bg-white text-[#0b0b0f] text-sm font-bold shadow-md transform transition-transform group-hover:-translate-y-1">Service</div>
                     <div class="px-4 py-1.5 rounded-full bg-[#ff00a3] text-white text-sm font-bold shadow-md transform transition-transform group-hover:-translate-y-1" style="transition-delay: 40ms;">0{i+1}</div>
                   </div>
                   <h3 class="text-3xl md:text-[2.5rem] font-medium mb-3 tracking-tight leading-tight">{item.title}</h3>
                   <p class="text-base md:text-lg text-gray-300 max-w-[90%] font-light leading-relaxed">{item.description}</p>
                 </div>
              </div>
            );
          })}
       </div>
    </section>

  </main>

  <!-- External scripts for custom animations not handled by AgencyLayout -->
  <script is:inline src="https://unpkg.com/split-type"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.7/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.7/ScrollTrigger.min.js"></script>

  <!-- GSAP Custom Animation Logic -->
  <script is:inline>
    // GSAP Setup
    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener("DOMContentLoaded", () => {
      
      // Hero Image Reveal
      gsap.to("#hero-img", {
        opacity: 1,
        y: 0,
        duration: 1.5,
        ease: "power3.out",
        delay: 0.4
      });
      gsap.from("#hero-img", {
        y: 100,
        duration: 1.5,
        ease: "power3.out",
        delay: 0.4
      });

      // Text Reveal Animation using Opacity for [data-split-word]
      // (data-skew-up is automatically handled by AgencyLayout's initTextReveals)
      const initSplitWord = () => {
        const splitWordElements = document.querySelectorAll("[data-split-word]");
        splitWordElements.forEach((el) => {
          // split text
          const split = new SplitType(el, { types: "words", preserveWhitespace: true });
          
          // Initial state: 20% opacity (looks gray)
          gsap.set(split.words, { opacity: 0.2 });

          // Animate to full opacity (looks black) on scroll
          gsap.to(split.words, {
            scrollTrigger: {
              trigger: el,
              start: "top 85%",
              end: "center 40%",
              scrub: 1
            },
            opacity: 1,
            stagger: 0.05,
            ease: "none"
          });
        });
      };

      initSplitWord();

      // Handle resize for SplitType
      let resizeTimer;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          ScrollTrigger.refresh();
        }, 250);
      });
    });
  </script>
</AgencyLayout>
