---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  serviceSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'ERP Development Company in Lahore, Pakistan | Webfluence',
  description:
    'Custom ERP development in Lahore, Pakistan. Webfluence builds ERP systems that centralise your data, automate workflows and track inventory, finance and resources in one place.',
};

const pageFaqs = faqs['erp'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  serviceSchema({
    url: Astro.url.href,
    name: 'Custom ERP Development',
    serviceType: 'ERP development',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'ERP development',
  title: 'Enterprise Resource Planning',
  lead: 'Webfluence builds custom ERP systems for businesses in Lahore, across Pakistan and abroad. Inventory, finance, HR and supply chain run in one system shaped around how you work.',
  cta: { text: 'Start your project', href: '/contact' },
  icon: 'dataBase',
};

const features = {
  eyebrow: 'What is included',
  title: 'One system for',
  accent: 'your whole operation',
  items: [
    {
      icon: 'dataBase',
      title: 'Centralized Data',
      description:
        'Eliminate data silos by bringing all your business data into a single, unified, and secure platform.',
    },
    {
      icon: 'arrowPath',
      title: 'Workflow Automation',
      description:
        'Automate repetitive tasks across departments to reduce errors and improve operational efficiency.',
    },
    {
      icon: 'presentationChart',
      title: 'Resource Tracking',
      description:
        'Monitor inventory levels, financials, and project resources in real-time to make informed decisions.',
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
