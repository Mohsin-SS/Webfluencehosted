---
export const prerender = true;
import AgencyLayout from '@layout/AgencyLayout.astro';
import type { WithContext, Thing } from 'schema-dts';

const title = 'Contact us';
const subTitle = "Give us the full scoop – we're ready to jump in as soon as possible!";

const seo = {
  title: 'Contact Webfluence',
  description: 'Reach out to Webfluence to start your next big software or marketing project.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  inLanguage: 'en-US',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'Contact Webfluence',
  description: 'Reach out to Webfluence to start your next big software or marketing project.',
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'Webfluence',
  },
};
---

<AgencyLayout seo={seo} schema={schema}>
  <!-- White background layer with a bottom radius to reveal the dark footer underneath -->
  <main class="w-full bg-white text-black min-h-screen pt-32 md:pt-48 pb-32 font-sans relative z-10 rounded-b-[40px] shadow-2xl">
    <div class="px-4 sm:px-8 md:px-12 mx-auto w-full max-w-[1600px]">
      
      <!-- Headings -->
      <h1 class="text-7xl md:text-8xl lg:text-[10rem] font-medium tracking-tight mb-8">Contact</h1>
      
      <h2 data-reveal-words class="text-4xl md:text-5xl lg:text-[4.5rem] leading-tight font-medium tracking-tight mb-24 max-w-5xl">
        Give us the full scoop &ndash; we're ready to jump in as soon as possible!
      </h2>

      <!-- Form -->
      <form id="contact-page-form" class="w-full flex flex-col">
        <!-- Row 01 -->
        <div class="flex flex-col md:flex-row border-t border-gray-200 py-10 md:py-16 gap-6 md:gap-0">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">01.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium">What do you need:</label>
          </div>
          <div class="md:w-3/6 flex flex-wrap gap-4">
            {['Website', 'SEO', 'UI/UX', 'Mobile App', 'Web App', 'Others'].map(opt => (
              <label class="cursor-pointer group">
                <input type="checkbox" class="peer sr-only" name="needs" value={opt} />
                <div class="px-8 py-3 rounded-full border border-gray-300 text-sm md:text-base transition-colors peer-checked:bg-[#0b0b0f] peer-checked:text-white peer-checked:border-[#0b0b0f] group-hover:border-gray-400">
                  {opt}
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- Row 02 -->
        <div class="flex flex-col md:flex-row border-t border-gray-200 py-10 md:py-16 gap-6 md:gap-0">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">02.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium">Project Budget ($)</label>
          </div>
          <div class="md:w-3/6 flex flex-wrap gap-4">
            {['$1000 - $5000', '$5000 - $10000', '$10000 +'].map(opt => (
              <label class="cursor-pointer group">
                <input type="radio" class="peer sr-only" name="budget" value={opt} />
                <div class="px-8 py-3 rounded-full border border-gray-300 text-sm md:text-base transition-colors peer-checked:bg-[#0b0b0f] peer-checked:text-white peer-checked:border-[#0b0b0f] group-hover:border-gray-400">
                  {opt}
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- Row 03: Company -->
        <div class="flex flex-col md:flex-row border-t border-gray-200 py-10 md:py-16 gap-6 md:gap-0 items-center group">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">03.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium cursor-text" for="company">Your Company</label>
          </div>
          <div class="md:w-3/6">
            <input type="text" id="company" name="company" placeholder="Company name" class="w-full border-none focus:border-transparent focus:ring-0 focus:outline-none shadow-none focus:shadow-none text-xl md:text-2xl bg-transparent outline-none placeholder:text-gray-200 focus:text-[#0b0b0f] font-light transition-colors" />
          </div>
        </div>

        <!-- Row 04: Name -->
        <div class="flex flex-col md:flex-row border-t border-gray-200 py-10 md:py-16 gap-6 md:gap-0 items-center group">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">04.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium cursor-text" for="name">Your Name</label>
          </div>
          <div class="md:w-3/6">
            <input type="text" id="name" name="name" placeholder="Full name" class="w-full border-none focus:border-transparent focus:ring-0 focus:outline-none shadow-none focus:shadow-none text-xl md:text-2xl bg-transparent outline-none placeholder:text-gray-200 focus:text-[#0b0b0f] font-light transition-colors" />
          </div>
        </div>

        <!-- Row 05: Email -->
        <div class="flex flex-col md:flex-row border-t border-gray-200 py-10 md:py-16 gap-6 md:gap-0 items-center group">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">05.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium cursor-text" for="email">Your E-mail</label>
          </div>
          <div class="md:w-3/6">
            <input type="email" id="email" name="email" placeholder="Email address" class="w-full border-none focus:border-transparent focus:ring-0 focus:outline-none shadow-none focus:shadow-none text-xl md:text-2xl bg-transparent outline-none placeholder:text-gray-200 focus:text-[#0b0b0f] font-light transition-colors" />
          </div>
        </div>

        <!-- Row 06: Phone -->
        <div class="flex flex-col md:flex-row border-t border-gray-200 py-10 md:py-16 gap-6 md:gap-0 items-center group">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">06.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium cursor-text" for="phone">Your Phone</label>
          </div>
          <div class="md:w-3/6">
            <input type="tel" id="phone" name="phone" placeholder="Contact number" class="w-full border-none focus:border-transparent focus:ring-0 focus:outline-none shadow-none focus:shadow-none text-xl md:text-2xl bg-transparent outline-none placeholder:text-gray-200 focus:text-[#0b0b0f] font-light transition-colors" />
          </div>
        </div>

        <!-- Row 07: Designation -->
        <div class="flex flex-col md:flex-row border-t border-gray-200 py-10 md:py-16 gap-6 md:gap-0 items-center group">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">07.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium cursor-text" for="designation">Your Designation</label>
          </div>
          <div class="md:w-3/6">
            <input type="text" id="designation" name="designation" placeholder="Designation" class="w-full border-none focus:border-transparent focus:ring-0 focus:outline-none shadow-none focus:shadow-none text-xl md:text-2xl bg-transparent outline-none placeholder:text-gray-200 focus:text-[#0b0b0f] font-light transition-colors" />
          </div>
        </div>

        <!-- Row 08: Hear About Us -->
        <div class="flex flex-col md:flex-row border-t border-gray-200 py-10 md:py-16 gap-6 md:gap-0 items-center group">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">08.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium cursor-text" for="hear">How did you hear about us</label>
          </div>
          <div class="md:w-3/6">
            <input type="text" id="hear" name="hear" placeholder="How did you hear about us?" class="w-full border-none focus:border-transparent focus:ring-0 focus:outline-none shadow-none focus:shadow-none text-xl md:text-2xl bg-transparent outline-none placeholder:text-gray-200 focus:text-[#0b0b0f] font-light transition-colors" />
          </div>
        </div>

        <!-- Row 09: Project Details -->
        <div class="flex flex-col md:flex-row border-y border-gray-200 py-10 md:py-16 gap-6 md:gap-0 group">
          <div class="md:w-1/6">
            <span class="text-2xl md:text-3xl font-medium">09.</span>
          </div>
          <div class="md:w-2/6">
            <label class="text-2xl md:text-3xl font-medium cursor-text" for="details">Project Details</label>
          </div>
          <div class="md:w-3/6">
            <textarea id="details" name="details" rows="4" placeholder="We're all ears! Dive deep into your project with us. Share your goals, expectations, success criteria, concerns, constraints, and any flexibility you have. The more you give us on the challenge, the better we can understand how to assist you." class="w-full border-none focus:border-transparent focus:ring-0 focus:outline-none shadow-none focus:shadow-none text-lg md:text-xl bg-transparent outline-none placeholder:text-gray-300 focus:text-[#0b0b0f] resize-none leading-relaxed font-light transition-colors"></textarea>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-start md:justify-end py-12">
          <button type="submit" class="px-12 py-5 bg-[#0b0b0f] text-white rounded-full text-xl md:text-2xl font-medium transition-transform hover:scale-105 cursor-pointer">
            Send Message
          </button>
        </div>

      </form>
    </div>
  </main>

  <script>
    // Automatically adjusting the height of the textarea
    document.addEventListener('astro:page-load', () => {
      const textarea = document.getElementById('details') as HTMLTextAreaElement;
      if (textarea) {
        textarea.addEventListener('input', () => {
          textarea.style.height = 'auto';
          textarea.style.height = `${textarea.scrollHeight}px`;
        });
      }

      // Handle form submission with mailto
      const form = document.getElementById('contact-page-form') as HTMLFormElement;
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const formData = new FormData(form);
          
          const needs = formData.getAll('needs').join(', ');
          const budget = formData.get('budget') || 'Not specified';
          const company = formData.get('company') || 'N/A';
          const name = formData.get('name') || 'N/A';
          const email = formData.get('email') || 'N/A';
          const phone = formData.get('phone') || 'N/A';
          const designation = formData.get('designation') || 'N/A';
          const hear = formData.get('hear') || 'N/A';
          const details = formData.get('details') || 'No details provided';
          
          let body = `Name: ${name}\n`;
          body += `Email: ${email}\n`;
          body += `Phone: ${phone}\n`;
          body += `Company: ${company}\n`;
          body += `Designation: ${designation}\n`;
          body += `Needs: ${needs}\n`;
          body += `Budget: ${budget}\n`;
          body += `Heard About Us: ${hear}\n\n`;
          body += `Project Details:\n${details}\n`;

          const subject = `New Inquiry from ${name}`;
          const mailtoUrl = `mailto:momin@webfluence.tech?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          
          window.location.href = mailtoUrl;
        });
      }
    });
  </script>
</AgencyLayout>
