---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';
import ContactForm from '@ui/forms/ContactForm.astro';
import { webPageSchema } from '@/data/schema';
import { business, phoneE164 } from '@/data/business';

const addressHeading = 'Our address:';
const emailHeading = 'Contact us by email:';
const knowledgeBaseHeading = 'Knowledge base';

// Shared with the footer and LocalBusiness schema; see src/data/business.ts
const contactDetails = {
  addressLine1: `${business.address.streetAddress},`,
  addressLine2: `${business.address.addressLocality}, Pakistan`,
  phone: business.phone,
  email: business.email,
};

const knowledgeBaseDetails = {
  description: 'Browse through all of our knowledge base articles.',
  linkText: 'Search the knowledge base',
  linkUrl: '/support/knowledge-base',
};

// Content for the page title and subtitle
const title = 'Contact us';
const subTitle = 'Questions, Comments or Feedback.';

// SEO metadata for the page
const seo = {
  title: 'Contact Webfluence — Software Development Company in Lahore',
  description:
    'Contact Webfluence in DHA Phase 6, Lahore. Call +92 324 4477757 or email info@webfluence.tech to discuss your software, website or marketing project.',
};

// Schema.org metadata for SEO
const schema = webPageSchema({
  type: 'ContactPage',
  url: Astro.url.href,
  name: 'Contact Webfluence',
  description: seo.description,
});
---

<BaseLayout seo={seo} schema={schema}>
  <section class="hero-band lit [--l1x:40%] [--l1y:20%] [--l2y:0%]">
    <div class="wrap pt-14 pb-24 sm:pt-20 lg:pt-24">
      <div class="shell">
        <div class="mb-12 max-w-3xl lg:mb-16">
          <p class="eyebrow" data-reveal>Contact</p>
          <h1 data-reveal style="--i: 1" class="mt-6 text-[2.6rem] leading-[1.04] text-balance sm:text-6xl">
            {title}
          </h1>
          <p data-reveal style="--i: 2" class="mt-5 text-[17px] leading-8">{subTitle}</p>
        </div>

        <div class="grid grid-cols-1 gap-x-10 gap-y-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-x-14">
          <div class="space-y-4">
            {
              [
                { icon: 'mapPin', heading: addressHeading, body: `${contactDetails.addressLine1} ${contactDetails.addressLine2}` },
                { icon: 'mobile', heading: 'Give us a call', body: contactDetails.phone, href: `tel:${phoneE164}` },
                { icon: 'email', heading: emailHeading, body: contactDetails.email, href: `mailto:${contactDetails.email}` },
              ].map((row, i) => (
                <div data-reveal data-spotlight style={`--i: ${i}`} class="glass flex gap-x-5 rounded-3xl p-6">
                  <span class="contact-icon">
                    <Icon name={row.icon} class="size-5 text-white" />
                  </span>
                  <div class="grow">
                    <h2 class="font-mono text-[11px] font-medium tracking-[0.1em] text-slate-500 uppercase">{row.heading}</h2>
                    {row.href ? (
                      <a class="text-ink-deep hover:text-brand mt-1.5 block text-[17px] font-medium transition-colors" href={row.href}>
                        {row.body}
                      </a>
                    ) : (
                      <p class="text-ink-deep mt-1.5 text-[17px] font-medium not-italic">{row.body}</p>
                    )}
                  </div>
                </div>
              ))
            }

            <div data-reveal style="--i: 3" class="glass flex gap-x-5 rounded-3xl p-6">
              <span class="contact-icon">
                <Icon name="info" class="size-5 text-white" />
              </span>
              <div class="grow">
                <h2 class="font-mono text-[11px] font-medium tracking-[0.1em] text-slate-500 uppercase">{knowledgeBaseHeading}</h2>
                <p class="mt-1.5 text-[15px] leading-7">{knowledgeBaseDetails.description}</p>
                <a
                  class="text-brand hover:text-brand-deep mt-2 inline-flex items-center gap-x-1.5 text-sm font-medium transition-colors"
                  href={knowledgeBaseDetails.linkUrl}
                >
                  {knowledgeBaseDetails.linkText}
                  <Icon name="chevronRight" class="size-4 text-current" />
                </a>
              </div>
            </div>
          </div>

          <div data-reveal style="--i: 1" class="relative h-fit">
            <div class="form-light" aria-hidden="true"></div>
            <div class="glass rounded-[32px] p-3 sm:p-6">
              <ContactForm />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .contact-icon {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      flex: none;
      border-radius: 0.9rem;
      background: linear-gradient(140deg, var(--color-brand), var(--color-lagoon));
      box-shadow: 0 10px 22px -10px rgb(20 118 235 / 0.7);
    }

    .form-light {
      position: absolute;
      inset: 8% -4% -6% 10%;
      z-index: -1;
      border-radius: 9999px;
      background:
        radial-gradient(circle at 25% 30%, rgb(20 118 235 / 0.35), transparent 60%),
        radial-gradient(circle at 80% 80%, rgb(1 164 202 / 0.32), transparent 60%);
    }
  </style>

  <script>
    // Automatically adjusting the height of the textarea
    // based on its content. Triggers when the textarea content changes.
    document.addEventListener('astro:page-load', () => {
      function textareaAutoHeight(
        el: HTMLTextAreaElement,
        offsetTop: number = 0
      ): void {
        el.style.height = 'auto';
        el.style.height = `${el.scrollHeight + offsetTop}px`;
      }

      (() => {
        const textareas: string[] = ['#input-message'];

        textareas.forEach(selector => {
          const textarea = document.querySelector(
            selector
          ) as HTMLTextAreaElement;

          if (!textarea) return;

          const overlay = textarea.closest('.hs-overlay');

          if (overlay) {
            const instance = (window as any).HSOverlay.getInstance(
              overlay,
              true
            );

            if (instance) {
              instance.element.on('open', () =>
                textareaAutoHeight(textarea, 3)
              );
            }
          } else {
            textareaAutoHeight(textarea, 3);
          }

          textarea.addEventListener('input', () => {
            textareaAutoHeight(textarea, 3);
          });
        });
      })();
    });
  </script>
</BaseLayout>
