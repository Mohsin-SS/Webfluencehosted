---
export const prerender = true;
/**
 * Case study: Zelvior Official × Webfluence
 * Route: /case-studies/zelvior
 */
import BaseLayout from '@layout/BaseLayout.astro';
import StatusChip from '../../components/case-study/StatusChip.astro';
import { zelvior as z } from '../../data/zelvior-case-study';

const seo = {
  title: 'Zelvior Official Case Study — Shopify Ecommerce | Webfluence',
  description:
    'How Webfluence refines Zelvior\'s Shopify storefront, fixes what sits underneath it, makes checkout and payments dependable, and builds the SEO and marketing foundation around it.',
};
const wa = 'https://wa.me/923217555516?text=Shopify%20Ecommerce';
const contact = '/contact';
---
<BaseLayout seo={seo}>
<div class="cs">
  <!-- Hero -->
  <section class="cs-wrap cs-hero">
    <div class="cs-hero-copy">
      <p class="cs-badge"><span class="cs-badge-logo cs-logo-dark"><img src="/logos/zelvior.png" alt="Zelvior" width="60" height="25" class="cs-badge-logo-tall"></span>Zelvior Official Case Study</p>
      <h1>Shopify Ecommerce</h1>
      <p class="cs-lead">Zelvior makes luxury womenswear in Pakistan: satin co-ord sets and structured jackets in limited runs that are never restocked. Webfluence works across the whole storefront, from how each piece is presented to whether a customer can pay for one, so the store holds up as well as the clothes do.</p>
      <div class="cs-actions">
        <a class="cs-btn cs-btn-primary" href={contact}>Book a Consultation</a>
        <a class="cs-btn cs-btn-ghost" href={wa} target="_blank" rel="noopener">Chat on WhatsApp</a>
      </div>
    </div>
    <figure class="cs-glass cs-hero-shot">
      <img src="/case-studies/zelvior/zel-capsule.jpg" alt="The zelviorofficial.pk homepage showing The Capsule Collection: Grace Blue, Grace Pink, Juliet Berry and Juliet Teal satin sets" width="1600" height="814" fetchpriority="high">
    </figure>
  </section>

  <!-- At a glance -->
  <section class="cs-wrap cs-results" aria-label="At a glance">
    <div class="cs-results-grid">
      <div class="cs-glass cs-stat"><span class="cs-stat-value cs-stat-value-sm">Shopify</span><span class="cs-stat-label">Platform</span></div>
      <div class="cs-glass cs-stat"><span class="cs-stat-value cs-stat-value-sm">Pakistan</span><span class="cs-stat-label">Market, priced in PKR</span></div>
      <div class="cs-glass cs-stat"><span class="cs-stat-value">{z.services.length}</span><span class="cs-stat-label">Services run as one plan</span></div>
      <div class="cs-glass cs-stat"><span class="cs-stat-value cs-stat-value-sm">{z.engagement}</span><span class="cs-stat-label">Engagement</span></div>
    </div>
    <p class="cs-note">Screenshots show the live store as published in {z.capturedOn}. Traffic and sales figures will be added once verified from Shopify, Search Console and campaign reporting.</p>
  </section>

  <!-- Scope -->
  <section class="cs-wrap cs-scope">
    <div class="cs-scope-head">
      <p class="cs-eyebrow">What we run</p>
      <h2>The whole store, handled as one plan</h2>
    </div>
    <div class="cs-scope-grid">
      <div class="cs-glass cs-card"><h3>Shopify store design</h3><p>Collections, product pages and mobile layouts that present each piece like a collection, not a catalogue.</p></div>
      <div class="cs-glass cs-card"><h3>Technical fixes</h3><p>Theme, app and configuration issues found and fixed before a customer finds them.</p></div>
      <div class="cs-glass cs-card"><h3>Checkout &amp; payments</h3><p>Payment options configured, troubleshot and tested end to end.</p></div>
      <div class="cs-glass cs-card"><h3>SEO</h3><p>Technical and on-page foundations across collections and product pages.</p></div>
      <div class="cs-glass cs-card"><h3>Digital marketing</h3><p>Social and paid campaigns pointed at pages built for them.</p></div>
      <div class="cs-partner">
        <span class="cs-partner-logo cs-logo-dark"><img src="/logos/zelvior.png" alt="Zelvior" width="120" height="50"></span>
        <div><h3>Limited runs, no restocks</h3><p>Every piece gets one chance to sell, so the store has one chance to present it well and let her buy it.</p></div>
      </div>
    </div>
  </section>

  <!-- Feature sections -->
  <section class="cs-wrap cs-feature">
    <div class="cs-feature-copy">
      <span class="cs-num">01</span>
      <h2>A storefront that feels like the clothes</h2>
      <p>Heavyweight wool, satin, silk linings, brass snaps. The brand sells on construction and restraint, so the storefront needs the same: quiet layouts, large photography and a product page that settles fit first. Size buttons, a quantity stepper, Add to cart and Buy now sit above the fold, with "ships within 3 to 5 business days" stated directly beneath them.</p>
      <a class="cs-link" href={z.client.url} target="_blank" rel="noopener">Visit zelviorofficial.pk<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
    </div>
    <figure class="cs-glass cs-feature-shot"><img src="/case-studies/zelvior/zel-product.jpg" alt="Regent Green Structured Jacket product page with size buttons, quantity, Add to cart and Buy now" loading="lazy" decoding="async"></figure>
  </section>

  <section class="cs-wrap cs-feature cs-flip">
    <div class="cs-feature-copy">
      <span class="cs-num">02</span>
      <h2>What the customer sees rests on what they don't</h2>
      <p>A Shopify store is a theme, a set of apps, store settings and a checkout, all of which have to agree. We trace layout and behaviour problems back to the template that causes them, review how each third-party app interacts with the theme, and check variants, inventory, shipping and currency settings so a size shows as available and a delivery charge appears correctly. Every change is followed by the same test: open a collection, choose a piece, select a size, add to cart, pay.</p>
      <a class="cs-link" href={contact}>Request a Consultation<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
    </div>
    <figure class="cs-glass cs-feature-shot"><img src="/case-studies/zelvior/zel-hero.jpg" alt="Zelvior homepage hero with full-bleed campaign film under the navigation" loading="lazy" decoding="async"></figure>
  </section>

  <section class="cs-wrap cs-feature">
    <div class="cs-feature-copy">
      <span class="cs-num">03</span>
      <h2>A beautiful store is not enough if the payment fails</h2>
      <p>The last two steps are where an order is won or lost. Webfluence configures the payment options Zelvior offers, troubleshoots payment issues and tests the full order journey on desktop and mobile. The live checkout shows debit and credit card (Visa, Mastercard and UnionPay) and cash on delivery, the option many shoppers in Pakistan expect for a first order with a brand.</p>
      <div class="cs-chips" aria-label="Payment status">
        {z.paymentMethods[0].chips.map((c) => <StatusChip status={c.status} label={c.label} />)}
      </div>
      <a class="cs-link" href={contact}>Request a Consultation<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
    </div>
    <figure class="cs-glass cs-feature-shot"><img src="/case-studies/zelvior/zel-checkout.jpg" alt="Zelvior checkout with free shipping, card and cash on delivery options and the order summary" loading="lazy" decoding="async"></figure>
  </section>

  <section class="cs-wrap cs-feature cs-flip">
    <div class="cs-feature-copy">
      <span class="cs-num">04</span>
      <h2>From a search to a product page in two clicks</h2>
      <p>The goal is a store that search engines can read and shoppers can arrive at without an ad. On the live store that means a descriptive title and meta description, a canonical URL, readable collection and product URLs, image alt text that names the piece, homepage copy that links to both collections and an FAQ answering delivery, restocks, currency and sizing in plain text. We keep working on copy for each drop, internal links and Search Console coverage.</p>
      <a class="cs-link" href={z.client.url} target="_blank" rel="noopener">Visit zelviorofficial.pk<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
    </div>
    <figure class="cs-glass cs-feature-shot"><img src="/case-studies/zelvior/seo-copy.jpg" alt="Homepage section titled Luxury Womenswear in Pakistan with links to satin co-ord sets and structured jackets" loading="lazy" decoding="async"></figure>
  </section>

  <section class="cs-wrap cs-feature">
    <div class="cs-feature-copy">
      <span class="cs-num">05</span>
      <h2>Marketing brings her to the store. The store finishes the job.</h2>
      <p>Zelvior already has the creative: campaign film, editorial photography and an audience on Instagram, Facebook and WhatsApp. We connect that to the storefront. An ad for the Juliet set lands on the Juliet set, not the homepage; creative follows the same palette and tone as the site; and campaign data shows which pieces earn attention while site data shows where shoppers stop. Both inform what we change next.</p>
      <a class="cs-link" href={contact}>Request a Consultation<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
    </div>
    <figure class="cs-glass cs-feature-shot"><img src="/case-studies/zelvior/zel-values.jpg" alt="Zelvior homepage section with brand values and the marquee: permanent collection, no restocks ever, crafted to outlast" loading="lazy" decoding="async"></figure>
  </section>

  <!-- The collection -->
  <section class="cs-wrap cs-creative">
    <div class="cs-creative-copy">
      <p class="cs-eyebrow">The collection</p>
      <h2>Four pieces, one chance each</h2>
      <p>The Capsule Collection as it appears on the live store. Each card shows the piece, its price in PKR and two actions, Discover piece or Buy now, with size selection opening in place.</p>
    </div>
    <div class="cs-creative-grid cs-grid-4">
      <figure class="cs-glass"><img src="/case-studies/zelvior/card-grace-blue.jpg" alt="Grace Blue Satin Set, Rs.15,500" loading="lazy"><figcaption>Grace Blue Satin Set</figcaption></figure>
      <figure class="cs-glass"><img src="/case-studies/zelvior/card-grace-pink.jpg" alt="Grace Pink Satin Set, Rs.15,500" loading="lazy"><figcaption>Grace Pink Satin Set</figcaption></figure>
      <figure class="cs-glass"><img src="/case-studies/zelvior/card-juliet-berry.jpg" alt="Juliet Berry Satin Co-ord Set, Rs.14,500" loading="lazy"><figcaption>Juliet Berry Satin Co-ord Set</figcaption></figure>
      <figure class="cs-glass"><img src="/case-studies/zelvior/card-juliet-teal.jpg" alt="Juliet Teal Satin Co-ord Set, Rs.14,500" loading="lazy"><figcaption>Juliet Teal Satin Co-ord Set</figcaption></figure>
    </div>
  </section>

  <!-- What we're building -->
  <section class="cs-wrap cs-values">
    <p class="cs-eyebrow">What we're building</p>
    <h2>The value of the work, before the numbers</h2>
    <p class="cs-sub">This is an ongoing engagement. Rather than quote figures we cannot yet verify, here is what each part of the work is for and where it stands.</p>
    <div class="cs-scope-grid">
      {z.values.map((v) => (
        <div class="cs-glass cs-card"><div class="cs-chip-row"><StatusChip status={v.status} /></div><h3>{v.title}</h3><p>{v.body}</p></div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cs-wrap">
    <div class="cs-cta">
      <h2>Building an ecommerce brand?</h2>
      <p>Webfluence combines Shopify development, technical problem-solving, payments, SEO and digital marketing for brands that sell online. Tell us about your store and we'll scope it with you.</p>
      <div class="cs-actions">
        <a class="cs-btn cs-btn-light" href={contact}>Book a Consultation</a>
        <a class="cs-btn cs-btn-outline" href={wa} target="_blank" rel="noopener">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</div>
</BaseLayout>

<style>
.cs{--cs-ink:#0e1b3d;--cs-ink-2:#3a4a6d;--cs-accent:#2457d6;--cs-accent-deep:#16349a;--cs-line:#2457d624;--cs-glass:linear-gradient(160deg, #ffffffc7, #ffffff73);--cs-glass-rim:#ffffffe6;--cs-shadow:0 1px 2px #16349a0f, 0 24px 60px -20px #16349a47;isolation:isolate;color:var(--cs-ink);background:radial-gradient(60rem 40rem at 85% -10%,#7faef573,#0000 60%),radial-gradient(50rem 36rem at -10% 30%,#bfd7fbb3,#0000 60%),radial-gradient(60rem 44rem at 100% 70%,#3b78ee38,#0000 60%),linear-gradient(#f4f8fe,#eaf1fc 60%,#f4f8fe);padding-bottom:96px;position:relative;overflow:hidden}
.cs:after{content:"";z-index:-1;pointer-events:none;opacity:.18;mix-blend-mode:soft-light;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='240' height='240' filter='url(%23n)'/></svg>");position:absolute;inset:0}
.dark .cs{--cs-ink:#e8eefc;--cs-ink-2:#a9b8d8;--cs-accent:#7fa8ff;--cs-line:#7fa8ff2e;--cs-glass:linear-gradient(160deg, #2838629e, #141e3a80);--cs-glass-rim:#a0beff47;--cs-shadow:0 24px 60px -20px #0009;background:radial-gradient(60rem 40rem at 85% -10%,#2457d659,#0000 60%),radial-gradient(60rem 44rem at 0 60%,#16349a59,#0000 60%),#0b1226}
.cs-wrap{max-width:92rem;margin:0 auto;padding:0 .75rem}
@media (width>=640px){.cs-wrap{padding:0 1rem}}
@media (width>=1024px){.cs-wrap{padding:0 1.25rem}}
@media (width>=1400px){.cs-wrap{max-width:98rem;padding:0 1.5rem}}
.cs-glass{background:var(--cs-glass);border:1px solid var(--cs-glass-rim);box-shadow:inset 0 1px 0 var(--cs-glass-rim), var(--cs-shadow);-webkit-backdrop-filter:blur(18px)saturate(1.4);position:relative}
.cs-hero{align-items:center;gap:3rem;padding-top:8rem;padding-bottom:4rem;display:grid}
@media (width>=1024px){.cs-hero{grid-template-columns:5fr 7fr;padding-top:10rem}}
.cs-badge{color:var(--cs-accent);background:var(--cs-glass);border:1px solid var(--cs-glass-rim);border-radius:999px;align-items:center;gap:.6rem;margin:0 0 1.25rem;padding:.35rem .9rem .35rem .4rem;font-size:.875rem;font-weight:500;display:inline-flex}
.cs-badge-logo{background:#fff;border-radius:999px;align-items:center;padding:.3rem .6rem;display:inline-flex}
.cs-badge-logo img{border-radius:0;width:auto;height:16px}
.cs h1{letter-spacing:-.03em;color:var(--cs-ink);margin:0;font-size:clamp(2.5rem,6vw,4.5rem);font-weight:600;line-height:1.02}
.cs-lead{max-width:44rem;color:var(--cs-ink-2);margin:1.25rem 0 0;font-size:1.125rem;line-height:1.65}
.cs-actions{flex-wrap:wrap;gap:.75rem;margin-top:2rem;display:flex}
.cs-btn{border-radius:.75rem;justify-content:center;align-items:center;min-height:3rem;padding:0 1.4rem;font-size:.95rem;font-weight:600;text-decoration:none;transition:transform .15s,box-shadow .15s,background .15s;display:inline-flex}
.cs-btn:focus-visible,.cs-link:focus-visible{outline:2px solid var(--cs-accent);outline-offset:3px}
.cs-btn-primary{color:#fff;background:linear-gradient(160deg,#3d7bf0,#1e48c8);box-shadow:inset 0 1px #ffffff73,0 14px 30px -12px #1e48c8b3}
.cs-btn-primary:hover{transform:translateY(-1px)}
.cs-btn-ghost{color:var(--cs-ink);background:var(--cs-glass);border:1px solid var(--cs-glass-rim);box-shadow:inset 0 1px 0 var(--cs-glass-rim)}
.cs-btn-ghost:hover{border-color:var(--cs-accent)}
.cs-hero-shot{border-radius:1.5rem;margin:0;padding:.6rem}
.cs-hero-shot img,.cs-feature-shot img{border-radius:1rem;width:100%;height:auto;display:block}
.cs-results{padding-bottom:5rem}
.cs-results-grid{grid-template-columns:repeat(2,1fr);gap:1rem;display:grid}
@media (width>=1024px){.cs-results-grid{grid-template-columns:repeat(4,1fr);gap:1.25rem}}
.cs-stat{border-radius:1.25rem;flex-direction:column;gap:.5rem;padding:1.75rem;display:flex}
.cs-stat-value{letter-spacing:-.03em;color:var(--cs-accent);font-size:clamp(2.5rem,5vw,3.75rem);font-weight:600;line-height:1}
.cs-stat-value.cs-stat-value-sm{font-size:clamp(1.75rem,3.2vw,2.5rem);line-height:1.1}
.cs-stat-label{color:var(--cs-ink);font-weight:500}
.cs-note{color:var(--cs-ink-2);margin:1rem 0 0;font-size:.9rem}
.cs-scope{padding-bottom:3rem}
.cs-scope h2,.cs-creative h2{letter-spacing:-.02em;color:var(--cs-ink);margin:1rem 0 0;font-size:clamp(1.75rem,3.4vw,2.5rem);font-weight:600;line-height:1.15}
.cs-scope-grid{gap:1rem;margin-top:2rem;display:grid}
@media (width>=768px){.cs-scope-grid{grid-template-columns:repeat(3,1fr);gap:1.25rem}}
.cs-card{border-radius:1.25rem;padding:1.75rem}
.cs-card h3{color:var(--cs-ink);margin:0 0 .5rem;font-size:1.25rem;font-weight:600}
.cs-card p{color:var(--cs-ink-2);margin:0;line-height:1.6}
.cs-partner{color:#fff;box-shadow:inset 0 1px 0 #ffffff59, var(--cs-shadow);background:linear-gradient(150deg,#2a63e0,#16349a);border-radius:1.25rem;align-items:center;gap:1.25rem;padding:1.5rem 1.75rem;display:flex}
.cs-partner h3{color:#fff;margin:0 0 .35rem;font-size:1.15rem;font-weight:600}
.cs-partner p{color:#ffffffdb;margin:0;line-height:1.55}
.cs-partner-logo{background:#fff;border-radius:.9rem;flex:none;justify-content:center;align-items:center;width:5.5rem;height:4rem;display:flex}
.cs-partner-logo img{object-fit:contain;width:4.5rem;height:auto}
.cs-feature{align-items:center;gap:2.5rem;padding-top:3rem;padding-bottom:3rem;display:grid}
@media (width>=1024px){.cs-feature{grid-template-columns:5fr 7fr;gap:4rem;padding-top:4rem;padding-bottom:4rem}
.cs-flip .cs-feature-copy{order:2}
.cs-flip{grid-template-columns:7fr 5fr}}
.cs-num{color:#fff;background:linear-gradient(160deg,#3d7bf0,#1e48c8);border-radius:50%;justify-content:center;align-items:center;width:2.75rem;height:2.75rem;font-weight:600;display:inline-flex;box-shadow:inset 0 1px #ffffff73}
.cs-feature h2{letter-spacing:-.02em;color:var(--cs-ink);margin:1rem 0 0;font-size:clamp(1.75rem,3.4vw,2.5rem);font-weight:600;line-height:1.15}
.cs-feature p{max-width:42rem;color:var(--cs-ink-2);margin:1rem 0 0;font-size:1.0625rem;line-height:1.7}
.cs-link{color:var(--cs-accent);align-items:center;gap:.35rem;margin-top:1.5rem;font-weight:600;text-decoration:none;display:inline-flex}
.cs-link:hover{text-underline-offset:4px;text-decoration:underline}
.cs-link svg{fill:none;stroke:currentColor;stroke-width:2px;stroke-linecap:round;stroke-linejoin:round;width:1.1rem;height:1.1rem}
.cs-feature-shot{border-radius:1.5rem;margin:0;padding:.6rem}
.cs-portrait{justify-self:center;max-width:26rem}
.cs-creative{align-items:center;gap:2.5rem;padding-top:4rem;padding-bottom:2rem;display:grid}
@media (width>=1024px){.cs-creative{grid-template-columns:5fr 7fr;gap:4rem}}
.cs-creative h2{letter-spacing:-.02em;color:var(--cs-ink);margin:1rem 0 0;font-size:clamp(1.75rem,3.4vw,2.5rem);font-weight:600;line-height:1.15}
.cs-creative-copy p:not(.cs-eyebrow){max-width:40rem;color:var(--cs-ink-2);margin:1rem 0 0;font-size:1.0625rem;line-height:1.7}
.cs-creative-grid{grid-template-columns:repeat(2,1fr);gap:1rem;display:grid}
.cs-creative-grid figure{border-radius:1.25rem;margin:0;padding:.5rem}
.cs-creative-grid img{aspect-ratio:1;object-fit:cover;border-radius:.85rem;width:100%;display:block}
.cs-eyebrow{color:var(--cs-accent);margin:0;font-size:.875rem;font-weight:600}
.cs-sub{max-width:44rem;color:var(--cs-ink-2);margin:.75rem 0 0;line-height:1.65}
.cs-cta{color:#fff;background:radial-gradient(40rem 20rem at 90% 0,#9dc1f473,#0000 60%),linear-gradient(150deg,#2a63e0,#16349a);border-radius:1.75rem;margin-top:5rem;padding:clamp(2rem,5vw,4rem);box-shadow:inset 0 1px #ffffff59,0 30px 70px -30px #16349acc}
.cs-cta h2{letter-spacing:-.02em;color:#fff;max-width:48rem;margin:0;font-size:clamp(1.75rem,3.4vw,2.5rem);font-weight:600;line-height:1.15}
.cs-cta p{color:#ffffffdb;max-width:48rem;margin:1rem 0 0;line-height:1.65}
.cs-btn-light{color:#16349a;background:#fff}
.cs-btn-light:hover{transform:translateY(-1px)}
.cs-btn-outline{color:#fff;background:#ffffff14;border:1px solid #ffffff8c}
.cs-btn-outline:hover{background:#ffffff29}
@media (prefers-reduced-motion:reduce){.cs-btn{transition:none}}
/* Zelvior-specific */
.cs-badge-logo.cs-logo-dark,.cs-partner-logo.cs-logo-dark{background:#361115}
.cs-badge-logo img.cs-badge-logo-tall{height:14px}
.cs-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.25rem}
.cs-creative-grid.cs-grid-4{grid-template-columns:repeat(2,1fr)}
@media (width>=640px){.cs-creative-grid.cs-grid-4{grid-template-columns:repeat(4,1fr)}}
.cs-creative-grid.cs-grid-4 img{aspect-ratio:600/846}
.cs-creative-grid figcaption{color:var(--cs-ink-2);font-size:.8rem;font-weight:500;margin:.6rem .25rem .1rem}
.cs-values{padding-top:5rem}
.cs-values h2{letter-spacing:-.02em;color:var(--cs-ink);margin:1rem 0 0;font-size:clamp(1.75rem,3.4vw,2.5rem);font-weight:600;line-height:1.15}
.cs-values .cs-scope-grid{margin-top:2.5rem}
.cs-card .cs-chip-row{margin:0 0 .9rem}
.cs-feature figure img{object-fit:cover}
</style>
