---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  serviceSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'WhatsApp Chatbot Development in Pakistan | Webfluence',
  description:
    'WhatsApp chatbot development in Pakistan. Webfluence builds AI WhatsApp chatbots that answer customers 24/7, process orders and sync conversations to your CRM.',
};

const pageFaqs = faqs['whatsapp-chatbot'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  serviceSchema({
    url: Astro.url.href,
    name: 'WhatsApp Chatbot Development',
    serviceType: 'Chatbot development',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'WhatsApp automation',
  title: 'WhatsApp Chatbot',
  lead: 'Webfluence builds AI WhatsApp chatbots that answer customers 24/7, take orders and log every conversation in your CRM.',
  cta: { text: 'Start your project', href: '/contact' },
  icon: 'chatBubble',
};

const features = {
  eyebrow: 'What is included',
  title: 'Customer conversations,',
  accent: 'handled around the clock',
  items: [
    {
      icon: 'chatBubble',
      title: '24/7 Automation',
      description:
        'Answer FAQs, process orders, and assist customers around the clock without human intervention.',
    },
    {
      icon: 'brain',
      title: 'AI Integration',
      description:
        'Connect natural language processing to understand complex queries and provide human-like responses.',
    },
    {
      icon: 'portfolio',
      title: 'CRM Sync',
      description:
        'Seamlessly integrate chats with your CRM to track conversations and build rich customer profiles.',
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
