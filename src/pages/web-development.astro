---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  serviceSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'Web Development Company in Lahore, Pakistan | Webfluence',
  description:
    'Web development in Lahore, Pakistan. Webfluence builds fast, secure websites and custom web applications, from frontend design to scalable backend architecture.',
};

const pageFaqs = faqs['web-development'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  serviceSchema({
    url: Astro.url.href,
    name: 'Web Development',
    serviceType: 'Web development',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'Web development',
  title: 'Web Development',
  lead: 'Webfluence builds fast, secure websites, Shopify stores and custom web applications for businesses in Pakistan and abroad, from design through to backend.',
  cta: { text: 'Start your project', href: '/contact' },
  icon: 'newWindow',
};

const features = {
  eyebrow: 'What is included',
  title: 'Websites and web apps',
  accent: 'built to perform',
  items: [
    {
      icon: 'cog',
      title: 'Custom Web Apps',
      description:
        'We build fully customized web applications tailored specifically to meet your unique business requirements.',
    },
    {
      icon: 'newWindow',
      title: 'Frontend Excellence',
      description:
        'Deliver engaging user experiences with responsive, accessible, and lightning-fast frontend interfaces.',
    },
    {
      icon: 'dataBase',
      title: 'Backend Architecture',
      description:
        'Develop robust, scalable, and secure backend systems and APIs to power your digital ecosystem.',
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
