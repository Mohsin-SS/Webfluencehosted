---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  serviceSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'Mobile App Development Company in Lahore | Webfluence',
  description:
    'Mobile app development in Lahore, Pakistan. Webfluence designs and builds cross-platform iOS and Android apps, then maintains them after launch.',
};

const pageFaqs = faqs['mobile-app'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  serviceSchema({
    url: Astro.url.href,
    name: 'Mobile App Development',
    serviceType: 'Mobile app development',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'Mobile app development',
  title: 'Mobile App Development',
  lead: 'Webfluence designs and builds cross-platform mobile apps for iOS and Android, then keeps them secure and up to date after launch.',
  cta: { text: 'Start your project', href: '/contact' },
  icon: 'mobile',
};

const features = {
  eyebrow: 'What is included',
  title: 'iOS and Android apps',
  accent: 'from one team',
  items: [
    {
      icon: 'mobile',
      title: 'Cross-Platform',
      description:
        'Build once, run anywhere. We utilize modern frameworks to deliver native-like apps on both major platforms efficiently.',
    },
    {
      icon: 'puzzle',
      title: 'UI/UX Design',
      description:
        'Engage your users with beautiful, intuitive interfaces optimized specifically for touch and mobile displays.',
    },
    {
      icon: 'cog',
      title: 'App Maintenance',
      description:
        'Ensure your application stays secure and compatible with ongoing updates, bug fixes, and feature enhancements.',
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
