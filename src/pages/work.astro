---
export const prerender = true;
import AgencyLayout from '@layout/AgencyLayout.astro';
import { Image } from 'astro:assets';
import { projects } from '@/data/agency';
import eduLinkWeb from '@images/clients-work/edu-link-web.png';
import crmEduLinkWeb from '@images/clients-work/crm-edu-link-web.png';
import latchShopify from '@images/clients-work/latch-shopify.png';

const images = {
  'edu-link-web': eduLinkWeb,
  'crm-edu-link-web': crmEduLinkWeb,
  'latch-shopify': latchShopify,
};

const seo = {
  title: 'Our Work | Webfluence',
  description:
    'Selected client work from Webfluence — websites, CRMs and custom software we have designed, built and shipped.',
};

const hostOf = (url: string) => new URL(url).host;
---

<AgencyLayout seo={seo}>
  <section class="work-hero">
    <div class="wf-container">
      <p class="eyebrow">(Our work)</p>
      <h1 class="display-1" data-skew-up>Work that ships<br />and performs.</h1>
      <p class="work-intro">
        A look at the products we have designed, engineered and launched for our clients — from public
        websites to the internal systems that run their business.
      </p>
    </div>
  </section>

  <div class="wf-container">
    {
      projects.map((project, i) => (
        <article class="case" id={project.slug}>
          <header class="case-head">
            <span class="case-index">{String(i + 1).padStart(2, '0')}</span>
            <div class="case-meta">
              <span>{project.client}</span>
              <span aria-hidden="true">·</span>
              <span>{project.year}</span>
            </div>
            <ul class="case-tags">
              {project.tags.map(tag => (
                <li>{tag}</li>
              ))}
            </ul>
          </header>

          <h2 class="display-3 case-title" data-skew-up>
            {project.title}
          </h2>

          <a
            href={project.url}
            target="_blank"
            rel="noopener"
            class="case-frame"
            data-cursor="view"
            data-case-frame
            aria-label={`Open ${hostOf(project.url)} in a new tab`}
          >
            <div class="frame-bar" aria-hidden="true">
              <span class="frame-dots">
                <i />
                <i />
                <i />
              </span>
              <span class="frame-url">{hostOf(project.url)}</span>
            </div>
            <Image
              src={images[project.image]}
              alt={`${project.client} — ${hostOf(project.url)}`}
              widths={[640, 1200, 1800, 2400]}
              sizes="(min-width: 120rem) 116rem, 96vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="frame-img"
            />
          </a>

          <div class="case-body">
            <div class="case-summary">
              <p>{project.summary}</p>
              <a href={project.url} target="_blank" rel="noopener" class="case-visit">
                Visit {hostOf(project.url)} <span aria-hidden="true">↗</span>
              </a>
            </div>

            <div class="case-detail">
              <h3 class="case-label">What we delivered</h3>
              <ul class="case-highlights">
                {project.highlights.map(item => (
                  <li>{item}</li>
                ))}
              </ul>

              <h3 class="case-label">Services</h3>
              <ul class="case-services">
                {project.services.map(service => (
                  <li>{service}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }

    <a href="/contact" class="work-cta">
      <span class="display-2">Your project, next.</span>
      <span class="work-cta-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</AgencyLayout>

<style>
  .work-hero {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .work-hero .eyebrow {
    margin-bottom: 1.5rem;
  }

  .work-intro {
    max-width: 40rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-wf-muted);
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.5;
  }

  .case {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid rgb(11 11 15 / 0.12);
  }

  .case-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .case-index {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-wf-accent);
  }

  .case-meta {
    display: flex;
    gap: 0.5rem;
    color: var(--color-wf-muted);
    font-weight: 500;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }

  .case-tags li {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    background: var(--color-wf-ink);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .case-tags li:nth-child(2) {
    background: var(--color-wf-accent);
  }

  .case-tags li:nth-child(3) {
    background: var(--color-wf-lime);
    color: var(--color-wf-ink);
  }

  .case-title {
    max-width: 24ch;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  /* Screenshot in a minimal browser chrome. */
  .case-frame {
    display: block;
    overflow: hidden;
    border: 1px solid rgb(11 11 15 / 0.1);
    border-radius: var(--radius-lg);
    background: #f2f2f5;
    box-shadow: 0 30px 80px -40px rgb(11 11 15 / 0.45);
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid rgb(11 11 15 / 0.08);
  }

  .frame-dots {
    display: flex;
    gap: 0.4rem;
  }

  .frame-dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: rgb(11 11 15 / 0.15);
  }

  .frame-url {
    flex: 1;
    max-width: 24rem;
    margin-inline: auto;
    padding: 0.3rem 1rem;
    overflow: hidden;
    border-radius: 999px;
    background: #fff;
    color: var(--color-wf-muted);
    font-size: 0.85rem;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .frame-img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 1s var(--ease-out-expo);
  }

  .case-frame:hover .frame-img {
    transform: scale(1.02);
  }

  .case-body {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 900px) {
    .case-body {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .case-summary p {
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .case-visit {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--color-wf-ink);
    color: #fff;
    font-weight: 600;
    transition: background-color 0.25s;
  }

  .case-visit:hover {
    background: var(--color-wf-accent);
  }

  .case-label {
    margin-bottom: 1rem;
    color: var(--color-wf-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .case-highlights {
    display: grid;
    margin-bottom: 2.5rem;
  }

  .case-highlights li {
    display: flex;
    gap: 0.85rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid rgb(11 11 15 / 0.1);
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .case-highlights li::before {
    content: '✓';
    display: grid;
    flex: none;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.05rem;
    border-radius: 50%;
    background: var(--color-wf-lime);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .case-services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .case-services li {
    padding: 0.45rem 1rem;
    border: 1px solid rgb(11 11 15 / 0.15);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .work-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 9vw, 8rem);
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-lg);
    background: var(--color-wf-lime);
    color: var(--color-wf-ink);
  }

  .work-cta-arrow {
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 300;
    line-height: 1;
    transition: transform 0.7s var(--ease-out-expo);
  }

  .work-cta:hover .work-cta-arrow {
    transform: translate(0.5rem, -0.5rem) rotate(8deg);
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '@/scripts/agency/motion';

  if (!prefersReducedMotion) {
    document.querySelectorAll<HTMLElement>('[data-case-frame]').forEach(frame => {
      gsap.from(frame, {
        y: 80,
        opacity: 0,
        duration: 1.3,
        ease: 'expo.out',
        scrollTrigger: { trigger: frame, start: 'top 90%', once: true },
      });
    });
  }
</script>
