---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@sections/PageHero.astro';
import FeatureColumns from '@sections/FeatureColumns.astro';
import ClientLogos from '@sections/ClientLogos.astro';
import CTA from '@sections/CTA.astro';
import FAQ from '@sections/FAQ.astro';
import { faqs } from '@/data/faqs';
import {
  webPageSchema,
  serviceSchema,
  faqSchema,
} from '@/data/schema';

const seo = {
  title: 'CRM Development Company in Lahore, Pakistan | Webfluence',
  description:
    'Custom CRM development in Lahore, Pakistan. Webfluence builds CRM systems for lead management and sales analytics that integrate with the tools your team already uses.',
};

const pageFaqs = faqs['crm'];

const schema = [
  webPageSchema({
    url: Astro.url.href,
    name: seo.title,
    description: seo.description,
  }),
  serviceSchema({
    url: Astro.url.href,
    name: 'Custom CRM Development',
    serviceType: 'CRM development',
    description: seo.description,
  }),
  faqSchema(Astro.url.href, pageFaqs),
];
const hero = {
  eyebrow: 'CRM development',
  title: 'CRM Solutions',
  lead: 'Webfluence builds custom CRM systems that put every lead and customer in one place. Track each enquiry through your pipeline, automate follow-ups and see what is converting.',
  cta: { text: 'Start your project', href: '/contact' },
  icon: 'portfolio',
};

const features = {
  eyebrow: 'What is included',
  title: 'A CRM shaped around',
  accent: 'your sales process',
  items: [
    {
      icon: 'portfolio',
      title: 'Lead Management',
      description:
        'Capture, track, and nurture leads through every stage of the sales funnel with automated workflows.',
    },
    {
      icon: 'chartPie',
      title: 'Sales Analytics',
      description:
        'Gain deep insights into your sales performance with customizable dashboards and real-time reporting.',
    },
    {
      icon: 'cog',
      title: 'System Integration',
      description:
        'Connect your CRM seamlessly with your email marketing, accounting, and support tools.',
    },
  ],
};
---

<BaseLayout seo={seo} schema={schema}>
  <PageHero {...hero} points={features.items.map(item => item.title)} />

  <ClientLogos />

  <FeatureColumns {...features} />
  {/* Case study: real client work (Times Consultant) */}
  <section class="wrap pb-16 sm:pb-24">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-10 lg:grid-cols-2 lg:gap-14"
    >
      <div>
        <p class="eyebrow mb-5">Case study</p>
        <h2 class="text-3xl text-balance sm:text-[2.125rem] sm:leading-tight">
          How Times Consultant runs 500+ overseas students from one CRM
        </h2>
        <p class="mt-5 text-[15px] leading-8">
          Times Consultant, an education consultancy, had student leads
          scattered across WhatsApp chats and spreadsheets. Webfluence built an
          AI-powered CRM with WhatsApp automation, so every inquiry is answered,
          logged against the student and tracked through to enrolment.
        </p>
        <a
          href="/work/times-consultant"
          class="text-brand mt-7 inline-flex items-center gap-2 text-[15px] font-semibold hover:underline"
        >
          Read the Times Consultant case study
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <img
        src="/case-studies/times-consultant/crm-dashboard.jpg"
        alt="EduConsult CRM dashboard built by Webfluence for Times Consultant"
        class="w-full rounded-xl border border-slate-200 object-cover shadow-md"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <FAQ items={pageFaqs} />

  <CTA />
</BaseLayout>
