---
export const prerender = true;
import AgencyLayout from '@layout/AgencyLayout.astro';
import Button from '@ui/Button.astro';
import Icon from '@ui/icons/Icon.astro';
import ServiceDetails from '@agency/ServiceDetails.astro';
import { serviceDetails } from '@/data/services';
import type { WithContext, Thing } from 'schema-dts';

const seo = {
  title: 'Performance Marketing Services - Webfluence',
  description: 'Maximize your ROI with Webfluence\'s performance marketing services. Data-driven paid advertising across Google, Meta, and more.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Performance Marketing Services - Webfluence',
  url: Astro.url.href,
  description: seo.description,
};
---

<AgencyLayout seo={seo} schema={schema}>
  {/* Hero Section */}
  <section class="bg-linear-to-b/oklch from-blue-200 via-transparent to-white">
    <div class="mx-auto max-w-4xl px-4 pt-48 pb-12 sm:px-6 lg:px-8 text-center">
      <h1 class="block text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl">
        Performance Marketing
      </h1>
      <p class="mt-6 text-lg text-pretty text-slate-700">
        Drive measurable results with data-backed paid advertising campaigns. We optimize every dollar spent across search, social, and display networks to maximize your conversions.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-5 sm:flex-row">
        <Button href="/contact" variant="primary">Launch Your Campaign</Button>
      </div>
    </div>
  </section>

  {/* Services Section */}
  <section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="rounded-2xl bg-blue-50 p-8 shadow-sm transition hover:shadow-md border border-blue-100">
        <div class="bg-blue-100 rounded-full w-14 h-14 flex items-center justify-center mb-6">
          <Icon name="presentationChart" class="h-7 w-7 text-blue-700" />
        </div>
        <h3 class="text-xl font-bold text-slate-800 mb-3">Google Ads</h3>
        <p class="text-slate-600">Capture high-intent traffic with optimized search, display, and shopping campaigns on Google's advertising network.</p>
      </div>
      <div class="rounded-2xl bg-blue-500 p-8 shadow-lg transition hover:shadow-xl hover:-translate-y-1 duration-300">
        <div class="bg-blue-400 rounded-full w-14 h-14 flex items-center justify-center mb-6">
          <Icon name="brain" class="h-7 w-7 text-white" />
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Social Ads</h3>
        <p class="text-white/90">Reach your ideal audience with precision-targeted campaigns across Meta, LinkedIn, TikTok, and other social platforms.</p>
      </div>
      <div class="rounded-2xl bg-blue-50 p-8 shadow-sm transition hover:shadow-md border border-blue-100">
        <div class="bg-blue-100 rounded-full w-14 h-14 flex items-center justify-center mb-6">
          <Icon name="chartPie" class="h-7 w-7 text-blue-700" />
        </div>
        <h3 class="text-xl font-bold text-slate-800 mb-3">Analytics & Optimization</h3>
        <p class="text-slate-600">Track every conversion with advanced analytics, A/B testing, and continuous campaign optimization for peak performance.</p>
      </div>
    </div>
  </section>
  <ServiceDetails service={serviceDetails['performance-marketing']} />
</AgencyLayout>
